+[[noreturn]] void invalid(std::string_view detail) {
+  throw TypedRegionValidationError(std::string{detail});
+}
+
+PyObject* dictItem(PyObject* dict, const char* name) {
+  if (!PyDict_CheckExact(dict)) {
+    invalid("typed region node must be an exact dict");
+  }
+  PyObject* value = PyDict_GetItemString(dict, name);
+  if (value == nullptr) {
+    invalid(std::string{"typed region field missing: "} + name);
+  }
+  return value;
+}
+
+std::string pyString(PyObject* value, const char* field) {
+  if (!PyUnicode_CheckExact(value)) {
+    invalid(std::string{"typed region string field invalid: "} + field);
+  }
+  Py_ssize_t size = 0;
+  const char* data = PyUnicode_AsUTF8AndSize(value, &size);
+  if (data == nullptr) {
+    PyErr_Clear();
+    invalid(std::string{"typed region string field invalid: "} + field);
+  }
+  return std::string{data, static_cast<std::size_t>(size)};
+}
+
+std::string dictString(PyObject* dict, const char* field) {
+  return pyString(dictItem(dict, field), field);
+}
+
+int64_t dictInt(PyObject* dict, const char* field) {
+  PyObject* value = dictItem(dict, field);
+  if (!PyLong_CheckExact(value)) {
+    invalid(std::string{"typed region integer field invalid: "} + field);
+  }
+  int overflow = 0;
+  long long result = PyLong_AsLongLongAndOverflow(value, &overflow);
+  if (overflow != 0 || PyErr_Occurred()) {
+    PyErr_Clear();
+    invalid(std::string{"typed region integer field invalid: "} + field);
+  }
+  return result;
+}
+
+bool dictBool(PyObject* dict, const char* field) {
+  PyObject* value = dictItem(dict, field);
+  if (!PyBool_Check(value)) {
+    invalid(std::string{"typed region boolean field invalid: "} + field);
+  }
+  return value == Py_True;
+}
+
+std::optional<int64_t> dictOptionalInt(PyObject* dict, const char* field) {
+  PyObject* value = dictItem(dict, field);
+  if (value == Py_None) {
+    return std::nullopt;
+  }
+  if (!PyLong_CheckExact(value)) {
+    invalid(std::string{"typed region optional integer invalid: "} + field);
+  }
+  int overflow = 0;
+  long long result = PyLong_AsLongLongAndOverflow(value, &overflow);
+  if (overflow != 0 || PyErr_Occurred()) {
+    PyErr_Clear();
+    invalid(std::string{"typed region optional integer invalid: "} + field);
+  }
+  return result;
+}
