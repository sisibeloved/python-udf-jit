+        self.assertEqual(counts.get("PrimitiveSelect", 0), 0, counts)
+        self.assertGreaterEqual(counts.get("PrimitiveTableGet", 0), 3, counts)
+        self.assertGreaterEqual(counts.get("CondBranch", 0), 4, counts)
+        self.assertGreaterEqual(counts.get("SequenceBuilderAppend", 0), 3, counts)
+        self.assertEqual(counts.get("VectorCall", 0), 0, counts)
