+import unittest
+
+import cinderx
+import cinderx.jit
+
+
+_HASH = "a" * 64
+
+
+def _type(name):
+    if name == "str":
+        return {
+            "kind": "sequence",
+            "name": "str",
+            "exactness": "exact",
+            "representation": "python_object",
+            "nullable": False,
+            "parameters": [_type("unicode.scalar")],
+        }
+    if name == "unicode.builder":
+        return {
+            "kind": "builder",
+            "name": name,
+            "exactness": "unknown",
+            "representation": "internal",
+            "nullable": False,
+            "parameters": [_type("unicode.scalar")],
+        }
+    return {
+        "kind": "scalar",
+        "name": name,
+        "exactness": "exact",
+        "representation": "unboxed",
+        "nullable": False,
+        "parameters": [],
+    }
+
+
+def _operation(
+    operation_id,
+    block,
+    op,
+    operands=(),
+    result=None,
+    result_type=None,
+    attributes=(),
+    literal=None,
+):
+    return {
+        "operation_id": operation_id,
+        "block_id": block,
+        "op": op,
+        "operands": list(operands),
+        "result_id": result,
+        "result_type": None if result_type is None else _type(result_type),
+        "attributes": [list(item) for item in attributes],
+        "literal": literal,
+        "effect": "pure",
+        "may_raise": False,
+        "exception_order": None,
+        "determinism": "deterministic",
+        "source_offset": None,
+    }
+
+
+def _constant(operation_id, value):
+    return _operation(
+        operation_id,
+        "entry",
+        "constant",
+        result=f"%v{operation_id[2:]}",
+        result_type="int64",
+        literal={"kind": "int64", "encoded_value": str(value)},
+    )
+
+
+def _module(
+    *,
+    body,
+    header_arguments,
+    backedge,
+    exit_arguments,
+    output,
+    entry_body=(),
+    exit_body=(),
+    return_value=None,
+):
+    prefix = [
+        _operation(
+            "op0",
+            "entry",
+            "argument",
+            result="%text",
+            result_type="str",
+            attributes=(("index", "0"),),
+        ),
+        _constant("op1", 0),
+        _constant("op2", 1),
+        _operation(
+            "op3",
+            "entry",
+            "sequence.length",
+            ("%text",),
+            "%length",
+            "int64",
+        ),
+        *entry_body,
+    ]
+    initial_builders = {}
+    for value, type_name in header_arguments:
+        if type_name != "unicode.builder":
+            continue
+        suffix = value.removeprefix("%")
+        initial_value = f"%initial_{suffix}"
+        prefix.append(
+            _operation(
+                f"create_{suffix}",
+                "entry",
+                "sequence.builder.create",
+                ("%length",),
+                result=initial_value,
+                result_type="unicode.builder",
+            )
+        )
+        initial_builders[value] = initial_value
+    prefix.append(
+        _operation(
+            "entry_jump",
+            "entry",
+            "jump",
+            attributes=(("target_block", "header"),),
+        )
+    )
+    header = [
+        _operation(
+            "header_compare",
+            "header",
+            "compare.lt",
+            ("%index", "%length"),
+            "%continue",
+            "bool",
+        ),
+        _operation(
+            "header_branch",
+            "header",
+            "branch",
+            ("%continue",),
+            attributes=(
+                ("false_block", "exit"),
+                ("true_block", "body"),
+            ),
+        ),
+    ]
+    finish = list(exit_body)
+    exit_block_arguments = [
+        (f"%exit_{source.removeprefix('%')}", type_name)
+        for source, type_name in exit_arguments
+    ]
+    returned = return_value or exit_block_arguments[0][0]
+    if output == "str":
+        finish.append(
+            _operation(
+                "finish",
+                "exit",
+                "sequence.builder.finish",
+                (returned,),
+                "%result",
+                "str",
+            )
+        )
+        returned = "%result"
+    finish.append(_operation("return", "exit", "return", (returned,)))
+    operations = prefix + header + list(body) + finish
+    raising_operations = {
+        "sequence.builder.append",
+        "sequence.builder.apply",
+        "sequence.builder.create",
+        "sequence.builder.finish",
+        "sequence.get",
+        "binary.truediv",
+    }
+    exception_order = 0
+    for source_offset, operation in enumerate(operations):
+        operation["source_offset"] = source_offset
+        if operation["op"] in raising_operations:
+            operation["may_raise"] = True
+            operation["exception_order"] = exception_order
+            exception_order += 1
+    by_block = {name: [] for name in ("entry", "header", "body", "exit")}
+    for operation in operations:
+        by_block[operation["block_id"]].append(operation["operation_id"])
+    entry_arguments = []
+    for value, type_name in header_arguments:
+        entry_arguments.append(
+            initial_builders[value] if type_name == "unicode.builder" else "%v1"
+        )
+    return {
+        "format_version": 2,
+        "semantic_hash": _HASH,
+        "function_id": _HASH,
+        "entry_block": "entry",
+        "input_types": [_type("str")],
+        "output_type": _type(output),
+        "blocks": [
+            {"block_id": "entry", "arguments": [], "operation_ids": by_block["entry"]},
+            {
+                "block_id": "header",
+                "arguments": [
+                    {"value_id": value, "type": _type(type_name)}
+                    for value, type_name in header_arguments
+                ],
+                "operation_ids": by_block["header"],
+            },
+            {"block_id": "body", "arguments": [], "operation_ids": by_block["body"]},
+            {
+                "block_id": "exit",
+                "arguments": [
+                    {"value_id": value, "type": _type(type_name)}
+                    for value, type_name in exit_block_arguments
+                ],
+                "operation_ids": by_block["exit"],
+            },
+        ],
+        "control_edges": [
+            {
+                "source_block": "entry",
+                "target_block": "header",
+                "kind": "jump",
+                "arguments": entry_arguments,
+            },
+            {
+                "source_block": "header",
+                "target_block": "body",
+                "kind": "branch_true",
+                "arguments": [],
+            },
+            {
+                "source_block": "header",
+                "target_block": "exit",
+                "kind": "branch_false",
+                "arguments": [source for source, _ in exit_arguments],
+            },
+            {
+                "source_block": "body",
+                "target_block": "header",
+                "kind": "jump",
+                "arguments": list(backedge),
+            },
+        ],
+        "operations": operations,
+        "return_operation_id": "return",
+        "runtime_dependency_hashes": [],
+    }
+
+
+def _plan():
+    return {
+        "format_version": 2,
+        "module_hash": _HASH,
+        "plan_hash": "b" * 64,
+        "iterator_strategy": "unicode_storage",
+        "required_guards": ["exact:str"],
+        "backend_requirements": ["cfg_phi", "typed_sequence_iteration"],
+    }
+
+
+def _function(source):
+    namespace = {}
+    exec(source, namespace)
+    function = namespace["region"]
+    function.__udf_jit_typed_region__ = _HASH
+    return function
+
+
+def _reduction(property_name):
+    body = [
+        _operation(
+            "read", "body", "sequence.get", ("%text", "%index"), "%codepoint", "unicode.scalar"
+        ),
+        _operation(
+            "classify",
+            "body",
+            "unicode.property",
+            ("%codepoint",),
+            "%accepted",
+            "bool",
+            (("property", property_name),),
+        ),
+        _operation("cast", "body", "cast", ("%accepted",), "%increment", "int64", (("target", "int64"),)),
+        _operation("accumulate", "body", "binary.add", ("%accumulator", "%increment"), "%next_accumulator", "int64"),
+        _operation("advance", "body", "binary.add", ("%index", "%v2"), "%next_index", "int64"),
+        _operation(
+            "body_jump",
+            "body",
+            "jump",
+            attributes=(("target_block", "header"),),
+        ),
+    ]
+    return _module(
+        body=body,
+        header_arguments=(("%index", "int64"), ("%accumulator", "int64")),
+        backedge=("%next_index", "%next_accumulator"),
+        exit_arguments=(("%accumulator", "int64"),),
+        output="int64",
+    )
+
+
+def _mapping():
+    body = [
+        _operation("read", "body", "sequence.get", ("%text", "%index"), "%codepoint", "unicode.scalar"),
+        _operation(
+            "lookup",
+            "body",
+            "immutable.lookup",
+            ("%codepoint", "%codepoint"),
+            "%mapped",
+            "unicode.scalar",
+            (("keys", "[945,946,8594]"), ("values", "[97,98,62]")),
+        ),
+        _operation("append", "body", "sequence.builder.append", ("%builder", "%mapped"), "%next_builder", "unicode.builder"),
+        _operation("advance", "body", "binary.add", ("%index", "%v2"), "%next_index", "int64"),
+        _operation(
+            "body_jump",
+            "body",
+            "jump",
+            attributes=(("target_block", "header"),),
+        ),
+    ]
+    return _module(
+        body=body,
+        header_arguments=(("%index", "int64"), ("%builder", "unicode.builder")),
+        backedge=("%next_index", "%next_builder"),
+        exit_arguments=(("%builder", "unicode.builder"),),
+        output="str",
+    )
+
+
+def _duplicate():
+    body = [
+        _operation(
+            "read",
+            "body",
+            "sequence.get",
+            ("%text", "%index"),
+            "%codepoint",
+            "unicode.scalar",
+        ),
+        _operation(
+            "append_first",
+            "body",
+            "sequence.builder.append",
+            ("%builder", "%codepoint"),
+            "%builder_once",
+            "unicode.builder",
+        ),
+        _operation(
+            "append_second",
+            "body",
+            "sequence.builder.append",
+            ("%builder_once", "%codepoint"),
+            "%builder_twice",
+            "unicode.builder",
+        ),
+        _operation(
+            "advance",
+            "body",
+            "binary.add",
+            ("%index", "%v2"),
+            "%next_index",
+            "int64",
+        ),
+        _operation(
+            "body_jump",
+            "body",
+            "jump",
+            attributes=(("target_block", "header"),),
+        ),
+    ]
+    return _module(
+        body=body,
+        header_arguments=(("%index", "int64"), ("%builder", "unicode.builder")),
+        backedge=("%next_index", "%builder_twice"),
+        exit_arguments=(("%builder", "unicode.builder"),),
+        output="str",
+    )
+
+
+def _parallel_builders():
+    body = [
+        _operation(
+            "read",
+            "body",
+            "sequence.get",
+            ("%text", "%index"),
+            "%codepoint",
+            "unicode.scalar",
+        ),
+        _operation(
+            "append_left",
+            "body",
+            "sequence.builder.append",
+            ("%left", "%codepoint"),
+            "%next_left",
+            "unicode.builder",
+        ),
+        _operation(
+            "append_right",
+            "body",
+            "sequence.builder.append",
+            ("%right", "%codepoint"),
+            "%next_right",
+            "unicode.builder",
+        ),
+        _operation(
+            "advance",
+            "body",
+            "binary.add",
+            ("%index", "%v2"),
+            "%next_index",
+            "int64",
+        ),
+        _operation(
+            "body_jump",
+            "body",
+            "jump",
+            attributes=(("target_block", "header"),),
+        ),
+    ]
+    return _module(
+        body=body,
+        header_arguments=(
+            ("%index", "int64"),
+            ("%left", "unicode.builder"),
+            ("%right", "unicode.builder"),
+        ),
+        backedge=("%next_index", "%next_left", "%next_right"),
+        exit_arguments=(("%left", "unicode.builder"),),
+        output="str",
+    )
+
+
+def _whitespace():
+    body = [
+        _operation("read", "body", "sequence.get", ("%text", "%index"), "%codepoint", "unicode.scalar"),
+        _operation("classify", "body", "unicode.property", ("%codepoint",), "%space", "bool", (("property", "space"),)),
+        _operation(
+            "transition",
+            "body",
+            "fsm.transition",
+            ("%state", "%space"),
+            "%next_state",
+            "int64",
+            (("class_count", "2"), ("state_count", "3"), ("transitions", "[1,0,1,2,1,2]")),
+        ),
+        _operation(
+            "apply",
+            "body",
+            "sequence.builder.apply",
+            ("%builder", "%codepoint", "%state", "%space"),
+            "%next_builder",
+            "unicode.builder",
+            (("actions", "[1,0,1,0,3,0]"), ("class_count", "2"), ("emissions", "[0,0,0,0,32,0]"), ("state_count", "3")),
+        ),
+        _operation("advance", "body", "binary.add", ("%index", "%v2"), "%next_index", "int64"),
+        _operation(
+            "body_jump",
+            "body",
+            "jump",
+            attributes=(("target_block", "header"),),
+        ),
+    ]
+    return _module(
+        body=body,
+        header_arguments=(("%index", "int64"), ("%builder", "unicode.builder"), ("%state", "int64")),
+        backedge=("%next_index", "%next_builder", "%next_state"),
+        exit_arguments=(("%builder", "unicode.builder"),),
+        output="str",
