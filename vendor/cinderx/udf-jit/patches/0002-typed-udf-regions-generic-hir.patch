+# Copyright (c) Meta Platforms, Inc. and affiliates.
+
+import os
+import unittest
+
+import cinderx.jit as jit
+
+
+class UdfJitDiagnosticsTest(unittest.TestCase):
+    @unittest.skipUnless(
+        os.getenv("PYTHONJITUDFDIAGNOSTICS"),
+        "requires a dedicated diagnostics worker",
+    )
+    def test_structured_origin_and_machine_ranges(self):
+        def target(value):
+            return value + 1
+
+        target.__udfjit_generated_code_hash__ = "a" * 64
+        self.assertTrue(jit.force_compile(target))
+
+        result = jit.get_udfjit_compilation_diagnostics(
+            target,
+            "cinderx-test-1",
+        )
+
+        self.assertEqual(result["schema_version"], 1)
+        self.assertEqual(result["status"], "available")
+        self.assertEqual(result["compile_instance_id"], "cinderx-test-1")
+        self.assertEqual(result["generated_code_hash"], "a" * 64)
+        self.assertTrue(result["hir_nodes"])
+        self.assertTrue(result["lir_nodes"])
+        self.assertTrue(result["machine_ranges"])
+        code_start = result["code_start"]
+        code_end = code_start + result["code_size"]
+        previous_end = code_start
+        for machine_range in result["machine_ranges"]:
+            self.assertGreaterEqual(machine_range["start"], previous_end)
+            self.assertLessEqual(machine_range["end"], code_end)
+            self.assertLess(machine_range["start"], machine_range["end"])
+            self.assertTrue(
+                machine_range["lir_ids"]
+                or machine_range["hir_ids"]
+                or machine_range["synthetic_kind"]
+            )
+            previous_end = machine_range["end"]
+
+
+if __name__ == "__main__":
+    unittest.main()
