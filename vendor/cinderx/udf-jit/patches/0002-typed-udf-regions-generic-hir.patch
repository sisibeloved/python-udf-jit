+void Context::recordDeterministicCompileFailure(const CompilationKey& key) {
+  ThreadedCompileSerialize guard;
+  BorrowedRef<PyCodeObject> code{key.code};
+  auto& failures = deterministic_compile_failures_[code];
+  for (const auto& failure : failures) {
+    if (reinterpret_cast<PyObject*>(failure.builtins.get()) == key.builtins &&
+        reinterpret_cast<PyObject*>(failure.globals.get()) == key.globals &&
+        failure.specialization == key.specialization) {
+      return;
+    }
+  }
+  if (failures.size() >= kMaxDeterministicFailuresPerCode) {
+    return;
+  }
+  failures.emplace_back(
+      reinterpret_cast<PyDictObject*>(key.builtins),
+      reinterpret_cast<PyDictObject*>(key.globals),
+      key.specialization);
+}
