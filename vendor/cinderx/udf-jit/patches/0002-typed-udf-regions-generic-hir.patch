+
+
+def _ratio():
+    body = [
+        _operation(
+            "read",
+            "body",
+            "sequence.get",
+            ("%text", "%index"),
+            "%codepoint",
+            "unicode.scalar",
+        ),
+        _operation(
+            "classify",
+            "body",
+            "unicode.property",
+            ("%codepoint",),
+            "%accepted",
+            "bool",
+            (("property", "alnum"),),
+        ),
+        _operation(
+            "cast",
+            "body",
+            "cast",
+            ("%accepted",),
+            "%increment",
+            "int64",
+            (("target", "int64"),),
+        ),
+        _operation(
+            "accumulate",
+            "body",
+            "binary.add",
+            ("%accumulator", "%increment"),
+            "%next_accumulator",
+            "int64",
+        ),
+        _operation(
+            "advance",
+            "body",
+            "binary.add",
+            ("%index", "%v2"),
+            "%next_index",
+            "int64",
+        ),
+        _operation(
+            "body_jump",
+            "body",
+            "jump",
+            attributes=(("target_block", "header"),),
+        ),
+    ]
+    threshold = _operation(
+        "threshold",
+        "entry",
+        "constant",
+        result="%threshold",
+        result_type="float64",
+        literal={"kind": "float64", "encoded_value": "0x1.0000000000000p-1"},
+    )
+    divide = _operation(
+        "divide",
+        "exit",
+        "binary.truediv",
+        ("%exit_accumulator", "%length"),
+        "%ratio",
+        "float64",
+    )
+    compare = _operation(
+        "ratio_compare",
+        "exit",
+        "compare.ge",
+        ("%ratio", "%threshold"),
+        "%accepted_ratio",
+        "bool",
+    )
+    return _module(
+        body=body,
+        header_arguments=(("%index", "int64"), ("%accumulator", "int64")),
+        backedge=("%next_index", "%next_accumulator"),
+        exit_arguments=(("%accumulator", "int64"),),
+        output="bool",
+        entry_body=(threshold,),
+        exit_body=(divide, compare),
+        return_value="%accepted_ratio",
+    )
+
+
+class GenericTypedHIRTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cinderx.init()
+
+    def test_unicode_reduction_is_a_visible_native_loop(self):
+        function = _function(
+            """
+def region(text):
+    if type(text) is not str:
+        raise TypeError
+    return sum(1 for value in text if value.isalpha())
+"""
+        )
+        self.assertTrue(cinderx.jit.compile_typed_region(function, _reduction("alpha"), _plan()))
+        self.assertEqual(function("A1β-"), 2)
+        counts = cinderx.jit.get_function_hir_opcode_counts(function)
+        for opcode, minimum in {
+            "Phi": 2,
+            "CondBranch": 1,
+            "IntBinaryOp": 2,
+            "LoadField": 1,
+            "UnicodeData": 1,
+            "UnicodeKind": 1,
+            "UnicodeRead": 1,
+            "UnicodeClassify": 1,
+        }.items():
+            self.assertGreaterEqual(counts.get(opcode, 0), minimum, counts)
+        self.assertEqual(counts.get("VectorCall", 0), 0, counts)
+        self.assertEqual(counts.get("InvokeIterNext", 0), 0, counts)
+
+    def test_new_unicode_property_reuses_the_same_generic_hir(self):
+        function = _function("def region(text):\n    return sum(map(str.isspace, text))")
+        self.assertTrue(cinderx.jit.compile_typed_region(function, _reduction("space"), _plan()))
+        self.assertEqual(function("a \t\u2003"), 3)
+        counts = cinderx.jit.get_function_hir_opcode_counts(function)
+        self.assertGreaterEqual(counts.get("UnicodeClassify", 0), 1, counts)
+
+    def test_numeric_post_loop_uses_generic_long_divide_and_float_compare(self):
+        function = _function(
+            "def region(text):\n"
+            "    return sum(1 for value in text if value.isalnum()) / len(text) >= 0.5"
+        )
+        self.assertTrue(
+            cinderx.jit.compile_typed_region(function, _ratio(), _plan())
+        )
+        self.assertTrue(function("abc-1"))
+        self.assertFalse(function("a---"))
+        with self.assertRaises(ZeroDivisionError):
+            function("")
+        counts = cinderx.jit.get_function_hir_opcode_counts(function)
+        self.assertGreaterEqual(counts.get("LongBinaryOp", 0), 1, counts)
+        self.assertGreaterEqual(counts.get("PrimitiveCompare", 0), 1, counts)
+        self.assertEqual(counts.get("VectorCall", 0), 0, counts)
+
+    def test_rejects_noncanonical_float_literal(self):
+        function = _function("def region(text):\n    return len(text) > 0")
+        semantic = _ratio()
+        threshold = next(
+            operation
+            for operation in semantic["operations"]
+            if operation["operation_id"] == "threshold"
+        )
+        threshold["literal"]["encoded_value"] = "0.5"
+        with self.assertRaisesRegex(ValueError, "invalid typed float"):
