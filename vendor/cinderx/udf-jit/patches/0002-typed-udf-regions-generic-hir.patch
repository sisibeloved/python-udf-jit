@@ -0,0 +1,63 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+
+import unittest
+
+import cinderx.jit as jit
+
+
+def _increment(value):
+    return value + 1
+
+
+def _double(value):
+    return value * 2
+
+
+def _make_wrapper(target):
+    def set_target(replacement):
+        nonlocal target
+        target = replacement
+
+    def wrapper(value):
+        return target(value)
+
+    return wrapper, set_target
+
+
+@unittest.skipUnless(
+    jit.is_enabled() and jit.is_hir_inliner_enabled(),
+    "requires CinderX JIT HIR inliner",
+)
+class FrozenClosureInliningTests(unittest.TestCase):
+    def test_exact_closure_function_is_guarded_and_inlined(self):
+        wrapper, set_target = _make_wrapper(_increment)
+
+        self.assertTrue(jit.force_compile(wrapper))
+        counts = jit.get_function_hir_opcode_counts(wrapper) or {}
+        self.assertEqual(counts.get("VectorCall", 0), 0, counts)
+        self.assertGreaterEqual(jit.get_num_inlined_functions(wrapper), 1)
+        self.assertEqual(wrapper(7), 8)
+
+        # The closure cell remains mutable.  The identity guard must deopt
+        # before entering the old target instead of changing Python semantics.
+        set_target(_double)
+        self.assertEqual(wrapper(7), 14)
+
+    def test_shared_code_is_specialized_per_closure_target(self):
+        increment_wrapper, _ = _make_wrapper(_increment)
+        double_wrapper, _ = _make_wrapper(_double)
+
+        self.assertIs(increment_wrapper.__code__, double_wrapper.__code__)
+        self.assertTrue(jit.force_compile(increment_wrapper))
+        self.assertTrue(jit.force_compile(double_wrapper))
+
+        self.assertEqual(increment_wrapper(7), 8)
+        self.assertEqual(double_wrapper(7), 14)
+        for wrapper in (increment_wrapper, double_wrapper):
+            counts = jit.get_function_hir_opcode_counts(wrapper) or {}
+            self.assertEqual(counts.get("VectorCall", 0), 0, counts)
+            self.assertGreaterEqual(jit.get_num_inlined_functions(wrapper), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
