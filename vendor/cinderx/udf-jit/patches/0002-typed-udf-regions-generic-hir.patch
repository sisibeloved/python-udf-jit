+  ThreadedCompileSerialize serialize;
+  jitCtx()->removeActiveCompile(key);
+  if (!compiled.has_value()) {
+    Py_RETURN_FALSE;
+  }
+  if (compiled->compilation_specialization != key.specialization) {
+    Py_RETURN_FALSE;
+  }
