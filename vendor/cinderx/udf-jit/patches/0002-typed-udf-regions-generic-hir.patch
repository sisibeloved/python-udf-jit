+# Copyright (c) Meta Platforms, Inc. and affiliates.
+
+import types
+import unittest
+
+import cinderx.jit as jit
+
+
+def _filtered_count(text):
+    return sum(1 for char in text if char.isalnum())
+
+
+def _generator_code():
+    return next(
+        const
+        for const in _filtered_count.__code__.co_consts
+        if isinstance(const, types.CodeType)
+    )
+
+
+@unittest.skipUnless(jit.is_enabled(), "requires CinderX JIT")
+class GeneratorCompileStabilityTests(unittest.TestCase):
+    def test_filtered_generator_lowers_and_executes(self):
+        generator_function = types.FunctionType(
+            _generator_code(), globals(), "filtered_generator"
+        )
+
+        self.assertTrue(jit.force_compile(generator_function))
+        self.assertTrue(jit.is_jit_compiled(generator_function))
+        self.assertEqual(list(generator_function(iter("A-1 !"))), [1, 1])
+
+
+if __name__ == "__main__":
+    unittest.main()
