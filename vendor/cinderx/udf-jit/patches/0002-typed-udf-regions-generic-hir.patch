 namespace jit::hir {
 
+Ref<PyFunctionObject> closureFunctionTarget(
+    BorrowedRef<PyFunctionObject> func,
+    Py_ssize_t closure_index) {
+  PyObject* closure = func->func_closure;
+  if (closure == nullptr || !PyTuple_CheckExact(closure) || closure_index < 0 ||
+      closure_index >= PyTuple_GET_SIZE(closure)) {
+    return nullptr;
+  }
+  PyObject* cell = PyTuple_GET_ITEM(closure, closure_index);
+  if (!PyCell_Check(cell)) {
+    return nullptr;
+  }
+  Ref<> value = Ref<>::steal(PyCell_Get(cell));
+  if (value == nullptr) {
+    PyErr_Clear();
+    return nullptr;
+  }
+  if (!PyFunction_Check(value)) {
+    return nullptr;
+  }
+  return Ref<PyFunctionObject>(std::move(value));
+}
+
+uint32_t closureFunctionTargetSignature(
+    BorrowedRef<PyFunctionObject> func) {
+  PyObject* closure = func->func_closure;
+  if (closure == nullptr || !PyTuple_CheckExact(closure)) {
+    return 0;
+  }
+  uint32_t signature = 0x811c9dc5U;
+  bool specialized = false;
+  for (Py_ssize_t index = 0; index < PyTuple_GET_SIZE(closure); ++index) {
+    Ref<PyFunctionObject> target = closureFunctionTarget(func, index);
+    if (target == nullptr) {
+      continue;
+    }
+    specialized = true;
+    signature ^= static_cast<uint32_t>(index + 1);
+    signature *= 0x01000193U;
+    uintptr_t identity = reinterpret_cast<uintptr_t>(target.get());
+    signature ^= static_cast<uint32_t>(identity);
+    signature *= 0x01000193U;
+    signature ^= static_cast<uint32_t>(identity >> 32);
+    signature *= 0x01000193U;
+  }
+  return specialized ? signature : 0;
+}
