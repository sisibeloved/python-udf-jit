+pyList(PyObject* value, const char* field, std::size_t max) {
+  if (!PyList_CheckExact(value)) {
+    invalid(std::string{"typed region list field invalid: "} + field);
+  }
+  Py_ssize_t size = PyList_GET_SIZE(value);
+  if (size < 0 || static_cast<std::size_t>(size) > max) {
+    invalid(std::string{"typed region list field too large: "} + field);
+  }
+  std::vector<PyObject*> result;
+  result.reserve(size);
+  for (Py_ssize_t index = 0; index < size; ++index) {
+    result.push_back(PyList_GET_ITEM(value, index));
+  }
+  return result;
+}
+
+std::vector<std::string>
+stringList(PyObject* value, const char* field, std::size_t max = kMaxValues) {
+  std::vector<std::string> result;
+  for (PyObject* item : pyList(value, field, max)) {
+    result.push_back(pyString(item, field));
+  }
+  return result;
+}
+
+struct RegionType {
+  std::string kind;
+  std::string name;
+  std::string exactness;
+  std::string representation;
+};
+
+RegionType parseType(PyObject* value) {
+  RegionType result{
+      dictString(value, "kind"),
+      dictString(value, "name"),
+      dictString(value, "exactness"),
+      dictString(value, "representation")};
+  PyObject* nullable = dictItem(value, "nullable");
+  if (!PyBool_Check(nullable) || nullable == Py_True) {
+    invalid("nullable typed values are not supported by direct typed HIR");
+  }
+  // Recursively validating parameters is unnecessary for lowering, but the
+  // field must remain a bounded exact list so malformed provider input cannot
+  // smuggle an unbounded object graph through the compiler boundary.
+  pyList(dictItem(value, "parameters"), "parameters", 4);
+  return result;
+}
+
+struct Literal {
+  std::string kind;
+  std::string encoded;
+};
+
+struct Operation {
+  std::string id;
+  std::string block;
+  std::string op;
+  std::vector<std::string> operands;
+  std::optional<std::string> result;
+  std::optional<RegionType> result_type;
+  std::unordered_map<std::string, std::string> attributes;
+  std::optional<Literal> literal;
+  std::string effect;
+  bool may_raise{false};
+  std::optional<int64_t> exception_order;
+  std::string determinism;
+  std::optional<int64_t> source_offset;
+  std::optional<int> bytecode_offset;
+};
+
+struct BlockArgument {
+  std::string id;
+  RegionType type;
+};
+
+struct Block {
+  std::string id;
+  std::vector<BlockArgument> arguments;
+  std::vector<std::string> operations;
+};
+
+struct EdgeInfo {
+  std::string source;
+  std::string target;
+  std::string kind;
+  std::vector<std::string> arguments;
+};
+
+struct RegionModule {
+  std::string function_id;
+  std::string semantic_hash;
+  std::string return_operation_id;
+  std::string entry;
+  std::vector<RegionType> inputs;
+  RegionType output;
+  std::vector<Block> blocks;
+  std::vector<EdgeInfo> edges;
+  std::vector<Operation> operations;
+};
+
+std::unordered_map<std::string, std::string> parseAttributes(PyObject* value) {
+  std::unordered_map<std::string, std::string> result;
+  std::string previous;
+  for (PyObject* pair : pyList(value, "attributes", 16)) {
+    auto items = pyList(pair, "attribute", 2);
+    if (items.size() != 2) {
+      invalid("typed operation attribute must contain two strings");
+    }
+    std::string key = pyString(items[0], "attribute key");
+    std::string item = pyString(items[1], "attribute value");
+    if ((!previous.empty() && key <= previous) || key.empty() ||
+        key.size() > 128 || item.size() > 4096 ||
+        !result.emplace(key, std::move(item)).second) {
+      invalid("typed operation attributes are not canonical");
+    }
+    previous = std::move(key);
+  }
+  return result;
+}
+
+void validateModule(const RegionModule& module);
+
+void attachOperationLines(
+    RegionModule& module,
+    PyObject* operation_lines,
+    BorrowedRef<PyCodeObject> code) {
+  if (operation_lines == Py_None) {
+    return;
+  }
+  if (!PyTuple_CheckExact(operation_lines) ||
+      PyTuple_GET_SIZE(operation_lines) !=
+          static_cast<Py_ssize_t>(module.operations.size())) {
+    invalid("typed diagnostic operation lines are invalid");
+  }
+  std::unordered_map<std::string, int64_t> lines;
+  for (Py_ssize_t index = 0; index < PyTuple_GET_SIZE(operation_lines);
+       ++index) {
+    PyObject* pair = PyTuple_GET_ITEM(operation_lines, index);
+    if (!PyTuple_CheckExact(pair) || PyTuple_GET_SIZE(pair) != 2) {
+      invalid("typed diagnostic operation line is invalid");
+    }
+    std::string operation_id =
+        pyString(PyTuple_GET_ITEM(pair, 0), "operation line id");
+    PyObject* raw_line = PyTuple_GET_ITEM(pair, 1);
+    if (!PyLong_CheckExact(raw_line)) {
+      invalid("typed diagnostic operation line is invalid");
+    }
+    int overflow = 0;
+    long long line = PyLong_AsLongLongAndOverflow(raw_line, &overflow);
+    if (overflow != 0 || PyErr_Occurred() || line < 0 ||
+        line > std::numeric_limits<int>::max() ||
+        !lines.emplace(std::move(operation_id), line).second) {
+      PyErr_Clear();
+      invalid("typed diagnostic operation line is invalid");
+    }
+  }
+  for (Operation& operation : module.operations) {
+    auto line = lines.find(operation.id);
+    if (line == lines.end()) {
+      invalid("typed diagnostic operation id is missing");
+    }
+    for (std::size_t index = 0; index < countIndices(code); ++index) {
+      int bytecode_offset = static_cast<int>(index * sizeof(_Py_CODEUNIT));
+      if (PyCode_Addr2Line(code, bytecode_offset) == line->second) {
+        operation.bytecode_offset = bytecode_offset;
+        break;
+      }
+    }
+    if (!operation.bytecode_offset.has_value()) {
+      invalid("typed diagnostic operation line has no bytecode offset");
+    }
+  }
+}
+
+RegionModule parseModule(
+    PyObject* semantic,
+    PyObject* plan,
+    PyObject* operation_lines,
+    BorrowedRef<PyCodeObject> code) {
+  if (dictInt(semantic, "format_version") != 2 ||
+      dictInt(plan, "format_version") != 2) {
+    invalid("unsupported typed region format version");
+  }
+  RegionModule module;
+  module.function_id = dictString(semantic, "function_id");
+  module.semantic_hash = dictString(semantic, "semantic_hash");
+  if (!isLowerHexDigest(module.function_id) ||
+      !isLowerHexDigest(module.semantic_hash) ||
+      dictString(plan, "module_hash") != module.semantic_hash) {
+    invalid("typed region semantic identity mismatch");
+  }
+  module.return_operation_id = dictString(semantic, "return_operation_id");
+  for (const std::string& dependency : stringList(
+           dictItem(semantic, "runtime_dependency_hashes"),
+           "runtime_dependency_hashes",
+           256)) {
+    if (!isLowerHexDigest(dependency)) {
+      invalid("typed region runtime dependency hash is invalid");
+    }
+  }
+  module.entry = dictString(semantic, "entry_block");
+  for (PyObject* input :
+       pyList(dictItem(semantic, "input_types"), "input_types", 256)) {
+    module.inputs.push_back(parseType(input));
+  }
+  module.output = parseType(dictItem(semantic, "output_type"));
+
+  std::unordered_set<std::string> block_ids;
+  for (PyObject* value :
+       pyList(dictItem(semantic, "blocks"), "blocks", kMaxBlocks)) {
+    Block block;
+    block.id = dictString(value, "block_id");
+    if (!block_ids.insert(block.id).second) {
+      invalid("duplicate typed block id");
+    }
+    for (PyObject* argument :
+         pyList(dictItem(value, "arguments"), "block arguments", kMaxValues)) {
+      block.arguments.push_back(BlockArgument{
+          dictString(argument, "value_id"),
+          parseType(dictItem(argument, "type"))});
+    }
+    block.operations = stringList(
+        dictItem(value, "operation_ids"), "operation_ids", kMaxOperations);
+    module.blocks.push_back(std::move(block));
+  }
+  if (!block_ids.contains(module.entry)) {
+    invalid("typed region entry block is missing");
+  }
+
+  for (PyObject* value : pyList(
+           dictItem(semantic, "control_edges"), "control_edges", kMaxEdges)) {
+    EdgeInfo edge{
+        dictString(value, "source_block"),
+        dictString(value, "target_block"),
+        dictString(value, "kind"),
+        stringList(dictItem(value, "arguments"), "edge arguments")};
+    if (!block_ids.contains(edge.source) || !block_ids.contains(edge.target)) {
+      invalid("typed control edge references an unknown block");
+    }
+    module.edges.push_back(std::move(edge));
+  }
+
+  std::unordered_set<std::string> operation_ids;
+  for (PyObject* value :
+       pyList(dictItem(semantic, "operations"), "operations", kMaxOperations)) {
+    Operation operation;
+    operation.id = dictString(value, "operation_id");
+    operation.block = dictString(value, "block_id");
+    operation.op = dictString(value, "op");
+    operation.operands = stringList(dictItem(value, "operands"), "operands");
+    PyObject* result = dictItem(value, "result_id");
+    PyObject* result_type = dictItem(value, "result_type");
+    if (result != Py_None) {
+      operation.result = pyString(result, "result_id");
+      if (result_type == Py_None) {
+        invalid("typed operation result type missing");
+      }
+      operation.result_type = parseType(result_type);
+    } else if (result_type != Py_None) {
+      invalid("typed terminator unexpectedly has a result type");
+    }
+    operation.attributes = parseAttributes(dictItem(value, "attributes"));
+    PyObject* literal = dictItem(value, "literal");
+    if (literal != Py_None) {
+      operation.literal = Literal{
+          dictString(literal, "kind"), dictString(literal, "encoded_value")};
+    }
+    operation.effect = dictString(value, "effect");
+    operation.may_raise = dictBool(value, "may_raise");
+    operation.exception_order = dictOptionalInt(value, "exception_order");
+    operation.determinism = dictString(value, "determinism");
+    operation.source_offset = dictOptionalInt(value, "source_offset");
+    if (!block_ids.contains(operation.block) ||
+        !operation_ids.insert(operation.id).second) {
+      invalid("typed operation has an invalid block or duplicate id");
+    }
+    module.operations.push_back(std::move(operation));
+  }
+
+  std::unordered_map<std::string, const Operation*> operations;
+  for (const Operation& operation : module.operations) {
+    operations.emplace(operation.id, &operation);
+  }
+  for (const Block& block : module.blocks) {
+    for (const std::string& id : block.operations) {
+      auto it = operations.find(id);
+      if (it == operations.end() || it->second->block != block.id) {
+        invalid("typed block operation list is inconsistent");
+      }
+    }
+  }
+  validateModule(module);
+  attachOperationLines(module, operation_lines, code);
+  return module;
+}
+
+int64_t parseInt64(std::string_view text, const char* field) {
+  int64_t value = 0;
+  auto [end, error] =
+      std::from_chars(text.data(), text.data() + text.size(), value);
+  if (error != std::errc{} || end != text.data() + text.size()) {
+    invalid(std::string{"invalid typed integer: "} + field);
+  }
+  return value;
+}
+
+double parseFloat64(std::string_view text, const char* field) {
+  if (text == "inf") {
+    return std::numeric_limits<double>::infinity();
+  }
+  if (text == "-inf") {
+    return -std::numeric_limits<double>::infinity();
+  }
+  if (text == "nan") {
+    return std::numeric_limits<double>::quiet_NaN();
+  }
+
+  bool negative = text.starts_with('-');
+  if (negative) {
+    text.remove_prefix(1);
+  }
+  if (text.size() < 3 || !text.starts_with("0x")) {
+    invalid(std::string{"invalid typed float: "} + field);
+  }
+  text.remove_prefix(2);
+  double value = 0.0;
+  auto [end, error] = std::from_chars(
+      text.data(), text.data() + text.size(), value, std::chars_format::hex);
+  if (error != std::errc{} || end != text.data() + text.size()) {
+    invalid(std::string{"invalid typed float: "} + field);
+  }
+  return negative ? -value : value;
+}
+
+std::vector<int64_t>
+parseIntTable(std::string_view text, int64_t minimum, int64_t maximum) {
+  if (text.size() < 2 || text.front() != '[' || text.back() != ']') {
+    invalid("invalid canonical integer table");
+  }
+  std::vector<int64_t> result;
+  std::size_t cursor = 1;
+  const std::size_t end = text.size() - 1;
+  if (cursor == end) {
+    return result;
+  }
+  while (cursor < end) {
+    std::size_t comma = text.find(',', cursor);
+    std::size_t item_end = comma == std::string_view::npos ? end : comma;
+    if (item_end > end || item_end == cursor ||
+        result.size() >= kMaxTableItems) {
+      invalid("invalid canonical integer table");
+    }
+    int64_t value = parseInt64(text.substr(cursor, item_end - cursor), "table");
+    if (value < minimum || value > maximum) {
+      invalid("typed integer table item out of range");
+    }
+    result.push_back(value);
+    if (item_end == end) {
+      cursor = end;
+    } else {
+      cursor = item_end + 1;
+      if (cursor == end) {
+        invalid("invalid canonical integer table");
+      }
+    }
+  }
+  return result;
+}
+
+const std::string& attribute(const Operation& operation, const char* name) {
+  auto it = operation.attributes.find(name);
+  if (it == operation.attributes.end()) {
+    invalid(std::string{"typed operation attribute missing: "} + name);
+  }
+  return it->second;
+}
+
+Type hirType(const RegionType& type) {
+  if (type.kind == "scalar" && type.name == "bool" &&
+      type.representation == "unboxed") {
+    return TCBool;
+  }
+  if (type.kind == "scalar" &&
+      (type.name == "int64" || type.name == "unicode.scalar") &&
+      type.representation == "unboxed") {
+    return TCInt64;
+  }
+  if (type.kind == "scalar" && type.name == "float64" &&
+      type.representation == "unboxed") {
+    return TCDouble;
+  }
+  if (type.kind == "sequence" && type.name == "str" &&
+      type.exactness == "exact") {
+    return TUnicodeExact;
+  }
+  if (type.kind == "builder" && type.name == "unicode.builder") {
+    return TObject;
+  }
+  invalid("typed value type is unsupported by direct typed HIR");
+}
+
+PrimitiveCompareOp compareKind(std::string_view op) {
+  if (op == "compare.eq") {
+    return PrimitiveCompareOp::kEqual;
+  }
+  if (op == "compare.ne") {
+    return PrimitiveCompareOp::kNotEqual;
+  }
+  if (op == "compare.lt") {
+    return PrimitiveCompareOp::kLessThan;
+  }
+  if (op == "compare.le") {
+    return PrimitiveCompareOp::kLessThanEqual;
+  }
+  if (op == "compare.gt") {
+    return PrimitiveCompareOp::kGreaterThan;
+  }
+  if (op == "compare.ge") {
+    return PrimitiveCompareOp::kGreaterThanEqual;
+  }
+  invalid("unsupported typed comparison");
+}
+
+CompareOp boxedCompareKind(std::string_view op) {
+  if (op == "compare.eq") {
+    return CompareOp::kEqual;
+  }
+  if (op == "compare.ne") {
+    return CompareOp::kNotEqual;
+  }
+  if (op == "compare.lt") {
+    return CompareOp::kLessThan;
+  }
+  if (op == "compare.le") {
+    return CompareOp::kLessThanEqual;
+  }
+  if (op == "compare.gt") {
+    return CompareOp::kGreaterThan;
+  }
+  if (op == "compare.ge") {
+    return CompareOp::kGreaterThanEqual;
+  }
+  invalid("unsupported typed comparison");
+}
+
+BinaryOpKind binaryKind(std::string_view op) {
+  if (op == "binary.add") {
+    return BinaryOpKind::kAdd;
+  }
+  if (op == "binary.sub") {
+    return BinaryOpKind::kSubtract;
+  }
+  if (op == "binary.mul") {
+    return BinaryOpKind::kMultiply;
+  }
+  if (op == "binary.truediv") {
+    return BinaryOpKind::kTrueDivide;
+  }
+  invalid("unsupported typed binary operation");
+}
+
+int64_t unicodeProperty(std::string_view name) {
+  static const std::unordered_map<std::string_view, int64_t> properties{
+      {"alnum", 0},
+      {"alpha", 1},
+      {"decimal", 2},
+      {"digit", 3},
+      {"numeric", 4},
+      {"space", 5}};
+  auto it = properties.find(name);
+  if (it == properties.end()) {
+    invalid("unsupported Unicode property");
+  }
+  return it->second;
+}
+
+bool sameType(const RegionType& left, const RegionType& right) {
+  return left.kind == right.kind && left.name == right.name &&
+      left.exactness == right.exactness &&
+      left.representation == right.representation;
+}
+
+bool isInt64(const RegionType& type) {
+  return type.kind == "scalar" && type.name == "int64" &&
+      type.representation == "unboxed";
+}
+
+bool isFloat64(const RegionType& type) {
+  return type.kind == "scalar" && type.name == "float64" &&
+      type.representation == "unboxed";
+}
+
+bool isNumeric(const RegionType& type) {
+  return isInt64(type) || isFloat64(type);
+}
+
+bool isBool(const RegionType& type) {
+  return type.kind == "scalar" && type.name == "bool" &&
+      type.representation == "unboxed";
+}
+
+bool isUnicodeScalar(const RegionType& type) {
+  return type.kind == "scalar" && type.name == "unicode.scalar" &&
+      type.representation == "unboxed";
+}
+
+bool isExactStr(const RegionType& type) {
+  return type.kind == "sequence" && type.name == "str" &&
+      type.exactness == "exact" && type.representation == "python_object";
+}
+
+bool isUnicodeBuilder(const RegionType& type) {
+  return type.kind == "builder" && type.name == "unicode.builder" &&
+      type.representation == "internal";
+}
+
+bool hasAttributes(
+    const Operation& operation,
+    std::initializer_list<std::string_view> names) {
+  if (operation.attributes.size() != names.size()) {
+    return false;
+  }
+  return std::all_of(names.begin(), names.end(), [&](std::string_view name) {
+    return operation.attributes.contains(std::string{name});
+  });
+}
+
+void validateModule(const RegionModule& module) {
+  if (module.blocks.empty() || module.operations.empty() ||
+      !isSafeId(module.entry) || !isSafeId(module.return_operation_id)) {
+    invalid("typed region module is empty or has invalid identifiers");
+  }
+
+  std::unordered_map<std::string, const Block*> blocks;
+  for (const Block& block : module.blocks) {
+    if (!isSafeId(block.id) || !blocks.emplace(block.id, &block).second) {
+      invalid("typed region block identifier is invalid or duplicated");
+    }
+  }
+  if (!blocks.contains(module.entry) ||
+      !blocks.at(module.entry)->arguments.empty()) {
+    invalid("typed region entry block is invalid");
+  }
+
+  std::unordered_map<std::string, const Operation*> operations;
+  for (const Operation& operation : module.operations) {
+    if (!isSafeId(operation.id) || !isSafeId(operation.block) ||
+        !operations.emplace(operation.id, &operation).second) {
+      invalid("typed operation identifier is invalid or duplicated");
+    }
+  }
+  std::size_t flattened_index = 0;
+  for (const Block& block : module.blocks) {
+    if (block.operations.empty()) {
+      invalid("typed region block is empty");
+    }
+    for (const std::string& operation_id : block.operations) {
+      if (flattened_index >= module.operations.size() ||
+          module.operations[flattened_index].id != operation_id ||
+          module.operations[flattened_index].block != block.id) {
+        invalid("typed block operation order is inconsistent");
+      }
+      ++flattened_index;
+    }
+  }
+  if (flattened_index != module.operations.size()) {
+    invalid("typed block operation list is incomplete");
+  }
+
+  std::unordered_map<std::string, RegionType> value_types;
+  struct Definition {
+    std::string block;
+    int position;
+  };
+  std::unordered_map<std::string, Definition> definitions;
+  for (const Block& block : module.blocks) {
+    for (const BlockArgument& argument : block.arguments) {
+      hirType(argument.type);
+      if (!isSafeId(argument.id) ||
+          !value_types.emplace(argument.id, argument.type).second) {
+        invalid("typed block argument is invalid or duplicated");
+      }
+      definitions.emplace(argument.id, Definition{block.id, -1});
+    }
+    for (std::size_t position = 0; position < block.operations.size();
+         ++position) {
+      const Operation& operation = *operations.at(block.operations[position]);
+      if (!operation.result.has_value()) {
+        continue;
+      }
+      if (!operation.result_type.has_value() || !isSafeId(*operation.result) ||
+          !value_types.emplace(*operation.result, *operation.result_type)
+               .second) {
+        invalid("typed operation result is invalid or duplicated");
+      }
+      hirType(*operation.result_type);
+      definitions.emplace(
+          *operation.result, Definition{block.id, static_cast<int>(position)});
+    }
+  }
+
+  std::unordered_map<std::string, std::unordered_set<std::string>> predecessors;
+  std::unordered_map<std::string, std::vector<const EdgeInfo*>> edges_by_source;
+  std::unordered_set<std::string> edge_keys;
+  for (const Block& block : module.blocks) {
+    predecessors.emplace(block.id, std::unordered_set<std::string>{});
+  }
+  for (const EdgeInfo& edge_info : module.edges) {
+    if (edge_info.kind != "jump" && edge_info.kind != "branch_true" &&
+        edge_info.kind != "branch_false") {
+      invalid("typed region edge kind is unsupported");
+    }
+    std::string key =
+        edge_info.source + "\x1f" + edge_info.target + "\x1f" + edge_info.kind;
+    if (!blocks.contains(edge_info.source) ||
+        !blocks.contains(edge_info.target) ||
+        !edge_keys.insert(std::move(key)).second) {
+      invalid("typed region edge is invalid or duplicated");
+    }
+    edges_by_source[edge_info.source].push_back(&edge_info);
+    predecessors[edge_info.target].insert(edge_info.source);
+    const Block& target = *blocks.at(edge_info.target);
+    if (target.arguments.size() != edge_info.arguments.size()) {
+      invalid("typed control edge argument arity mismatch");
+    }
+    for (std::size_t index = 0; index < target.arguments.size(); ++index) {
+      auto value_type = value_types.find(edge_info.arguments[index]);
+      if (value_type == value_types.end() ||
+          !sameType(value_type->second, target.arguments[index].type)) {
+        invalid("typed control edge argument type mismatch");
+      }
+    }
+  }
+
+  for (const Block& block : module.blocks) {
+    const Operation& terminator = *operations.at(block.operations.back());
+    std::unordered_set<std::string> expected;
+    if (terminator.op == "jump" &&
+        hasAttributes(terminator, {"target_block"})) {
+      expected.insert(attribute(terminator, "target_block") + "\x1f" + "jump");
+    } else if (
+        terminator.op == "branch" &&
+        hasAttributes(terminator, {"false_block", "true_block"})) {
+      expected.insert(
+          attribute(terminator, "true_block") + "\x1f" + "branch_true");
+      expected.insert(
+          attribute(terminator, "false_block") + "\x1f" + "branch_false");
+    } else if (terminator.op != "return") {
+      invalid("typed block has an invalid terminator");
+    }
+    std::unordered_set<std::string> observed;
+    for (const EdgeInfo* edge_info : edges_by_source[block.id]) {
+      observed.insert(edge_info->target + "\x1f" + edge_info->kind);
+    }
+    if (expected != observed) {
+      invalid("typed terminator and edge set disagree");
+    }
+  }
+
+  std::unordered_map<std::string, std::unordered_set<std::string>> dominators;
+  std::unordered_set<std::string> all_blocks;
+  for (const Block& block : module.blocks) {
+    all_blocks.insert(block.id);
+    dominators[block.id] = block.id == module.entry
+        ? std::unordered_set<std::string>{module.entry}
+        : all_blocks;
+  }
+  // all_blocks was still growing above; initialize non-entry sets once more.
+  for (const Block& block : module.blocks) {
+    if (block.id != module.entry) {
+      dominators[block.id] = all_blocks;
+    }
+  }
+  bool changed = true;
+  while (changed) {
+    changed = false;
+    for (const Block& block : module.blocks) {
+      if (block.id == module.entry || predecessors[block.id].empty()) {
+        continue;
+      }
+      std::unordered_set<std::string> common = all_blocks;
+      for (const std::string& predecessor : predecessors[block.id]) {
+        std::erase_if(common, [&](const std::string& candidate) {
+          return !dominators[predecessor].contains(candidate);
+        });
+      }
+      common.insert(block.id);
+      if (common != dominators[block.id]) {
+        dominators[block.id] = std::move(common);
+        changed = true;
+      }
+    }
+  }
+  auto available = [&](const std::string& value_id,
+                       const std::string& use_block,
+                       int use_position) {
+    auto definition = definitions.find(value_id);
+    if (definition == definitions.end()) {
+      return false;
+    }
+    if (definition->second.block == use_block) {
+      return definition->second.position < use_position;
+    }
+    return dominators[use_block].contains(definition->second.block);
+  };
+  for (const EdgeInfo& edge_info : module.edges) {
+    int position =
+        static_cast<int>(blocks.at(edge_info.source)->operations.size()) - 1;
+    for (const std::string& argument : edge_info.arguments) {
+      if (!available(argument, edge_info.source, position)) {
+        invalid("typed edge argument is not available at its source");
+      }
+    }
+  }
+
+  int64_t next_exception_order = 0;
+  std::size_t return_count = 0;
+  std::vector<int64_t> argument_indexes;
+  for (const Block& block : module.blocks) {
+    for (std::size_t position = 0; position < block.operations.size();
+         ++position) {
+      const Operation& operation = *operations.at(block.operations[position]);
+      if (operation.effect != "pure" ||
+          operation.determinism != "deterministic" ||
+          (operation.source_offset.has_value() &&
+           *operation.source_offset < 0)) {
+        invalid("typed operation effect or source metadata is unsupported");
+      }
+      bool expected_raise = operation.op == "binary.truediv" ||
+          operation.op == "sequence.get" ||
+          operation.op == "sequence.builder.create" ||
+          operation.op == "sequence.builder.append" ||
+          operation.op == "sequence.builder.apply" ||
+          operation.op == "sequence.builder.finish";
+      if (operation.may_raise != expected_raise ||
+          (operation.may_raise &&
+           operation.exception_order !=
+               std::optional<int64_t>{next_exception_order}) ||
+          (!operation.may_raise && operation.exception_order.has_value())) {
+        invalid("typed operation exception metadata is invalid");
+      }
+      next_exception_order += operation.may_raise;
+      for (const std::string& operand : operation.operands) {
+        if (!available(operand, block.id, static_cast<int>(position))) {
+          invalid("typed operand is not available at its use");
+        }
+      }
+      auto operand_type = [&](std::size_t index) -> const RegionType& {
+        if (index >= operation.operands.size()) {
+          invalid("typed operation operand arity mismatch");
+        }
+        return value_types.at(operation.operands[index]);
+      };
+      auto result_type = [&]() -> const RegionType& {
+        if (!operation.result_type.has_value()) {
+          invalid("typed value operation has no result type");
+        }
+        return *operation.result_type;
+      };
+      auto require_value = [&]() {
+        if (!operation.result.has_value() ||
+            !operation.result_type.has_value()) {
+          invalid("typed value operation has no result");
+        }
+      };
+      auto require_terminator = [&]() {
+        if (operation.result.has_value() || operation.result_type.has_value()) {
+          invalid("typed terminator unexpectedly has a result");
+        }
+      };
+
+      if (operation.op == "argument") {
+        require_value();
+        if (!operation.operands.empty() ||
+            !hasAttributes(operation, {"index"}) ||
+            !isExactStr(result_type())) {
+          invalid("typed argument operation is invalid");
+        }
+        int64_t index = parseInt64(attribute(operation, "index"), "argument");
+        if (index < 0 || index >= static_cast<int64_t>(module.inputs.size()) ||
+            !sameType(result_type(), module.inputs[index])) {
+          invalid("typed argument index or type is invalid");
+        }
+        argument_indexes.push_back(index);
+      } else if (operation.op == "constant") {
+        require_value();
+        if (!operation.operands.empty() || !operation.attributes.empty() ||
+            !operation.literal.has_value()) {
+          invalid("typed constant operation is invalid");
+        }
+        if (operation.literal->kind == "int64" && isInt64(result_type())) {
+          parseInt64(operation.literal->encoded, "constant");
+        } else if (
+            operation.literal->kind == "float64" && isFloat64(result_type())) {
+          parseFloat64(operation.literal->encoded, "constant");
+        } else {
+          invalid("typed constant operation has an unsupported literal type");
+        }
+      } else if (operation.op.starts_with("binary.")) {
+        require_value();
+        bool same_operands = sameType(operand_type(0), operand_type(1));
+        bool regular =
+            (operation.op == "binary.add" || operation.op == "binary.sub" ||
+             operation.op == "binary.mul") &&
+            same_operands && isNumeric(operand_type(0)) &&
+            sameType(operand_type(0), result_type());
+        bool true_divide = operation.op == "binary.truediv" && same_operands &&
+            isNumeric(operand_type(0)) && isFloat64(result_type());
+        if (operation.operands.size() != 2 || !operation.attributes.empty() ||
+            (!regular && !true_divide)) {
+          invalid("typed numeric binary operation is invalid");
+        }
+      } else if (operation.op.starts_with("compare.")) {
+        require_value();
+        if (operation.operands.size() != 2 || !operation.attributes.empty() ||
+            !sameType(operand_type(0), operand_type(1)) ||
+            !isNumeric(operand_type(0)) || !isBool(result_type())) {
+          invalid("typed comparison operation is invalid");
+        }
+        compareKind(operation.op);
+      } else if (operation.op == "cast") {
+        require_value();
+        if (operation.operands.size() != 1 ||
+            !hasAttributes(operation, {"target"}) ||
+            attribute(operation, "target") != "int64" ||
+            !isBool(operand_type(0)) || !isInt64(result_type())) {
+          invalid("typed cast operation is invalid");
+        }
+      } else if (operation.op == "sequence.length") {
+        require_value();
+        if (operation.operands.size() != 1 || !operation.attributes.empty() ||
+            !isExactStr(operand_type(0)) || !isInt64(result_type())) {
+          invalid("typed sequence length operation is invalid");
+        }
+      } else if (operation.op == "sequence.get") {
+        require_value();
+        if (operation.operands.size() != 2 || !operation.attributes.empty() ||
+            !isExactStr(operand_type(0)) || !isInt64(operand_type(1)) ||
+            !isUnicodeScalar(result_type())) {
+          invalid("typed sequence read operation is invalid");
+        }
+      } else if (operation.op == "unicode.property") {
+        require_value();
+        if (operation.operands.size() != 1 ||
+            !hasAttributes(operation, {"property"}) ||
+            !isUnicodeScalar(operand_type(0)) || !isBool(result_type())) {
+          invalid("typed Unicode classification operation is invalid");
+        }
+        unicodeProperty(attribute(operation, "property"));
+      } else if (operation.op == "immutable.lookup") {
+        require_value();
+        if (operation.operands.size() != 2 ||
+            !hasAttributes(operation, {"keys", "values"}) ||
+            !isUnicodeScalar(operand_type(0)) ||
+            !isUnicodeScalar(operand_type(1)) ||
+            !isUnicodeScalar(result_type())) {
+          invalid("typed immutable lookup operation is invalid");
+        }
+        auto keys = parseIntTable(attribute(operation, "keys"), 0, 0x10ffff);
+        auto values =
+            parseIntTable(attribute(operation, "values"), 0, 0x10ffff);
+        if (keys.size() != values.size() ||
+            !std::is_sorted(keys.begin(), keys.end()) ||
+            std::adjacent_find(keys.begin(), keys.end()) != keys.end()) {
+          invalid("typed immutable lookup table is invalid");
+        }
+      } else if (operation.op == "fsm.transition") {
+        require_value();
+        int64_t class_count =
+            parseInt64(attribute(operation, "class_count"), "class_count");
+        int64_t state_count =
+            parseInt64(attribute(operation, "state_count"), "state_count");
+        auto transitions = parseIntTable(
+            attribute(operation, "transitions"), 0, state_count - 1);
+        if (operation.operands.size() != 2 ||
+            !hasAttributes(
+                operation, {"class_count", "state_count", "transitions"}) ||
+            class_count != 2 || state_count <= 0 || state_count > 64 ||
+            transitions.size() !=
+                static_cast<std::size_t>(class_count * state_count) ||
+            !isInt64(operand_type(0)) || !isBool(operand_type(1)) ||
+            !isInt64(result_type())) {
+          invalid("typed FSM transition operation is invalid");
+        }
+      } else if (operation.op == "sequence.builder.create") {
+        require_value();
+        if (operation.operands.size() != 1 || !operation.attributes.empty() ||
+            !isInt64(operand_type(0)) || !isUnicodeBuilder(result_type())) {
+          invalid("typed sequence builder creation is invalid");
+        }
+      } else if (operation.op == "sequence.builder.append") {
+        require_value();
+        if (operation.operands.size() != 2 || !operation.attributes.empty() ||
+            !isUnicodeBuilder(operand_type(0)) ||
+            !isUnicodeScalar(operand_type(1)) ||
+            !isUnicodeBuilder(result_type())) {
+          invalid("typed sequence builder append is invalid");
+        }
+      } else if (operation.op == "sequence.builder.apply") {
+        require_value();
+        int64_t class_count =
+            parseInt64(attribute(operation, "class_count"), "class_count");
+        int64_t state_count =
+            parseInt64(attribute(operation, "state_count"), "state_count");
+        auto actions = parseIntTable(attribute(operation, "actions"), 0, 4);
+        auto emissions =
+            parseIntTable(attribute(operation, "emissions"), 0, 0x10ffff);
+        if (operation.operands.size() != 4 ||
+            !hasAttributes(
+                operation,
+                {"actions", "class_count", "emissions", "state_count"}) ||
+            class_count != 2 || state_count <= 0 || state_count > 64 ||
+            actions.size() !=
+                static_cast<std::size_t>(class_count * state_count) ||
+            emissions.size() != actions.size() ||
+            !isUnicodeBuilder(operand_type(0)) ||
+            !isUnicodeScalar(operand_type(1)) || !isInt64(operand_type(2)) ||
+            !isBool(operand_type(3)) || !isUnicodeBuilder(result_type())) {
+          invalid("typed sequence builder action is invalid");
+        }
+      } else if (operation.op == "sequence.builder.finish") {
+        require_value();
+        if (operation.operands.size() != 1 || !operation.attributes.empty() ||
+            !isUnicodeBuilder(operand_type(0)) || !isExactStr(result_type())) {
+          invalid("typed sequence builder finish is invalid");
+        }
+      } else if (operation.op == "jump") {
+        require_terminator();
+        if (!operation.operands.empty() ||
+            !hasAttributes(operation, {"target_block"})) {
+          invalid("typed jump operation is invalid");
+        }
+      } else if (operation.op == "branch") {
+        require_terminator();
+        if (operation.operands.size() != 1 ||
+            !hasAttributes(operation, {"false_block", "true_block"}) ||
+            !isBool(operand_type(0))) {
+          invalid("typed branch operation is invalid");
+        }
+      } else if (operation.op == "return") {
+        require_terminator();
+        ++return_count;
+        if (operation.operands.size() != 1 || !operation.attributes.empty() ||
+            !sameType(operand_type(0), module.output) ||
+            operation.id != module.return_operation_id) {
+          invalid("typed return operation is invalid");
+        }
+      } else {
+        invalid(std::string{"unsupported typed operation: "} + operation.op);
+      }
+    }
+  }
+  if (return_count != 1 || argument_indexes.size() != module.inputs.size()) {
+    invalid("typed region argument or return set is invalid");
+  }
+  for (std::size_t index = 0; index < argument_indexes.size(); ++index) {
+    if (argument_indexes[index] != static_cast<int64_t>(index)) {
+      invalid("typed region argument order is invalid");
+    }
+  }
+}
+
+class TypedHIRBuilder {
+ public:
+  TypedHIRBuilder(const Preloader& preloader, RegionModule module)
+      : preloader_(preloader), module_(std::move(module)) {}
+
+  std::unique_ptr<Function> build() {
+    validateSignature();
+    function_ = preloader_.makeFunction();
+    function_->return_type = TObject;
+    allocateGraph();
+    emitPrologue();
+    for (const Block& block : module_.blocks) {
+      emitBlock(block);
+    }
+    for (const auto& [id, block] : blocks_) {
+      if (block->empty() || block->GetTerminator() == nullptr ||
+          !block->GetTerminator()->IsTerminator()) {
+        invalid(std::string{"typed block has no terminator: "} + id);
+      }
+    }
+    return std::move(function_);
+  }
+
+ private:
+  struct UnicodeLayout {
+    Register* data;
+    Register* kind;
+    Register* length;
+  };
+
+  void validateSignature() {
+    if (module_.inputs.size() != 1 || module_.inputs[0].kind != "sequence" ||
+        module_.inputs[0].name != "str" ||
+        module_.inputs[0].exactness != "exact" || preloader_.numArgs() != 1) {
+      invalid("direct typed HIR currently requires one exact-str input");
+    }
+    hirType(module_.output);
+  }
+
+  Register* allocate() {
+    return function_->env.AllocateRegister();
+  }
+
+  BCOffset currentOffset() const {
+    return current_operation_offset_.value_or(frame_.instrOffset());
+  }
+
+  Register* value(const std::string& id) const {
+    auto it = values_.find(id);
+    if (it == values_.end()) {
+      invalid(std::string{"unknown typed value: "} + id);
+    }
+    return it->second;
+  }
+
+  Register* result(const Operation& operation) const {
+    if (!operation.result.has_value()) {
+      invalid("typed value operation is missing a result");
+    }
+    return value(*operation.result);
+  }
+
+  Register* builderData(const std::string& id) const {
+    auto it = builder_data_values_.find(id);
+    if (it == builder_data_values_.end()) {
+      invalid(std::string{"typed value is not a sequence builder: "} + id);
+    }
+    return it->second;
+  }
+
+  Register* temporary() {
+    return allocate();
+  }
+
+  const UnicodeLayout& cacheUnicodeLayout(BasicBlock* block, Register* text) {
+    auto found = unicode_layouts_.find(text);
+    if (found != unicode_layouts_.end()) {
+      return found->second;
+    }
+    UnicodeLayout layout{temporary(), temporary(), temporary()};
+    block->appendWithOff<UnicodeData>(currentOffset(), layout.data, text);
+    block->appendWithOff<UnicodeKind>(currentOffset(), layout.kind, text);
+    block->appendWithOff<LoadField>(
+        currentOffset(),
+        layout.length,
+        text,
+        "length",
+        offsetof(PyASCIIObject, length),
+        TCInt64);
+    return unicode_layouts_.emplace(text, layout).first->second;
+  }
+
+  Register* intConstant(BasicBlock* block, int64_t value) {
+    Register* output = temporary();
+    block->appendWithOff<LoadConst>(
+        currentOffset(), output, Type::fromCInt(value, TCInt64));
+    return output;
+  }
+
+  Register* doubleConstant(BasicBlock* block, double value) {
+    Register* output = temporary();
+    block->appendWithOff<LoadConst>(
+        currentOffset(), output, Type::fromCDouble(value));
+    return output;
+  }
+
+  Register* boxPrimitive(BasicBlock* block, Register* value, Type type) {
+    Register* output = temporary();
+    block->appendWithOff<PrimitiveBox>(
+        currentOffset(), output, value, type, frame_);
+    return output;
+  }
+
+  void emitFloatCompare(
+      BasicBlock* block,
+      const Operation& operation,
+      Register* left,
+      Register* right) {
+    Register* boxed_left = boxPrimitive(block, left, TCDouble);
+    Register* boxed_right = boxPrimitive(block, right, TCDouble);
+    Register* boxed_result = temporary();
+    block->appendWithOff<FloatCompare>(
+        currentOffset(),
+        boxed_result,
+        boxedCompareKind(operation.op),
+        boxed_left,
+        boxed_right);
+    Register* expected = temporary();
+    block->appendWithOff<LoadConst>(
+        currentOffset(), expected, Type::fromObject(Py_True));
+    block->appendWithOff<PrimitiveCompare>(
+        currentOffset(),
+        result(operation),
+        PrimitiveCompareOp::kEqual,
+        boxed_result,
+        expected);
+  }
+
+  void emitTrueDivide(BasicBlock*& block, const Operation& operation) {
+    Register* left = value(operation.operands[0]);
+    Register* right = value(operation.operands[1]);
+    const RegionType& operand_type = *value_types_.at(operation.operands[0]);
+    if (isInt64(operand_type)) {
+      Register* boxed_left = boxPrimitive(block, left, TCInt64);
+      Register* boxed_right = boxPrimitive(block, right, TCInt64);
+      Register* boxed_result = temporary();
+      block->appendWithOff<LongBinaryOp>(
+          currentOffset(),
+          boxed_result,
+          BinaryOpKind::kTrueDivide,
+          boxed_left,
+          boxed_right,
+          frame_);
+      block->appendWithOff<PrimitiveUnbox>(
+          currentOffset(), result(operation), boxed_result, TCDouble);
+      return;
+    }
+    if (!isFloat64(operand_type)) {
+      invalid("typed true-divide operand type is unsupported");
+    }
+
+    Register* nonzero = temporary();
+    block->appendWithOff<PrimitiveCompare>(
+        currentOffset(),
+        nonzero,
+        PrimitiveCompareOp::kNotEqual,
+        right,
+        doubleConstant(block, 0.0));
+    BasicBlock* divide = function_->cfg.AllocateBlock();
+    BasicBlock* zero = function_->cfg.AllocateBlock();
+    BasicBlock* join = function_->cfg.AllocateBlock();
+    block->appendWithOff<CondBranch>(currentOffset(), nonzero, divide, zero);
+    zero->appendWithOff<RaiseStatic>(
+        currentOffset(),
+        0,
+        PyExc_ZeroDivisionError,
+        "division by zero",
+        frame_);
+    divide->appendWithOff<DoubleBinaryOp>(
+        currentOffset(),
+        result(operation),
+        BinaryOpKind::kTrueDivide,
+        left,
+        right);
+    divide->appendWithOff<Branch>(currentOffset(), join);
+    block = join;
+  }
+
+  Register* tableConstant(
+      BasicBlock* block,
+      const std::vector<int64_t>& table) {
+    Ref<> tuple = Ref<>::steal(PyTuple_New(table.size()));
+    if (tuple == nullptr) {
+      throw std::bad_alloc{};
+    }
+    for (std::size_t index = 0; index < table.size(); ++index) {
+      PyObject* item = PyLong_FromLongLong(table[index]);
+      if (item == nullptr) {
+        throw std::bad_alloc{};
+      }
+      PyTuple_SET_ITEM(tuple.get(), index, item);
+    }
+    BorrowedRef<> owned = function_->env.addReference(std::move(tuple));
+    Register* output = temporary();
+    block->appendWithOff<LoadConst>(
+        currentOffset(), output, Type::fromObject(owned));
+    return output;
+  }
+
+  Register* tableConstant(
+      BasicBlock* block,
+      const Operation& operation,
+      const char* name,
+      int64_t minimum = 0,
+      int64_t maximum = 0x10ffff) {
+    return tableConstant(
+        block, parseIntTable(attribute(operation, name), minimum, maximum));
+  }
+
+  void allocateGraph() {
+    for (const Block& block : module_.blocks) {
+      blocks_.emplace(block.id, function_->cfg.AllocateBlock());
+      for (const BlockArgument& argument : block.arguments) {
+        hirType(argument.type);
+        if (!values_.emplace(argument.id, allocate()).second) {
+          invalid("duplicate typed value id");
+        }
+        if (isUnicodeBuilder(argument.type)) {
+          builder_data_values_.emplace(argument.id, allocate());
+        }
+        value_types_.emplace(argument.id, &argument.type);
+      }
+    }
+    function_->cfg.entry_block = blocks_.at(module_.entry);
+    for (const Operation& operation : module_.operations) {
+      operations_.emplace(operation.id, &operation);
+      if (operation.result.has_value()) {
+        hirType(*operation.result_type);
+        if (!values_.emplace(*operation.result, allocate()).second) {
+          invalid("duplicate typed value id");
+        }
+        if (isUnicodeBuilder(*operation.result_type)) {
+          builder_data_values_.emplace(*operation.result, allocate());
+        }
+        value_types_.emplace(*operation.result, &*operation.result_type);
+      }
+    }
+
+    PyCodeObject* code = preloader_.code();
+    frame_ =
+        FrameState{code, preloader_.globals(), preloader_.builtins(), nullptr};
+    frame_.nlocals = numLocals(code);
+    frame_.localsplus.resize(numLocalsplus(code), nullptr);
+    for (int index = 0; index < preloader_.numArgs(); ++index) {
+      frame_.localsplus[index] = allocate();
+    }
+    discoverBackedges();
+  }
+
+  std::string edgeKey(const EdgeInfo& edge_info) const {
+    return edge_info.source + "\x1f" + edge_info.kind;
+  }
+
+  void discoverBackedges() {
+    enum class Color { kWhite, kGray, kBlack };
+    std::unordered_map<std::string, Color> colors;
+    for (const Block& block : module_.blocks) {
+      colors.emplace(block.id, Color::kWhite);
+    }
+    std::function<void(const std::string&)> visit = [&](const std::string& id) {
+      colors.at(id) = Color::kGray;
+      for (const EdgeInfo& edge_info : module_.edges) {
+        if (edge_info.source != id || edge_info.kind == "exception") {
+          continue;
+        }
+        Color target_color = colors.at(edge_info.target);
+        if (target_color == Color::kGray) {
+          backedges_.insert(edgeKey(edge_info));
+        } else if (target_color == Color::kWhite) {
+          visit(edge_info.target);
+        }
+      }
+      colors.at(id) = Color::kBlack;
+    };
+    visit(module_.entry);
+    if (std::any_of(colors.begin(), colors.end(), [](const auto& item) {
+          return item.second != Color::kBlack;
+        })) {
+      invalid("typed region contains an unreachable block");
+    }
+  }
+
+  void emitPrologue() {
+    BasicBlock* entry = blocks_.at(module_.entry);
+    // LoadArg instructions must be a contiguous prefix of the entry block.
+    for (int index = 0; index < preloader_.numArgs(); ++index) {
+      entry->appendWithOff<LoadArg>(
+          frame_.instrOffset(), frame_.localsplus[index], index, TObject);
+    }
+    entry->appendWithOff<LoadFrame>(frame_.instrOffset());
+    entry->appendWithOff<Snapshot>(frame_.instrOffset(), frame_);
+
+    for (const Operation& operation : module_.operations) {
+      if (operation.op != "argument") {
+        continue;
+      }
+      current_operation_offset_ = operation.bytecode_offset.has_value()
+          ? std::optional<BCOffset>{BCOffset{*operation.bytecode_offset}}
+          : std::nullopt;
+      int64_t index =
+          parseInt64(attribute(operation, "index"), "argument index");
+      if (index < 0 || index >= preloader_.numArgs()) {
+        invalid("typed argument index out of range");
+      }
+      entry->appendWithOff<GuardType>(
+          currentOffset(),
+          result(operation),
+          TUnicodeExact,
+          frame_.localsplus[index],
+          frame_);
+      cacheUnicodeLayout(entry, result(operation));
+    }
+  }
+
+  const EdgeInfo& edge(const std::string& source, std::string_view kind) const {
+    const EdgeInfo* found = nullptr;
+    for (const EdgeInfo& edge : module_.edges) {
+      if (edge.source == source && edge.kind == kind) {
+        if (found != nullptr) {
+          invalid("duplicate typed control edge kind");
+        }
+        found = &edge;
+      }
+    }
+    if (found == nullptr) {
+      invalid("typed control edge is missing");
+    }
+    return *found;
+  }
+
+  void assignEdgeArguments(BasicBlock* block, const EdgeInfo& edge_info) {
+    const Block* target = nullptr;
+    for (const Block& candidate : module_.blocks) {
+      if (candidate.id == edge_info.target) {
+        target = &candidate;
+        break;
+      }
+    }
+    if (target == nullptr ||
+        target->arguments.size() != edge_info.arguments.size()) {
+      invalid("typed control edge argument arity mismatch");
+    }
+    for (std::size_t index = 0; index < target->arguments.size(); ++index) {
+      block->appendWithOff<Assign>(
+          currentOffset(),
+          value(target->arguments[index].id),
+          value(edge_info.arguments[index]));
+      if (isUnicodeBuilder(target->arguments[index].type)) {
+        block->appendWithOff<Assign>(
+            currentOffset(),
+            builderData(target->arguments[index].id),
+            builderData(edge_info.arguments[index]));
+      }
+    }
+  }
+
+  void emitEdgeBranch(BasicBlock* block, const EdgeInfo& edge_info) {
+    assignEdgeArguments(block, edge_info);
+    BasicBlock* target = blocks_.at(edge_info.target);
+    if (!backedges_.contains(edgeKey(edge_info))) {
+      block->appendWithOff<Branch>(currentOffset(), target);
+      return;
+    }
+
+    BasicBlock* check = function_->cfg.AllocateBlock();
+    BasicBlock* periodic = function_->cfg.AllocateBlock();
+    block->appendWithOff<Branch>(currentOffset(), check);
+#ifdef Py_GIL_DISABLED
+    check->appendWithOff<AtQuiescentState>(frame_.instrOffset());
+#endif
+    Register* eval_breaker = temporary();
+    check->appendWithOff<LoadEvalBreaker>(frame_.instrOffset(), eval_breaker);
+    check->appendWithOff<CondBranch>(
+        frame_.instrOffset(), eval_breaker, periodic, target);
+    periodic->appendWithOff<Snapshot>(frame_.instrOffset(), frame_);
+    Register* result = temporary();
+    periodic->appendWithOff<RunPeriodicTasks>(
+        frame_.instrOffset(), result, frame_);
+    periodic->appendWithOff<Branch>(frame_.instrOffset(), target);
+  }
+
+  Register* emitEquality(BasicBlock* block, Register* input, int64_t expected) {
+    Register* condition = temporary();
+    block->appendWithOff<PrimitiveCompare>(
+        currentOffset(),
+        condition,
+        PrimitiveCompareOp::kEqual,
+        input,
+        intConstant(block, expected));
+    return condition;
+  }
+
+  Register* emitAnyEquality(
+      BasicBlock* block,
+      Register* input,
+      std::initializer_list<int64_t> expected) {
+    Register* combined = nullptr;
+    for (int64_t item : expected) {
+      Register* condition = emitEquality(block, input, item);
+      if (combined == nullptr) {
+        combined = condition;
+      } else {
+        Register* next = temporary();
+        block->appendWithOff<IntBinaryOp>(
+            currentOffset(), next, BinaryOpKind::kOr, combined, condition);
+        combined = next;
+      }
+    }
+    return combined;
+  }
+
+  void emitBuilderAppend(
+      BasicBlock* block,
+      Register* builder,
+      Register* builder_data,
+      Register* codepoint) {
+    Register* status = temporary();
+    Register* checked = temporary();
+    block->appendWithOff<SequenceBuilderAppend>(
+        currentOffset(), status, builder, builder_data, codepoint, frame_);
+    block->appendWithOff<CheckNeg>(currentOffset(), checked, status, frame_);
+  }
+
+  BasicBlock* emitConditionalAppend(
+      BasicBlock* block,
+      Register* condition,
+      Register* builder,
+      Register* builder_data,
+      Register* codepoint) {
+    BasicBlock* append = function_->cfg.AllocateBlock();
+    BasicBlock* join = function_->cfg.AllocateBlock();
+    block->appendWithOff<CondBranch>(currentOffset(), condition, append, join);
+    emitBuilderAppend(append, builder, builder_data, codepoint);
+    append->appendWithOff<Branch>(currentOffset(), join);
+    return join;
+  }
+
+  BasicBlock* emitBuilderApply(BasicBlock* block, const Operation& operation) {
+    if (operation.operands.size() != 4) {
+      invalid("sequence.builder.apply has invalid arity");
+    }
+    Register* builder = value(operation.operands[0]);
+    Register* builder_data = builderData(operation.operands[0]);
+    Register* codepoint = value(operation.operands[1]);
+    Register* state = value(operation.operands[2]);
+    Register* classification = value(operation.operands[3]);
+    int64_t class_count =
+        parseInt64(attribute(operation, "class_count"), "class_count");
+    if (class_count <= 0 || class_count > 16) {
+      invalid("builder class count out of range");
+    }
+
+    Register* class_index = temporary();
+    block->appendWithOff<PrimitiveConvert>(
+        currentOffset(), class_index, classification, TCInt64);
+    Register* scaled_state = temporary();
+    block->appendWithOff<IntBinaryOp>(
+        currentOffset(),
+        scaled_state,
+        BinaryOpKind::kMultiply,
+        state,
+        intConstant(block, class_count));
+    Register* table_index = temporary();
+    block->appendWithOff<IntBinaryOp>(
+        currentOffset(),
+        table_index,
+        BinaryOpKind::kAdd,
+        scaled_state,
+        class_index);
+
+    Register* actions = tableConstant(block, operation, "actions", 0, 4);
+    Register* emissions = tableConstant(block, operation, "emissions");
+    Register* action = temporary();
+    Register* emission = temporary();
+    block->appendWithOff<PrimitiveTableGet>(
+        currentOffset(), action, actions, table_index);
+    block->appendWithOff<PrimitiveTableGet>(
+        currentOffset(), emission, emissions, table_index);
+
+    block = emitConditionalAppend(
+        block,
+        emitAnyEquality(block, action, {2, 3}),
+        builder,
+        builder_data,
+        emission);
+    block = emitConditionalAppend(
+        block,
+        emitAnyEquality(block, action, {1, 3, 4}),
+        builder,
+        builder_data,
+        codepoint);
+    block = emitConditionalAppend(
+        block, emitEquality(block, action, 4), builder, builder_data, emission);
+    block->appendWithOff<Assign>(currentOffset(), result(operation), builder);
+    block->appendWithOff<Assign>(
+        currentOffset(), builderData(*operation.result), builder_data);
+    return block;
+  }
+
+  void emitOperation(BasicBlock*& block, const Operation& operation) {
+    current_operation_offset_ = operation.bytecode_offset.has_value()
+        ? std::optional<BCOffset>{BCOffset{*operation.bytecode_offset}}
+        : std::nullopt;
+    auto operand = [&](std::size_t index) -> Register* {
+      if (index >= operation.operands.size()) {
+        invalid("typed operation operand arity mismatch");
+      }
+      return value(operation.operands[index]);
+    };
+
+    if (operation.op == "argument") {
+      return;
+    }
+    if (operation.op == "constant") {
+      if (!operation.literal.has_value()) {
+        invalid("typed HIR constant is missing its literal");
+      }
+      if (operation.literal->kind == "int64") {
+        block->appendWithOff<LoadConst>(
+            currentOffset(),
+            result(operation),
+            Type::fromCInt(
+                parseInt64(operation.literal->encoded, "constant"), TCInt64));
+        return;
+      }
+      if (operation.literal->kind == "float64") {
+        block->appendWithOff<LoadConst>(
+            currentOffset(),
+            result(operation),
+            Type::fromCDouble(
+                parseFloat64(operation.literal->encoded, "constant")));
+        return;
+      }
+      invalid("typed HIR constant has an unsupported literal type");
+    }
+    if (operation.op == "sequence.length") {
+      auto layout = unicode_layouts_.find(operand(0));
+      if (layout == unicode_layouts_.end()) {
+        block->appendWithOff<LoadField>(
+            currentOffset(),
+            result(operation),
+            operand(0),
+            "length",
+            offsetof(PyASCIIObject, length),
+            TCInt64);
+      } else {
+        block->appendWithOff<Assign>(
+            currentOffset(), result(operation), layout->second.length);
+      }
+      return;
+    }
+    if (operation.op.starts_with("compare.")) {
+      const RegionType& operand_type = *value_types_.at(operation.operands[0]);
+      if (isFloat64(operand_type)) {
+        emitFloatCompare(block, operation, operand(0), operand(1));
+        return;
+      }
+      block->appendWithOff<PrimitiveCompare>(
+          currentOffset(),
+          result(operation),
+          compareKind(operation.op),
+          operand(0),
+          operand(1));
+      return;
+    }
+    if (operation.op.starts_with("binary.")) {
+      if (operation.op == "binary.truediv") {
+        emitTrueDivide(block, operation);
+        return;
+      }
+      const RegionType& operand_type = *value_types_.at(operation.operands[0]);
+      if (isFloat64(operand_type)) {
+        block->appendWithOff<DoubleBinaryOp>(
+            currentOffset(),
+            result(operation),
+            binaryKind(operation.op),
+            operand(0),
+            operand(1));
+        return;
+      }
+      block->appendWithOff<IntBinaryOp>(
+          currentOffset(),
+          result(operation),
+          binaryKind(operation.op),
+          operand(0),
+          operand(1));
+      return;
+    }
+    if (operation.op == "cast") {
+      if (attribute(operation, "target") != "int64") {
+        invalid("unsupported typed primitive cast");
+      }
+      block->appendWithOff<PrimitiveConvert>(
+          currentOffset(), result(operation), operand(0), TCInt64);
+      return;
+    }
+    if (operation.op == "sequence.get") {
+      const UnicodeLayout& layout = cacheUnicodeLayout(block, operand(0));
+      Register* raw = temporary();
+      block->appendWithOff<UnicodeRead>(
+          currentOffset(),
+          raw,
+          operand(0),
+          layout.data,
+          layout.kind,
+          operand(1));
+      block->appendWithOff<CheckNeg>(
+          currentOffset(), result(operation), raw, frame_);
+      return;
+    }
+    if (operation.op == "unicode.property") {
+      Register* property =
+          intConstant(block, unicodeProperty(attribute(operation, "property")));
+      block->appendWithOff<UnicodeClassify>(
+          currentOffset(), result(operation), operand(0), property);
+      return;
+    }
+    if (operation.op == "immutable.lookup") {
+      Register* keys = tableConstant(block, operation, "keys");
+      Register* replacements = tableConstant(block, operation, "values");
+      block->appendWithOff<PrimitiveTableLookup>(
+          currentOffset(),
+          result(operation),
+          keys,
+          replacements,
+          operand(0),
+          operand(1));
+      return;
+    }
+    if (operation.op == "fsm.transition") {
+      int64_t class_count =
+          parseInt64(attribute(operation, "class_count"), "class_count");
+      Register* class_index = temporary();
+      block->appendWithOff<PrimitiveConvert>(
+          currentOffset(), class_index, operand(1), TCInt64);
+      Register* scaled_state = temporary();
+      block->appendWithOff<IntBinaryOp>(
+          currentOffset(),
+          scaled_state,
+          BinaryOpKind::kMultiply,
+          operand(0),
+          intConstant(block, class_count));
+      Register* table_index = temporary();
+      block->appendWithOff<IntBinaryOp>(
+          currentOffset(),
+          table_index,
+          BinaryOpKind::kAdd,
+          scaled_state,
+          class_index);
+      int64_t state_count =
+          parseInt64(attribute(operation, "state_count"), "state_count");
+      Register* transitions =
+          tableConstant(block, operation, "transitions", 0, state_count - 1);
+      block->appendWithOff<PrimitiveTableGet>(
+          currentOffset(), result(operation), transitions, table_index);
+      return;
+    }
+    if (operation.op == "sequence.builder.create") {
+      Register* raw = temporary();
+      block->appendWithOff<SequenceBuilderCreate>(
+          currentOffset(), raw, operand(0), frame_);
+      block->appendWithOff<CheckExc>(
+          currentOffset(), result(operation), raw, frame_);
+      block->appendWithOff<SequenceBuilderData>(
+          currentOffset(), builderData(*operation.result), result(operation));
+      return;
+    }
+    if (operation.op == "sequence.builder.append") {
+      emitBuilderAppend(
+          block, operand(0), builderData(operation.operands[0]), operand(1));
+      block->appendWithOff<Assign>(
+          currentOffset(), result(operation), operand(0));
+      block->appendWithOff<Assign>(
+          currentOffset(),
+          builderData(*operation.result),
+          builderData(operation.operands[0]));
+      return;
+    }
+    if (operation.op == "sequence.builder.apply") {
+      block = emitBuilderApply(block, operation);
+      return;
+    }
+    if (operation.op == "sequence.builder.finish") {
+      Register* raw = temporary();
+      block->appendWithOff<SequenceBuilderFinish>(
+          currentOffset(), raw, operand(0), frame_);
+      block->appendWithOff<CheckExc>(
+          currentOffset(), result(operation), raw, frame_);
+      return;
+    }
+    if (operation.op == "jump") {
+      const EdgeInfo& jump = edge(operation.block, "jump");
+      emitEdgeBranch(block, jump);
+      return;
+    }
+    if (operation.op == "branch") {
+      const EdgeInfo& true_edge = edge(operation.block, "branch_true");
+      const EdgeInfo& false_edge = edge(operation.block, "branch_false");
+      BasicBlock* true_path = function_->cfg.AllocateBlock();
+      BasicBlock* false_path = function_->cfg.AllocateBlock();
+      block->appendWithOff<CondBranch>(
+          currentOffset(), operand(0), true_path, false_path);
+      emitEdgeBranch(true_path, true_edge);
+      emitEdgeBranch(false_path, false_edge);
+      return;
+    }
+    if (operation.op == "return") {
+      Register* returned = operand(0);
+      Type output = hirType(module_.output);
+      if (output <= TCBool) {
+        Register* boxed = temporary();
+        block->appendWithOff<PrimitiveBoxBool>(
+            currentOffset(), boxed, returned);
+        returned = boxed;
+      } else if (output <= TCInt64) {
+        Register* boxed = temporary();
+        block->appendWithOff<PrimitiveBox>(
+            currentOffset(), boxed, returned, TCInt64, frame_);
+        returned = boxed;
+      } else if (output <= TCDouble) {
+        Register* boxed = temporary();
+        block->appendWithOff<PrimitiveBox>(
+            currentOffset(), boxed, returned, TCDouble, frame_);
+        returned = boxed;
+      }
+      block->appendWithOff<Return>(currentOffset(), returned);
+      return;
+    }
+    invalid(std::string{"unsupported typed operation: "} + operation.op);
+  }
+
+  void emitBlock(const Block& block_info) {
+    BasicBlock* current = blocks_.at(block_info.id);
+    bool terminated = false;
+    for (const std::string& operation_id : block_info.operations) {
+      if (terminated) {
+        invalid("typed operation appears after a terminator");
+      }
+      const Operation& operation = *operations_.at(operation_id);
+      emitOperation(current, operation);
+      terminated = operation.op == "jump" || operation.op == "branch" ||
+          operation.op == "return";
+    }
+    if (!terminated) {
+      invalid(std::string{"typed block is not terminated: "} + block_info.id);
+    }
+  }
+
+  const Preloader& preloader_;
+  RegionModule module_;
+  std::unique_ptr<Function> function_;
+  FrameState frame_;
+  std::unordered_map<std::string, BasicBlock*> blocks_;
+  std::unordered_map<std::string, Register*> values_;
+  std::unordered_map<std::string, Register*> builder_data_values_;
+  std::unordered_map<std::string, const RegionType*> value_types_;
+  std::unordered_map<std::string, const Operation*> operations_;
+  std::unordered_map<Register*, UnicodeLayout> unicode_layouts_;
+  std::unordered_set<std::string> backedges_;
+  std::optional<BCOffset> current_operation_offset_;
+};
+
+} // namespace
+
+std::unique_ptr<Function> buildTypedRegionHIR(
+    const Preloader& preloader,
+    BorrowedRef<> semantic,
+    BorrowedRef<> plan,
+    BorrowedRef<> operation_lines) {
+  return TypedHIRBuilder{
+      preloader,
+      parseModule(
+          semantic.getObj(),
+          plan.getObj(),
+          operation_lines.getObj(),
+          preloader.code())}
+      .build();
+}
+
+} // namespace jit::hir
