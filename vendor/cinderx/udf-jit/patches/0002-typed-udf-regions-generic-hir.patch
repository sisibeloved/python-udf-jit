-  return jit::hir::HIRParser{}.ParseHIR(R"(
-fun test {
-  bb 0 {
-    v0 = LoadArg<0>
-    v1 = RefineType<UnicodeExact> v0
-    v2 = LoadArg<1>
-    v3 = RefineType<UnicodeExact> v2
-    v4 = LoadArg<2>
-    v5 = RefineType<UnicodeExact> v4
-    v6 = UnicodeMapSequence v1 v3 v5
-    Return v6
-  }
-}
-)");
-}
-
-std::unique_ptr<jit::hir::Function> parseUnicodeFsmFunction() {
-  return jit::hir::HIRParser{}.ParseHIR(R"(
-fun test {
-  bb 0 {
-    v0 = LoadArg<0>
-    v1 = RefineType<UnicodeExact> v0
-    v2 = LoadConst<CInt64[5]>
-    v3 = LoadConst<CInt64[0]>
-    v4 = LoadArg<1>
-    v5 = RefineType<UnicodeExact> v4
-    v6 = UnicodeFsmSequence v1 v2 v3 v5
-    Return v6
-  }
-}
-)");
-}
-
-const jit::hir::Instr* findSequenceInstruction(
-    const jit::hir::Function& function) {
-  for (const auto& block : function.cfg.blocks) {
-    for (const auto& instr : block) {
-      if (instr.IsUnicodeMapSequence() || instr.IsUnicodeFsmSequence()) {
-        return &instr;
-      }
-    }
-  }
-  return nullptr;
-}
-
-std::string lowerToLir(jit::hir::Function& function) {
-  jit::Compiler::runPasses(
-      function,
-      static_cast<jit::PassConfig>(
-          jit::PassConfig::kAllExceptInliner &
-          ~jit::PassConfig::kInsertUpdatePrevInstr));
-  jit::codegen::Environ env;
-  env.ctx = jit::getContext();
-  jit::CodeRuntime code_runtime{
-      function.code, function.builtins, function.globals};
-  env.code_rt = &code_runtime;
-  jit::lir::LIRGenerator generator{&function, &env};
-  auto lir = generator.TranslateFunction();
-  lir->sortBasicBlocks();
-  std::stringstream stream;
-  stream << *lir;
-  return stream.str();
-}
-
-} // namespace
-
-TEST_F(UdfTypedSequenceIntrinsicTest, HIRMetadataIsTypedAndReplayable) {
-  auto map = parseUnicodeMapFunction();
-  auto fsm = parseUnicodeFsmFunction();
-  ASSERT_NE(map, nullptr);
-  ASSERT_NE(fsm, nullptr);
-  for (const auto* function : {map.get(), fsm.get()}) {
-    const jit::hir::Instr* sequence = findSequenceInstruction(*function);
-    ASSERT_NE(sequence, nullptr);
-    EXPECT_EQ(jit::hir::outputType(*sequence), jit::hir::TUnicodeExact);
-    EXPECT_TRUE(sequence->isReplayable());
-    EXPECT_FALSE(jit::hir::isPassthrough(*sequence));
-    EXPECT_FALSE(jit::hir::hasArbitraryExecution(*sequence));
-    EXPECT_EQ(jit::hir::memoryEffects(*sequence).may_store, jit::hir::AEmpty);
-  }
-}
-
-TEST_F(UdfTypedSequenceIntrinsicTest, LIRCallsGenericRuntimeHelpers) {
-  auto map = parseUnicodeMapFunction();
-  auto fsm = parseUnicodeFsmFunction();
-  ASSERT_NE(map, nullptr);
-  ASSERT_NE(fsm, nullptr);
-  const std::string map_lir = lowerToLir(*map);
-  const std::string fsm_lir = lowerToLir(*fsm);
-  EXPECT_NE(
-      map_lir.find(fmt::format(
-          "{}", reinterpret_cast<uint64_t>(JITRT_UnicodeMapSequence))),
-      std::string::npos)
-      << map_lir;
-  EXPECT_NE(
-      fsm_lir.find(fmt::format(
-          "{}", reinterpret_cast<uint64_t>(JITRT_UnicodeFsmSequence))),
-      std::string::npos)
-      << fsm_lir;
-}
