+constexpr Py_ssize_t kMaxExpandedPrimitiveTableItems = 16;
+
+std::optional<std::vector<int64_t>> constantPrimitiveTable(Register* value) {
+  Type type = value->type();
+  if (!type.hasObjectSpec() || !PyTuple_CheckExact(type.objectSpec())) {
+    return std::nullopt;
+  }
+  PyObject* tuple = type.objectSpec();
+  Py_ssize_t size = PyTuple_GET_SIZE(tuple);
+  if (size <= 0 || size > kMaxExpandedPrimitiveTableItems) {
+    return std::nullopt;
+  }
+  std::vector<int64_t> result;
+  result.reserve(size);
+  for (Py_ssize_t index = 0; index < size; ++index) {
+    PyObject* item = PyTuple_GET_ITEM(tuple, index);
+    if (!PyLong_CheckExact(item)) {
+      return std::nullopt;
+    }
+    int overflow = 0;
+    long long decoded = PyLong_AsLongLongAndOverflow(item, &overflow);
+    if (overflow != 0 || PyErr_Occurred()) {
+      PyErr_Clear();
+      return std::nullopt;
+    }
+    result.push_back(decoded);
+  }
+  return result;
+}
+
+Register* simplifyPrimitiveTableGet(
+    Env& env,
+    const PrimitiveTableGet* instr) {
+  auto values = constantPrimitiveTable(instr->GetOperand(0));
+  if (!values.has_value()) {
+    return nullptr;
+  }
+  Type index_type = instr->GetOperand(1)->type();
+  if (!index_type.hasValueSpec(TCInt64)) {
+    // Dynamic indices are lowered to a bounds-checked native table load in
+    // LIR. Expanding them into a compare/select tree scales linearly with the
+    // table size and repeats that work for every loop iteration.
+    return nullptr;
+  }
+  int64_t index = index_type.intSpec();
+  if (index < 0 || static_cast<std::size_t>(index) >= values->size()) {
+    return nullptr;
+  }
+  env.emit<UseType>(instr->GetOperand(0), instr->GetOperand(0)->type());
+  return env.emit<LoadConst>(Type::fromCInt((*values)[index], TCInt64));
+}
+
+Register* simplifyPrimitiveTableLookup(
+    Env& env,
+    const PrimitiveTableLookup* instr) {
+  auto keys = constantPrimitiveTable(instr->GetOperand(0));
+  auto values = constantPrimitiveTable(instr->GetOperand(1));
+  if (!keys.has_value() || !values.has_value() ||
+      keys->size() != values->size()) {
+    return nullptr;
+  }
+  for (std::size_t index = 1; index < keys->size(); ++index) {
+    if ((*keys)[index - 1] >= (*keys)[index]) {
+      return nullptr;
+    }
+  }
+  Type key_type = instr->GetOperand(2)->type();
+  if (!key_type.hasValueSpec(TCInt64)) {
+    // Dynamic keys are lowered to a balanced decision tree in LIR. Keeping
+    // the generic operation avoids a linear compare/select chain per item.
+    return nullptr;
+  }
+  env.emit<UseType>(instr->GetOperand(0), instr->GetOperand(0)->type());
+  env.emit<UseType>(instr->GetOperand(1), instr->GetOperand(1)->type());
+  int64_t key = key_type.intSpec();
+  auto found = std::lower_bound(keys->begin(), keys->end(), key);
+  if (found == keys->end() || *found != key) {
+    return instr->GetOperand(3);
+  }
+  std::size_t index = static_cast<std::size_t>(found - keys->begin());
+  return env.emit<LoadConst>(Type::fromCInt((*values)[index], TCInt64));
+}
