+void NativeGenerator::captureUdfJitDiagnostics(const asmjit::CodeHolder& code) {
+  if (!getConfig().udf_jit_diagnostics) {
+    return;
+  }
+  const hir::Function* function = GetFunction();
+  JIT_CHECK(function != nullptr, "diagnostic compilation requires HIR");
+  auto diagnostics = std::make_unique<UdfJitCompilationDiagnostics>();
+  std::unordered_map<const hir::Instr*, uint64_t> hir_ids;
+  uint64_t next_hir_id = 0;
+  for (const hir::BasicBlock& block : function->cfg.blocks) {
+    for (const hir::Instr& instr : block) {
+      uint64_t id = next_hir_id++;
+      hir_ids.emplace(&instr, id);
+      int bytecode_offset = instr.bytecodeOffset().value();
+      diagnostics->hir_nodes.push_back(UdfJitHirNode{
+          id,
+          std::string{instr.opname()},
+          bytecode_offset < 0 ? std::nullopt
+                              : std::optional<int>{bytecode_offset},
+          bytecode_offset < 0 ? "hir_without_bytecode_offset" : "",
+      });
+    }
+  }
+
+  for (const lir::BasicBlock* block : lir_func_->basicblocks()) {
+    for (const std::unique_ptr<lir::Instruction>& instr :
+         block->instructions()) {
+      auto origin = hir_ids.find(instr->origin());
+      diagnostics->lir_nodes.push_back(UdfJitLirNode{
+          instr->id(),
+          std::string{instr->opname()},
+          origin == hir_ids.end() ? std::nullopt
+                                  : std::optional<uint64_t>{origin->second},
+          origin == hir_ids.end() ? "lir_without_hir_origin" : "",
+      });
+    }
+  }
+
+  uint64_t next_range_id = 0;
+  for (const ResolvedAnnotation& range :
+       env_.annotations.resolve(code_start_, code)) {
+    std::optional<int> lir_id;
+    std::optional<uint64_t> hir_id;
+    if (range.instr != nullptr) {
+      lir_id = range.instr->id();
+      auto origin = hir_ids.find(range.instr->origin());
+      if (origin != hir_ids.end()) {
+        hir_id = origin->second;
+      }
+    }
+    diagnostics->machine_ranges.push_back(UdfJitMachineRange{
+        next_range_id++,
+        range.start,
+        range.end,
+        range.section == CodeSection::kHot ? "hot" : "cold",
+        function->fullname,
+        lir_id,
+        hir_id,
+        range.synthetic ? "codegen_synthetic" : "",
+    });
+  }
+  udf_jit_diagnostics_ = std::move(diagnostics);
+}
