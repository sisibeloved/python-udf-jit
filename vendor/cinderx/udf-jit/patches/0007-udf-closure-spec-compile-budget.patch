+bool Context::closureSpecBudgetExhausted(BorrowedRef<PyCodeObject> code) {
+  ThreadedCompileSerialize guard;
+  auto it = closure_spec_compiles_.find(code);
+  return it != closure_spec_compiles_.end() &&
+      it->second >= kMaxClosureSpecCompilesPerCode;
+}
+
+void Context::noteClosureSpecCompile(BorrowedRef<PyCodeObject> code) {
+  ThreadedCompileSerialize guard;
+  closure_spec_compiles_[code]++;
+}
+
+void Context::forgetClosureSpecCompiles(BorrowedRef<PyCodeObject> code) {
+  ThreadedCompileSerialize guard;
+  closure_spec_compiles_.erase(code);
+}
