+constexpr const char* kUdfScalarSlotCapsuleName = "cinderjit._udf_scalar_slot";
+constexpr uint64_t kUdfScalarSlotMagic = 0x554446534c4f5431ULL;
+constexpr uint64_t kUdfScalarSlotDeadMagic = 0x5544464445414431ULL;
+
+enum class UdfScalarType : uint8_t {
+  kBool,
+  kI32,
+  kI64,
+  kF32,
+  kF64,
+};
+
+union UdfScalarValue {
+  bool boolean;
+  int32_t i32;
+  int64_t i64;
+  float f32;
+  double f64;
+};
+
+struct UdfScalarSlot {
+  uint64_t magic{kUdfScalarSlotMagic};
+  uint64_t owner_pid{0};
+  uint64_t generation{0};
+  mutable std::mutex mutex;
+  UdfScalarType type{UdfScalarType::kF64};
+  bool nullable{false};
+  bool borrowed{false};
+  bool released{false};
+  bool initialized{false};
+  bool is_null{false};
+  UdfScalarValue value{};
+};
+
+std::atomic<uint64_t> g_udf_scalar_slot_generation{1};
+std::mutex g_udf_scalar_slots_mutex;
+std::unordered_map<PyObject*, std::unique_ptr<UdfScalarSlot>>
+    g_udf_scalar_slots;
+
+uint64_t udfScalarSlotProcessId() {
+#ifdef WIN32
+  return static_cast<uint64_t>(_getpid());
+#else
+  return static_cast<uint64_t>(getpid());
+#endif
+}
+
+void udfScalarSlotCapsuleDestructor(PyObject* capsule) {
+  std::lock_guard<std::mutex> lock{g_udf_scalar_slots_mutex};
+  auto it = g_udf_scalar_slots.find(capsule);
+  if (it == g_udf_scalar_slots.end()) {
+    return;
+  }
+  it->second->magic = kUdfScalarSlotDeadMagic;
+  g_udf_scalar_slots.erase(it);
+}
+
+UdfScalarSlot* checkedUdfScalarSlot(PyObject* capsule) {
+  if (!PyCapsule_CheckExact(capsule)) {
+    PyErr_SetString(PyExc_TypeError, "expected a CinderX scalar-slot capsule");
+    return nullptr;
+  }
+
+  std::lock_guard<std::mutex> lock{g_udf_scalar_slots_mutex};
+  auto it = g_udf_scalar_slots.find(capsule);
+  if (it == g_udf_scalar_slots.end()) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "unknown or forged scalar-slot capsule");
+    return nullptr;
+  }
+  UdfScalarSlot* slot = it->second.get();
+  void* pointer = PyCapsule_GetPointer(capsule, kUdfScalarSlotCapsuleName);
+  if (pointer == nullptr) {
+    return nullptr;
+  }
+  auto generation = reinterpret_cast<uintptr_t>(PyCapsule_GetContext(capsule));
+  if (PyErr_Occurred()) {
+    return nullptr;
+  }
+  if (pointer != slot || generation != slot->generation ||
+      slot->magic != kUdfScalarSlotMagic || slot->generation == 0) {
+    PyErr_SetString(PyExc_RuntimeError, "invalid scalar-slot generation");
+    return nullptr;
+  }
+  if (slot->owner_pid != udfScalarSlotProcessId()) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "scalar-slot capsule belongs to another process");
+    return nullptr;
+  }
+  return slot;
+}
+
+bool requireLiveUdfScalarSlot(UdfScalarSlot* slot) {
+  if (slot->released) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "scalar-slot capsule has been released");
+    return false;
+  }
+  return true;
+}
+
+bool requireBorrowedUdfScalarSlot(UdfScalarSlot* slot) {
+  if (!requireLiveUdfScalarSlot(slot)) {
+    return false;
+  }
+  if (!slot->borrowed) {
+    PyErr_SetString(PyExc_RuntimeError, "scalar-slot capsule is not borrowed");
+    return false;
+  }
+  return true;
+}
+
+bool requireInitializedUdfScalarSlot(UdfScalarSlot* slot) {
+  if (!requireBorrowedUdfScalarSlot(slot)) {
+    return false;
+  }
+  if (!slot->initialized) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "scalar-slot capsule has no value for this borrow");
+    return false;
+  }
+  return true;
+}
+
+bool requireUdfScalarType(UdfScalarSlot* slot, UdfScalarType expected) {
+  if (slot->type != expected) {
+    PyErr_SetString(PyExc_TypeError, "scalar-slot type mismatch");
+    return false;
+  }
+  return true;
+}
+
+bool requireNonNullUdfScalarSlot(UdfScalarSlot* slot) {
+  if (slot->is_null) {
+    PyErr_SetString(PyExc_TypeError, "scalar-slot value is null");
+    return false;
+  }
+  return true;
+}
+
+bool parseUdfScalarType(const char* name, UdfScalarType* result) {
+  if (std::strcmp(name, "bool") == 0) {
+    *result = UdfScalarType::kBool;
+  } else if (std::strcmp(name, "int32") == 0) {
+    *result = UdfScalarType::kI32;
+  } else if (std::strcmp(name, "int64") == 0) {
+    *result = UdfScalarType::kI64;
+  } else if (std::strcmp(name, "float32") == 0) {
+    *result = UdfScalarType::kF32;
+  } else if (std::strcmp(name, "float64") == 0) {
+    *result = UdfScalarType::kF64;
+  } else {
+    PyErr_SetString(PyExc_ValueError, "unsupported scalar-slot type");
+    return false;
+  }
+  return true;
+}
+
+bool setUdfScalarValue(
+    UdfScalarSlot* slot,
+    PyObject* value,
+    UdfScalarType expected) {
+  if (!requireBorrowedUdfScalarSlot(slot) ||
+      !requireUdfScalarType(slot, expected)) {
+    return false;
+  }
+  if (value == Py_None) {
+    if (!slot->nullable) {
+      PyErr_SetString(PyExc_TypeError, "non-nullable scalar slot rejects None");
+      return false;
+    }
+    slot->initialized = true;
+    slot->is_null = true;
+    slot->value = {};
+    return true;
+  }
+
+  switch (expected) {
+    case UdfScalarType::kBool:
+      if (!PyBool_Check(value)) {
+        PyErr_SetString(
+            PyExc_TypeError, "bool scalar-slot value must be an exact bool");
+        return false;
+      }
+      slot->value.boolean = value == Py_True;
+      break;
+    case UdfScalarType::kI32:
+    case UdfScalarType::kI64: {
+      if (!PyLong_CheckExact(value)) {
+        PyErr_SetString(
+            PyExc_TypeError, "integer scalar-slot value must be an exact int");
+        return false;
+      }
+      long long converted = PyLong_AsLongLong(value);
+      if (converted == -1 && PyErr_Occurred()) {
+        return false;
+      }
+      if (expected == UdfScalarType::kI32) {
+        if (converted < std::numeric_limits<int32_t>::min() ||
+            converted > std::numeric_limits<int32_t>::max()) {
+          PyErr_SetString(
+              PyExc_OverflowError, "int32 scalar value out of range");
+          return false;
+        }
+        slot->value.i32 = static_cast<int32_t>(converted);
+      } else {
+        slot->value.i64 = static_cast<int64_t>(converted);
+      }
+      break;
+    }
+    case UdfScalarType::kF32:
+    case UdfScalarType::kF64: {
+      if (!PyFloat_CheckExact(value)) {
+        PyErr_SetString(
+            PyExc_TypeError,
+            "floating scalar-slot value must be an exact float");
+        return false;
+      }
+      double converted = PyFloat_AS_DOUBLE(value);
+      if (expected == UdfScalarType::kF32) {
+        if (std::isfinite(converted) &&
+            std::fabs(converted) > std::numeric_limits<float>::max()) {
+          PyErr_SetString(
+              PyExc_OverflowError, "float32 scalar value out of range");
+          return false;
+        }
+        slot->value.f32 = static_cast<float>(converted);
+      } else {
+        slot->value.f64 = converted;
+      }
+      break;
+    }
+  }
+  slot->initialized = true;
+  slot->is_null = false;
+  return true;
+}
+
+template <typename Result, typename Reader>
+Result readUdfScalarUnchecked(
+    PyObject* capsule,
+    UdfScalarType expected,
+    Reader reader) {
+  std::lock_guard<std::mutex> lock{g_udf_scalar_slots_mutex};
+  auto it = g_udf_scalar_slots.find(capsule);
+  JIT_CHECK(it != g_udf_scalar_slots.end(), "guarded scalar slot disappeared");
+  const UdfScalarSlot* slot = it->second.get();
+  std::lock_guard<std::mutex> slot_lock{slot->mutex};
+  JIT_CHECK(
+      slot->magic == kUdfScalarSlotMagic && !slot->released && slot->borrowed &&
+          slot->initialized && !slot->is_null && slot->type == expected &&
+          slot->owner_pid == udfScalarSlotProcessId(),
+      "guarded scalar slot became invalid before data load");
+  return reader(slot->value);
+}
+
+template <typename Value, typename Writer>
+void storeUdfScalarUnchecked(
+    PyObject* capsule,
+    UdfScalarType expected,
+    Value value,
+    Writer writer) {
+  std::lock_guard<std::mutex> lock{g_udf_scalar_slots_mutex};
+  auto it = g_udf_scalar_slots.find(capsule);
+  JIT_CHECK(it != g_udf_scalar_slots.end(), "guarded scalar slot disappeared");
+  UdfScalarSlot* slot = it->second.get();
+  std::lock_guard<std::mutex> slot_lock{slot->mutex};
+  JIT_CHECK(
+      slot->magic == kUdfScalarSlotMagic && !slot->released && slot->borrowed &&
+          slot->type == expected && slot->owner_pid == udfScalarSlotProcessId(),
+      "guarded scalar slot became invalid before data store");
+  writer(slot->value, value);
+  slot->initialized = true;
+  slot->is_null = false;
+}
