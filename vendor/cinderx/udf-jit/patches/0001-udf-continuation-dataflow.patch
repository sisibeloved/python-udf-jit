+int64_t JITRT_UnicodeCountProperty(PyObject* text, int64_t property) {
+  JIT_DCHECK(
+      PyUnicode_CheckExact(text), "UnicodeCountProperty requires an exact str");
+  JIT_DCHECK(
+      isValidUnicodeProperty(property),
+      "UnicodeCountProperty received an invalid property id");
+  switch (static_cast<UdfUnicodeProperty>(property)) {
+    case UdfUnicodeProperty::kAlnum:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISALNUM(ch); });
+    case UdfUnicodeProperty::kAlpha:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISALPHA(ch); });
+    case UdfUnicodeProperty::kDecimal:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISDECIMAL(ch); });
+    case UdfUnicodeProperty::kDigit:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISDIGIT(ch); });
+    case UdfUnicodeProperty::kNumeric:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISNUMERIC(ch); });
+    case UdfUnicodeProperty::kSpace:
+      return countUnicodeProperty(
+          text, [](Py_UCS4 ch) { return Py_UNICODE_ISSPACE(ch); });
+  }
+  JIT_ABORT("unreachable Unicode property id {}", property);
+}
