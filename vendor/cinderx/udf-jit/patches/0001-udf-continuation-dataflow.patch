+bool isExactPyCFunction(Register* callable, PyCFunction expected) {
+  Type callable_type = callable->type();
+  if (!callable_type.hasObjectSpec()) {
+    return false;
+  }
+  PyObject* callable_obj = callable_type.objectSpec();
+  if (Py_TYPE(callable_obj) != &PyCFunction_Type) {
+    return false;
+  }
+  auto* function = reinterpret_cast<PyCFunctionObject*>(callable_obj);
+  return function->m_ml->ml_meth == expected;
+}
+
+bool isExactUdfScalarHelper(Register* callable, PyCFunction expected) {
+  return isExactPyCFunction(callable, expected);
+}
+
+bool getExactLongConstant(Register* value, long* result) {
+  Type type = value->type();
+  if (!type.hasObjectSpec() || !PyLong_CheckExact(type.objectSpec())) {
+    return false;
+  }
+  int overflow = 0;
+  *result = PyLong_AsLongAndOverflow(type.objectSpec(), &overflow);
+  if (overflow != 0) {
+    PyErr_Clear();
+    return false;
+  }
+  return true;
+}
+
+PyObject* getExactUnicodeConstant(Register* value) {
+  Type type = value->type();
+  if (!type.hasObjectSpec() || !PyUnicode_CheckExact(type.objectSpec())) {
+    return nullptr;
+  }
+  return type.objectSpec();
+}
+
+Register* trySimplifyUdfUnicodeMapSequence(
+    Env& env,
+    const VectorCall* instr) {
+  if (instr->frameState() == nullptr || instr->flags() != CallFlags::None ||
+      instr->numArgs() != 3 ||
+      !isExactPyCFunction(
+          instr->func(),
+          reinterpret_cast<PyCFunction>(JITRT_UdfUnicodeMapSequence))) {
+    return nullptr;
+  }
+  PyObject* keys = getExactUnicodeConstant(instr->arg(1));
+  PyObject* values = getExactUnicodeConstant(instr->arg(2));
+  if (keys == nullptr || values == nullptr ||
+      !JITRT_IsValidUnicodeMapDescriptor(keys, values)) {
+    return nullptr;
+  }
+
+  env.emit<UseType>(instr->func(), instr->func()->type());
+  env.emit<UseType>(instr->arg(1), instr->arg(1)->type());
+  env.emit<UseType>(instr->arg(2), instr->arg(2)->type());
+  Register* text =
+      env.emit<GuardType>(TUnicodeExact, instr->arg(0), *instr->frameState());
+  env.emit<UseType>(text, TUnicodeExact);
+  return env.emit<UnicodeMapSequence>(
+      text,
+      instr->arg(1),
+      instr->arg(2),
+      *instr->frameState());
+}
+
+Register* trySimplifyUdfUnicodeFsmSequence(
+    Env& env,
+    const VectorCall* instr) {
+  if (instr->frameState() == nullptr || instr->flags() != CallFlags::None ||
+      instr->numArgs() != 4 ||
+      !isExactPyCFunction(
+          instr->func(),
+          reinterpret_cast<PyCFunction>(JITRT_UdfUnicodeFsmSequence))) {
+    return nullptr;
+  }
+  long property = 0;
+  long initial_state = 0;
+  PyObject* descriptor = getExactUnicodeConstant(instr->arg(3));
+  if (!getExactLongConstant(instr->arg(1), &property) ||
+      !getExactLongConstant(instr->arg(2), &initial_state) ||
+      descriptor == nullptr ||
+      !JITRT_IsValidUnicodeFsmDescriptor(
+          property,
+          initial_state,
+          descriptor)) {
+    return nullptr;
+  }
+
+  env.emit<UseType>(instr->func(), instr->func()->type());
+  for (std::size_t index = 1; index < instr->numArgs(); index++) {
+    env.emit<UseType>(instr->arg(index), instr->arg(index)->type());
+  }
+  Register* text =
+      env.emit<GuardType>(TUnicodeExact, instr->arg(0), *instr->frameState());
+  env.emit<UseType>(text, TUnicodeExact);
+  Register* property_id =
+      env.emit<LoadConst>(Type::fromCInt(property, TCInt64));
+  Register* initial_state_id =
+      env.emit<LoadConst>(Type::fromCInt(initial_state, TCInt64));
+  return env.emit<UnicodeFsmSequence>(
+      text,
+      property_id,
+      initial_state_id,
+      instr->arg(3),
+      *instr->frameState());
+}
+
+Register* trySimplifyUdfUnicodeCountProperty(
+    Env& env,
+    const VectorCall* instr) {
+  if (instr->frameState() == nullptr || instr->flags() != CallFlags::None ||
+      instr->numArgs() != 2 ||
+      !isExactPyCFunction(
+          instr->func(),
+          reinterpret_cast<PyCFunction>(JITRT_UdfUnicodeCountProperty))) {
+    return nullptr;
+  }
+
+  Type property_type = instr->arg(1)->type();
+  if (!property_type.hasObjectSpec() ||
+      !PyLong_CheckExact(property_type.objectSpec())) {
+    return nullptr;
+  }
+  int overflow = 0;
+  const long property =
+      PyLong_AsLongAndOverflow(property_type.objectSpec(), &overflow);
+  if (overflow != 0) {
+    PyErr_Clear();
+    return nullptr;
+  }
+  if (property < kUdfUnicodePropertyMin || property > kUdfUnicodePropertyMax) {
+    return nullptr;
+  }
+
+  // Preserve the exact helper/global and constant-property assumptions that
+  // justified replacing the Python call.
+  env.emit<UseType>(instr->func(), instr->func()->type());
+  env.emit<UseType>(instr->arg(1), property_type);
+  Register* text =
+      env.emit<GuardType>(TUnicodeExact, instr->arg(0), *instr->frameState());
+  env.emit<UseType>(text, TUnicodeExact);
+  Register* property_id =
+      env.emit<LoadConst>(Type::fromCInt(property, TCInt64));
+  Register* count = env.emit<UnicodeCountProperty>(text, property_id);
+  return env.emit<PrimitiveBox>(count, TCInt64, *instr->frameState());
+}
+
+const VectorCall* guardedUdfScalarProducer(Register* value) {
+  while (value->instr()->IsAssign() || value->instr()->IsCheckExc()) {
+    value = value->instr()->GetOperand(0);
+  }
+  if (!value->instr()->IsVectorCall()) {
+    return nullptr;
+  }
+  return static_cast<const VectorCall*>(value->instr());
+}
+
+bool isAdjacentUdfGuardChain(const VectorCall* guard, const VectorCall* load) {
+  if (guard->block() != load->block()) {
+    return false;
+  }
+
+  Register* guarded_value = guard->output();
+  bool after_guard = false;
+  for (const Instr& candidate : *guard->block()) {
+    if (&candidate == guard) {
+      after_guard = true;
+      continue;
+    }
+    if (!after_guard) {
+      continue;
+    }
+    if (&candidate == load) {
+      return guarded_value == load->arg(0);
+    }
+    if (candidate.IsUseType() || candidate.IsSnapshot() ||
+        candidate.IsUpdatePrevInstr()) {
+      continue;
+    }
+    if ((candidate.IsAssign() || candidate.IsCheckExc()) &&
+        candidate.GetOperand(0) == guarded_value) {
+      guarded_value = candidate.output();
+      continue;
+    }
+    // Snapshot and UpdatePrevInstr only preserve deoptimization/bytecode
+    // metadata and cannot execute Python or mutate the slot. Calls, branches,
+    // and any other instruction may end the borrow, mutate the slot, or move
+    // the load across an unmodelled effect.
+    return false;
+  }
+  return false;
+}
+
+bool isGuardedUdfScalarCall(const VectorCall* instr) {
+  const VectorCall* guard_call = guardedUdfScalarProducer(instr->arg(0));
+  return guard_call != nullptr && guard_call->flags() == CallFlags::None &&
+      guard_call->numArgs() == 1 &&
+      isExactUdfScalarHelper(
+             guard_call->func(),
+             reinterpret_cast<PyCFunction>(JITRT_UdfGuardDataHandle)) &&
+      isAdjacentUdfGuardChain(guard_call, instr);
+}
+
+void preserveUdfScalarHelperIdentities(Env& env, const VectorCall* instr) {
+  const VectorCall* guard_call = guardedUdfScalarProducer(instr->arg(0));
+  JIT_CHECK(guard_call != nullptr, "missing guarded scalar producer");
+  env.emit<UseType>(guard_call->func(), guard_call->func()->type());
+  env.emit<UseType>(instr->func(), instr->func()->type());
+}
