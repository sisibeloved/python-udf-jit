+    case UdfContinuationReject::kMaterializationFailed:
+      return "materialization_failed";
+    case UdfContinuationReject::kValueKindMismatch:
+      return "value_kind_mismatch";
+    case UdfContinuationReject::kValueTypeMismatch:
+      return "value_type_mismatch";
+    case UdfContinuationReject::kFrameMetadataMissing:
+      return "frame_metadata_missing";
+    case UdfContinuationReject::kCrossCodeDeopt:
+      return "cross_code_deopt";
