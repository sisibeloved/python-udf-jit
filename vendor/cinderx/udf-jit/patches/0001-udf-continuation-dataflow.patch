@@ -0,0 +1,266 @@
+"""Tests for typed, nullable, guarded scalar-slot CinderX intrinsics."""
+
+import math
+import os
+import struct
+import unittest
+
+import cinderx.jit
+
+try:
+    from cinderjit import (
+        _udf_begin_scalar_slot_borrow,
+        _udf_create_scalar_slot,
+        _udf_data_is_null,
+        _udf_data_load_bool,
+        _udf_data_load_f32,
+        _udf_data_load_f64,
+        _udf_data_load_i32,
+        _udf_data_load_i64,
+        _udf_data_store_bool,
+        _udf_data_store_f32,
+        _udf_data_store_f64,
+        _udf_data_store_i32,
+        _udf_data_store_i64,
+        _udf_data_store_null,
+        _udf_end_scalar_slot_borrow,
+        _udf_guard_data_handle,
+        _udf_release_scalar_slot,
+        _udf_set_scalar_slot,
+    )
+except ImportError:
+    _udf_create_scalar_slot = None
+
+
+def copy_bool(source, target):
+    value = _udf_data_load_bool(_udf_guard_data_handle(source))
+    result = not value
+    return _udf_data_store_bool(_udf_guard_data_handle(target), result)
+
+
+def copy_i32(source, target):
+    value = _udf_data_load_i32(_udf_guard_data_handle(source))
+    result = value + 1 if value >= 0 else value - 1
+    return _udf_data_store_i32(_udf_guard_data_handle(target), result)
+
+
+def copy_i64(source, target):
+    value = _udf_data_load_i64(_udf_guard_data_handle(source))
+    result = value + 1 if value >= 0 else value - 1
+    return _udf_data_store_i64(_udf_guard_data_handle(target), result)
+
+
+def copy_f32(source, target):
+    value = _udf_data_load_f32(_udf_guard_data_handle(source))
+    result = value * 2.0 - 1.0
+    return _udf_data_store_f32(_udf_guard_data_handle(target), result)
+
+
+def copy_f64(source, target):
+    value = _udf_data_load_f64(_udf_guard_data_handle(source))
+    result = value * 2.0 - 1.0
+    return _udf_data_store_f64(_udf_guard_data_handle(target), result)
+
+
+def copy_nullable_i64(source, target):
+    if _udf_data_is_null(_udf_guard_data_handle(source)):
+        return _udf_data_store_null(_udf_guard_data_handle(target))
+    value = _udf_data_load_i64(_udf_guard_data_handle(source))
+    return _udf_data_store_i64(_udf_guard_data_handle(target), value)
+
+
+@unittest.skipUnless(
+    cinderx.jit.is_enabled() and _udf_create_scalar_slot is not None,
+    "requires CinderX JIT scalar-slot helpers",
+)
+class UdfDataIntrinsicTests(unittest.TestCase):
+    def make_slot(self, scalar_type, nullable=False):
+        slot = _udf_create_scalar_slot(scalar_type, nullable)
+        self.addCleanup(self.release_slot, slot)
+        return slot
+
+    @staticmethod
+    def release_slot(slot):
+        try:
+            _udf_end_scalar_slot_borrow(slot)
+        except RuntimeError:
+            pass
+        _udf_release_scalar_slot(slot)
+
+    def test_interpreter_type_matrix_boundaries_and_lifecycle(self):
+        cases = (
+            ("bool", _udf_data_load_bool, (False, True)),
+            ("int32", _udf_data_load_i32, (-(2**31), 0, 2**31 - 1)),
+            ("int64", _udf_data_load_i64, (-(2**63), 0, 2**63 - 1)),
+            ("float32", _udf_data_load_f32, (-0.0, 1.25, float("inf"))),
+            ("float64", _udf_data_load_f64, (-0.0, 1.25, float("inf"))),
+        )
+        for scalar_type, load, values in cases:
+            with self.subTest(scalar_type=scalar_type):
+                slot = self.make_slot(scalar_type)
+                with self.assertRaises(RuntimeError):
+                    _udf_guard_data_handle(slot)
+                _udf_begin_scalar_slot_borrow(slot)
+                # Guarding an uninitialized output slot is valid; reading it is not.
+                guarded = _udf_guard_data_handle(slot)
+                with self.assertRaises(RuntimeError):
+                    load(guarded)
+                for value in values:
+                    _udf_set_scalar_slot(slot, value)
+                    result = load(_udf_guard_data_handle(slot))
+                    if scalar_type == "float32":
+                        expected = struct.unpack("f", struct.pack("f", value))[0]
+                    else:
+                        expected = value
+                    self.assertEqual(result, expected)
+                    if isinstance(expected, float) and expected == 0.0:
+                        self.assertEqual(
+                            math.copysign(1.0, result),
+                            math.copysign(1.0, expected),
+                        )
+                _udf_end_scalar_slot_borrow(slot)
+                _udf_begin_scalar_slot_borrow(slot)
+                with self.assertRaises(RuntimeError):
+                    load(_udf_guard_data_handle(slot))
+
+    def test_type_nullability_and_range_are_exact(self):
+        i32 = self.make_slot("int32")
+        _udf_begin_scalar_slot_borrow(i32)
+        for invalid in (True, 1.0, None):
+            with self.subTest(invalid=invalid):
+                with self.assertRaises(TypeError):
+                    _udf_set_scalar_slot(i32, invalid)
+        for invalid in (-(2**31) - 1, 2**31):
+            with self.subTest(invalid=invalid):
+                with self.assertRaises(OverflowError):
+                    _udf_set_scalar_slot(i32, invalid)
+
+        f32 = self.make_slot("float32")
+        _udf_begin_scalar_slot_borrow(f32)
+        with self.assertRaises(TypeError):
+            _udf_set_scalar_slot(f32, 1)
+        with self.assertRaises(OverflowError):
+            _udf_set_scalar_slot(f32, 3.5e38)
+
+        nullable = self.make_slot("int64", True)
+        _udf_begin_scalar_slot_borrow(nullable)
+        _udf_set_scalar_slot(nullable, None)
+        guarded = _udf_guard_data_handle(nullable)
+        self.assertTrue(_udf_data_is_null(guarded))
+        with self.assertRaises(TypeError):
+            _udf_data_load_i64(guarded)
+
+        with self.assertRaises(ValueError):
+            _udf_create_scalar_slot("uint64", False)
+
+    def test_store_matrix_initializes_output_and_rejects_wrong_type(self):
+        cases = (
+            ("bool", _udf_data_store_bool, _udf_data_load_bool, True),
+            ("int32", _udf_data_store_i32, _udf_data_load_i32, 17),
+            ("int64", _udf_data_store_i64, _udf_data_load_i64, 2**40),
+            ("float32", _udf_data_store_f32, _udf_data_load_f32, 1.25),
+            ("float64", _udf_data_store_f64, _udf_data_load_f64, 2.5),
+        )
+        for scalar_type, store, load, value in cases:
+            with self.subTest(scalar_type=scalar_type):
+                slot = self.make_slot(scalar_type)
+                _udf_begin_scalar_slot_borrow(slot)
+                guarded = _udf_guard_data_handle(slot)
+                self.assertEqual(store(guarded, value), value)
+                self.assertEqual(load(_udf_guard_data_handle(slot)), value)
+
+        i64 = self.make_slot("int64")
+        _udf_begin_scalar_slot_borrow(i64)
+        with self.assertRaises(TypeError):
+            _udf_data_store_i32(i64, 1)
+        with self.assertRaises(TypeError):
+            _udf_data_store_null(i64)
+
+        nullable = self.make_slot("float64", True)
+        _udf_begin_scalar_slot_borrow(nullable)
+        self.assertIsNone(_udf_data_store_null(_udf_guard_data_handle(nullable)))
+        self.assertTrue(_udf_data_is_null(_udf_guard_data_handle(nullable)))
+
+    def test_release_is_idempotent_and_rejects_forged_or_cross_process(self):
+        slot = self.make_slot("float64")
+        _udf_begin_scalar_slot_borrow(slot)
+        with self.assertRaises(RuntimeError):
+            _udf_release_scalar_slot(slot)
+        _udf_end_scalar_slot_borrow(slot)
+        _udf_release_scalar_slot(slot)
+        _udf_release_scalar_slot(slot)
+        with self.assertRaises(RuntimeError):
+            _udf_begin_scalar_slot_borrow(slot)
+        with self.assertRaises(TypeError):
+            _udf_guard_data_handle(object())
+
+        if not hasattr(os, "fork"):
+            return
+        other = self.make_slot("int64")
+        _udf_begin_scalar_slot_borrow(other)
+        pid = os.fork()
+        if pid == 0:
+            try:
+                _udf_guard_data_handle(other)
+            except RuntimeError:
+                os._exit(0)
+            os._exit(1)
+        _, status = os.waitpid(pid, 0)
+        self.assertEqual(os.waitstatus_to_exitcode(status), 0)
+
+    def test_jit_load_store_matrix_and_branches(self):
+        cases = (
+            ("bool", copy_bool, "LoadUdfDataBool", "StoreUdfDataBool", True, False),
+            ("int32", copy_i32, "LoadUdfDataI32", "StoreUdfDataI32", 7, 8),
+            ("int64", copy_i64, "LoadUdfDataI64", "StoreUdfDataI64", -7, -8),
+            ("float32", copy_f32, "LoadUdfDataF32", "StoreUdfDataF32", 2.0, 3.0),
+            ("float64", copy_f64, "LoadUdfDataF64", "StoreUdfDataF64", 2.0, 3.0),
+        )
+        for scalar_type, function, load_op, store_op, value, expected in cases:
+            with self.subTest(scalar_type=scalar_type):
+                self.assertTrue(cinderx.jit.force_compile(function))
+                counts = cinderx.jit.get_function_hir_opcode_counts(function)
+                self.assertEqual(counts.get(load_op, 0), 1, counts)
+                self.assertEqual(counts.get(store_op, 0), 1, counts)
+                source = self.make_slot(scalar_type)
+                target = self.make_slot(scalar_type)
+                _udf_begin_scalar_slot_borrow(source)
+                _udf_begin_scalar_slot_borrow(target)
+                _udf_set_scalar_slot(source, value)
+                self.assertEqual(function(source, target), expected)
+                loads = {
+                    "bool": _udf_data_load_bool,
+                    "int32": _udf_data_load_i32,
+                    "int64": _udf_data_load_i64,
+                    "float32": _udf_data_load_f32,
+                    "float64": _udf_data_load_f64,
+                }
+                self.assertEqual(
+                    loads[scalar_type](_udf_guard_data_handle(target)),
+                    expected,
+                )
+
+    def test_jit_nullable_branch_has_null_and_value_paths(self):
+        self.assertTrue(cinderx.jit.force_compile(copy_nullable_i64))
+        counts = cinderx.jit.get_function_hir_opcode_counts(copy_nullable_i64)
+        self.assertEqual(counts.get("IsUdfDataNull", 0), 1, counts)
+        self.assertEqual(counts.get("LoadUdfDataI64", 0), 1, counts)
+        self.assertEqual(counts.get("StoreUdfDataI64", 0), 1, counts)
+        self.assertEqual(counts.get("StoreUdfDataNull", 0), 1, counts)
+
+        for value in (None, 41):
+            with self.subTest(value=value):
+                source = self.make_slot("int64", True)
+                target = self.make_slot("int64", True)
+                _udf_begin_scalar_slot_borrow(source)
+                _udf_begin_scalar_slot_borrow(target)
+                _udf_set_scalar_slot(source, value)
+                copy_nullable_i64(source, target)
+                guarded = _udf_guard_data_handle(target)
+                self.assertEqual(_udf_data_is_null(guarded), value is None)
+                if value is not None:
+                    self.assertEqual(_udf_data_load_i64(guarded), value)
+
+
+if __name__ == "__main__":
+    unittest.main()
