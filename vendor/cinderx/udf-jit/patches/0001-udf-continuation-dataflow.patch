+PyObject* JITRT_UdfCreateScalarSlot(PyObject*, PyObject* args) {
+  const char* type_name;
+  int nullable;
+  if (!PyArg_ParseTuple(
+          args, "sp:_udf_create_scalar_slot", &type_name, &nullable)) {
+    return nullptr;
+  }
+  UdfScalarType scalar_type;
+  if (!parseUdfScalarType(type_name, &scalar_type)) {
+    return nullptr;
+  }
+  auto slot = std::make_unique<UdfScalarSlot>();
+  slot->owner_pid = udfScalarSlotProcessId();
+  slot->type = scalar_type;
+  slot->nullable = nullable != 0;
+  slot->generation =
+      g_udf_scalar_slot_generation.fetch_add(1, std::memory_order_relaxed);
+  if (slot->generation == 0) {
+    slot->generation =
+        g_udf_scalar_slot_generation.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  PyObject* capsule = PyCapsule_New(
+      slot.get(), kUdfScalarSlotCapsuleName, udfScalarSlotCapsuleDestructor);
+  if (capsule == nullptr) {
+    return nullptr;
+  }
+  if (PyCapsule_SetContext(capsule, reinterpret_cast<void*>(slot->generation)) <
+      0) {
+    Py_DECREF(capsule);
+    return nullptr;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock{g_udf_scalar_slots_mutex};
+    g_udf_scalar_slots.emplace(capsule, std::move(slot));
+  }
+  return capsule;
+}
+
+PyObject* JITRT_UdfSetScalarSlot(PyObject*, PyObject* args) {
+  PyObject* capsule;
+  PyObject* value;
+  if (!PyArg_ParseTuple(args, "OO:_udf_set_scalar_slot", &capsule, &value)) {
+    return nullptr;
+  }
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!setUdfScalarValue(slot, value, slot->type)) {
+    return nullptr;
+  }
+  Py_RETURN_NONE;
+}
+
+PyObject* JITRT_UdfBeginScalarSlotBorrow(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!requireLiveUdfScalarSlot(slot)) {
+    return nullptr;
+  }
+  if (slot->borrowed) {
+    PyErr_SetString(
+        PyExc_RuntimeError, "scalar-slot capsule is already borrowed");
+    return nullptr;
+  }
+  slot->borrowed = true;
+  slot->initialized = false;
+  slot->is_null = false;
+  slot->value = {};
+  Py_RETURN_NONE;
+}
+
+PyObject* JITRT_UdfEndScalarSlotBorrow(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!requireLiveUdfScalarSlot(slot)) {
+    return nullptr;
+  }
+  if (!slot->borrowed) {
+    PyErr_SetString(PyExc_RuntimeError, "scalar-slot capsule is not borrowed");
+    return nullptr;
+  }
+  slot->borrowed = false;
+  slot->initialized = false;
+  slot->is_null = false;
+  slot->value = {};
+  Py_RETURN_NONE;
+}
+
+PyObject* JITRT_UdfReleaseScalarSlot(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (slot->released) {
+    Py_RETURN_NONE;
+  }
+  if (slot->borrowed) {
+    PyErr_SetString(
+        PyExc_RuntimeError,
+        "cannot release a scalar slot during an active borrow");
+    return nullptr;
+  }
+  slot->released = true;
+  slot->initialized = false;
+  slot->is_null = false;
+  slot->value = {};
+  Py_RETURN_NONE;
+}
+
+PyObject* JITRT_UdfGuardDataHandle(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!requireBorrowedUdfScalarSlot(slot)) {
+    return nullptr;
+  }
+  Py_INCREF(capsule);
+  return capsule;
+}
+
+PyObject* JITRT_UdfDataIsNull(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock{slot->mutex};
+  if (!requireInitializedUdfScalarSlot(slot)) {
+    return nullptr;
+  }
+  return PyBool_FromLong(slot->is_null);
+}
+
+PyObject* JITRT_UdfDataLoadBool(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> slot_lock{slot->mutex};
+  if (!requireInitializedUdfScalarSlot(slot) ||
+      !requireNonNullUdfScalarSlot(slot) ||
+      !requireUdfScalarType(slot, UdfScalarType::kBool)) {
+    return nullptr;
+  }
+  return PyBool_FromLong(slot->value.boolean);
+}
+
+PyObject* JITRT_UdfDataLoadI32(PyObject*, PyObject* capsule) {
+  UdfScalarSlot* slot = checkedUdfScalarSlot(capsule);
+  if (slot == nullptr) {
+    return nullptr;
