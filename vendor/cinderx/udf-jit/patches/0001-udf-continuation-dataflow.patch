+TEST_F(UdfDataIntrinsicTest, ExactGuardedOperationsProduceTypedHIR) {
+  runStockCode(R"(
+import cinderx.jit as jit
+from cinderjit import (
+    _udf_begin_scalar_slot_borrow,
+    _udf_create_scalar_slot,
+    _udf_data_is_null,
+    _udf_data_load_bool,
+    _udf_data_load_f32,
+    _udf_data_load_f64,
+    _udf_data_load_i32,
+    _udf_data_load_i64,
+    _udf_data_store_bool,
+    _udf_data_store_f32,
+    _udf_data_store_f64,
+    _udf_data_store_i32,
+    _udf_data_store_i64,
+    _udf_data_store_null,
+    _udf_end_scalar_slot_borrow,
+    _udf_guard_data_handle,
+    _udf_release_scalar_slot,
+    _udf_set_scalar_slot,
+)
+
+def copy_bool(source, target):
+    value = _udf_data_load_bool(_udf_guard_data_handle(source))
+    result = not value
+    return _udf_data_store_bool(_udf_guard_data_handle(target), result)
+
+def copy_i32(source, target):
+    value = _udf_data_load_i32(_udf_guard_data_handle(source))
+    result = value + 1 if value >= 0 else value - 1
+    return _udf_data_store_i32(_udf_guard_data_handle(target), result)
+
+def copy_i64(source, target):
+    value = _udf_data_load_i64(_udf_guard_data_handle(source))
+    result = value + 1 if value >= 0 else value - 1
+    return _udf_data_store_i64(_udf_guard_data_handle(target), result)
+
+def copy_f32(source, target):
+    value = _udf_data_load_f32(_udf_guard_data_handle(source))
+    result = value * 2.0
+    return _udf_data_store_f32(_udf_guard_data_handle(target), result)
+
+def copy_f64(source, target):
+    value = _udf_data_load_f64(_udf_guard_data_handle(source))
+    result = value * 2.0
+    return _udf_data_store_f64(_udf_guard_data_handle(target), result)
+
+def copy_nullable(source, target):
+    if _udf_data_is_null(_udf_guard_data_handle(source)):
+        return _udf_data_store_null(_udf_guard_data_handle(target))
+    value = _udf_data_load_i64(_udf_guard_data_handle(source))
+    return _udf_data_store_i64(_udf_guard_data_handle(target), value)
+
+cases = (
+    ("bool", copy_bool, "LoadUdfDataBool", "StoreUdfDataBool", True, False),
+    ("int32", copy_i32, "LoadUdfDataI32", "StoreUdfDataI32", 7, 8),
+    ("int64", copy_i64, "LoadUdfDataI64", "StoreUdfDataI64", -7, -8),
+    ("float32", copy_f32, "LoadUdfDataF32", "StoreUdfDataF32", 2.0, 4.0),
+    ("float64", copy_f64, "LoadUdfDataF64", "StoreUdfDataF64", 2.0, 4.0),
+)
+loads = {
+    "bool": _udf_data_load_bool,
+    "int32": _udf_data_load_i32,
+    "int64": _udf_data_load_i64,
+    "float32": _udf_data_load_f32,
+    "float64": _udf_data_load_f64,
+}
+for scalar_type, function, load_op, store_op, value, expected in cases:
+    assert jit.force_compile(function)
+    counts = jit.get_function_hir_opcode_counts(function)
+    assert counts.get(load_op, 0) == 1, counts
+    assert counts.get(store_op, 0) == 1, counts
+    source = _udf_create_scalar_slot(scalar_type, False)
+    target = _udf_create_scalar_slot(scalar_type, False)
+    _udf_begin_scalar_slot_borrow(source)
+    _udf_begin_scalar_slot_borrow(target)
+    _udf_set_scalar_slot(source, value)
+    assert function(source, target) == expected
+    assert loads[scalar_type](_udf_guard_data_handle(target)) == expected
+    _udf_end_scalar_slot_borrow(source)
+    _udf_end_scalar_slot_borrow(target)
+    _udf_release_scalar_slot(source)
+    _udf_release_scalar_slot(target)
+
+assert jit.force_compile(copy_nullable)
+counts = jit.get_function_hir_opcode_counts(copy_nullable)
+assert counts.get("IsUdfDataNull", 0) == 1, counts
+assert counts.get("LoadUdfDataI64", 0) == 1, counts
+assert counts.get("StoreUdfDataI64", 0) == 1, counts
+assert counts.get("StoreUdfDataNull", 0) == 1, counts
+for value in (None, 41):
+    source = _udf_create_scalar_slot("int64", True)
+    target = _udf_create_scalar_slot("int64", True)
+    _udf_begin_scalar_slot_borrow(source)
+    _udf_begin_scalar_slot_borrow(target)
+    _udf_set_scalar_slot(source, value)
+    copy_nullable(source, target)
+    guarded = _udf_guard_data_handle(target)
+    assert _udf_data_is_null(guarded) is (value is None)
+    if value is not None:
+        assert _udf_data_load_i64(guarded) == value
+    _udf_end_scalar_slot_borrow(source)
+    _udf_end_scalar_slot_borrow(target)
+    _udf_release_scalar_slot(source)
+    _udf_release_scalar_slot(target)
+
+def passthrough(value):
+    return value
+
+def wrong_guard(slot):
+    return _udf_data_load_f64(passthrough(slot))
+
+def wrong_load(slot):
+    def fake_load(value):
+        return _udf_data_load_f64(value)
+    return fake_load(_udf_guard_data_handle(slot))
+
+assert jit.force_compile(wrong_guard)
+assert jit.force_compile(wrong_load)
+assert jit.get_function_hir_opcode_counts(wrong_guard).get("LoadUdfDataF64", 0) == 0
+assert jit.get_function_hir_opcode_counts(wrong_load).get("LoadUdfDataF64", 0) == 0
+)");
+}
+
+TEST_F(UdfDataIntrinsicTest, HIRMetadataMatchesTypedReadAndWrite) {
+  auto function = jit::hir::HIRParser{}.ParseHIR(R"(
+fun test {
+  bb 0 {
+    v0 = LoadArg<0>
+    v1 = LoadUdfDataI64 v0
+    StoreUdfDataI64 v0 v1
+    v2 = PrimitiveBox<CInt64> v1 {
+      FrameState {
+        CurInstrOffset 0
+      }
+    }
+    Return v2
+  }
+}
+)");
+  ASSERT_NE(function, nullptr);
+
+  const jit::hir::Instr* load = nullptr;
+  const jit::hir::Instr* store = nullptr;
+  for (const auto& block : function->cfg.blocks) {
+    for (const auto& instr : block) {
+      if (instr.IsLoadUdfDataI64()) {
+        load = &instr;
+      } else if (instr.IsStoreUdfDataI64()) {
+        store = &instr;
+      }
+    }
+  }
+
+  ASSERT_NE(load, nullptr);
+  ASSERT_NE(store, nullptr);
+  EXPECT_EQ(jit::hir::outputType(*load), jit::hir::TCInt64);
+  EXPECT_TRUE(load->isReplayable());
+  EXPECT_FALSE(jit::hir::isPassthrough(*load));
+  EXPECT_FALSE(jit::hir::hasArbitraryExecution(*load));
+  EXPECT_EQ(jit::hir::memoryEffects(*load).may_store, jit::hir::AEmpty);
+  EXPECT_FALSE(store->isReplayable());
+  EXPECT_FALSE(jit::hir::hasArbitraryExecution(*store));
+  EXPECT_EQ(jit::hir::memoryEffects(*store).may_store, jit::hir::AOther);
+}
+
+TEST_F(UdfDataIntrinsicTest, LIRCallsTypedLoadAndStoreHelpers) {
+  auto function = jit::hir::HIRParser{}.ParseHIR(R"(
+fun test {
+  bb 0 {
+    v0 = LoadArg<0>
+    v1 = LoadUdfDataI64 v0
+    StoreUdfDataI64 v0 v1
+    v2 = PrimitiveBox<CInt64> v1 {
+      FrameState {
+        CurInstrOffset 0
+      }
+    }
+    Return v2
+  }
+}
+)");
+  ASSERT_NE(function, nullptr);
+
+  jit::Compiler::runPasses(
+      *function,
+      static_cast<jit::PassConfig>(
+          jit::PassConfig::kAllExceptInliner &
+          ~jit::PassConfig::kInsertUpdatePrevInstr));
+
+  jit::codegen::Environ env;
+  env.ctx = jit::getContext();
+  jit::CodeRuntime code_runtime{
+      function->code, function->builtins, function->globals};
+  env.code_rt = &code_runtime;
+
+  jit::lir::LIRGenerator generator{function.get(), &env};
+  auto lir = generator.TranslateFunction();
+  lir->sortBasicBlocks();
+  std::stringstream stream;
+  stream << *lir;
+  const std::string text = stream.str();
+
+  EXPECT_NE(
+      text.find(fmt::format(
+          "{}", reinterpret_cast<uint64_t>(JITRT_LoadUdfDataI64Unchecked))),
+      std::string::npos)
+      << text;
+  EXPECT_NE(
+      text.find(fmt::format(
+          "{}", reinterpret_cast<uint64_t>(JITRT_StoreUdfDataI64Unchecked))),
+      std::string::npos)
+      << text;
+}
diff --git a/cinderx/RuntimeTests/udf_descriptor_fuzz_test.cpp b/cinderx/RuntimeTests/udf_descriptor_fuzz_test.cpp
new file mode 100644
index 00000000..2a4bcda4
--- /dev/null
+++ b/cinderx/RuntimeTests/udf_descriptor_fuzz_test.cpp
@@ -0,0 +1,114 @@
+// Copyright (c) Meta Platforms, Inc. and affiliates.
+
+#include "cinderx/RuntimeTests/fixtures.h"
+
+using UdfDescriptorFuzzTest = RuntimeTest;
+
+TEST_F(UdfDescriptorFuzzTest, DeterministicLifecycleAndTypeMatrix) {
+  runStockCode(R"(
+import random
+
+from cinderjit import (
+    _udf_begin_scalar_slot_borrow,
+    _udf_create_scalar_slot,
+    _udf_data_is_null,
+    _udf_data_load_bool,
+    _udf_data_load_f32,
+    _udf_data_load_f64,
+    _udf_data_load_i32,
+    _udf_data_load_i64,
+    _udf_data_store_bool,
+    _udf_data_store_f32,
+    _udf_data_store_f64,
+    _udf_data_store_i32,
+    _udf_data_store_i64,
+    _udf_data_store_null,
+    _udf_end_scalar_slot_borrow,
+    _udf_guard_data_handle,
+    _udf_release_scalar_slot,
+    _udf_set_scalar_slot,
+)
+
+rng = random.Random(0x554446)
+types = ("bool", "int32", "int64", "float32", "float64")
+loads = {
+    "bool": _udf_data_load_bool,
+    "int32": _udf_data_load_i32,
+    "int64": _udf_data_load_i64,
+    "float32": _udf_data_load_f32,
+    "float64": _udf_data_load_f64,
+}
+stores = {
+    "bool": _udf_data_store_bool,
+    "int32": _udf_data_store_i32,
+    "int64": _udf_data_store_i64,
+    "float32": _udf_data_store_f32,
+    "float64": _udf_data_store_f64,
+}
+values = {
+    "bool": (False, True),
+    "int32": (-(2**31), -1, 0, 1, 2**31 - 1),
+    "int64": (-(2**63), -(2**40), 0, 2**40, 2**63 - 1),
+    "float32": (-3.25, -0.0, 0.0, 1.5, float("inf"), float("-inf")),
+    "float64": (-3.25, -0.0, 0.0, 1.5, float("inf"), float("-inf")),
+}
+
+for iteration in range(500):
+    scalar_type = rng.choice(types)
+    nullable = bool(rng.getrandbits(1))
+    slot = _udf_create_scalar_slot(scalar_type, nullable)
+    _udf_begin_scalar_slot_borrow(slot)
+    guarded = _udf_guard_data_handle(slot)
+
+    if nullable and rng.randrange(4) == 0:
+        if rng.getrandbits(1):
+            _udf_set_scalar_slot(slot, None)
+        else:
+            _udf_data_store_null(guarded)
+        assert _udf_data_is_null(_udf_guard_data_handle(slot))
+        try:
+            loads[scalar_type](_udf_guard_data_handle(slot))
+        except TypeError:
+            pass
+        else:
+            raise AssertionError("null value escaped through a typed load")
+    else:
+        value = rng.choice(values[scalar_type])
+        if rng.getrandbits(1):
+            _udf_set_scalar_slot(slot, value)
+        else:
+            assert stores[scalar_type](guarded, value) == value
+        assert not _udf_data_is_null(_udf_guard_data_handle(slot))
+        loads[scalar_type](_udf_guard_data_handle(slot))
+
+    wrong_type = rng.choice(tuple(item for item in types if item != scalar_type))
+    try:
+        loads[wrong_type](_udf_guard_data_handle(slot))
+    except TypeError:
+        pass
+    else:
+        raise AssertionError("a mismatched typed load unexpectedly succeeded")
+
+    _udf_end_scalar_slot_borrow(slot)
+    for invalid_operation in (
+        lambda: _udf_guard_data_handle(slot),
+        lambda: loads[scalar_type](slot),
+    ):
+        try:
+            invalid_operation()
+        except RuntimeError:
+            pass
+        else:
+            raise AssertionError("ended borrow unexpectedly remained usable")
+    _udf_release_scalar_slot(slot)
+    _udf_release_scalar_slot(slot)
+
+for forged in (object(), None, 1, 1.0, "slot"):
+    try:
+        _udf_guard_data_handle(forged)
+    except TypeError:
+        pass
+    else:
+        raise AssertionError("forged descriptor unexpectedly passed its guard")
+)");
+}
diff --git a/cinderx/RuntimeTests/udf_typed_loop_intrinsic_test.cpp b/cinderx/RuntimeTests/udf_typed_loop_intrinsic_test.cpp
new file mode 100644
index 00000000..adf6a62c
--- /dev/null
+++ b/cinderx/RuntimeTests/udf_typed_loop_intrinsic_test.cpp
@@ -0,0 +1,94 @@
+// Copyright (c) Meta Platforms, Inc. and affiliates.
+
+#include "cinderx/Jit/code_runtime.h"
+#include "cinderx/Jit/codegen/environ.h"
+#include "cinderx/Jit/compiler.h"
+#include "cinderx/Jit/context.h"
+#include "cinderx/Jit/hir/instr_effects.h"
+#include "cinderx/Jit/hir/parser.h"
+#include "cinderx/Jit/hir/pass.h"
+#include "cinderx/Jit/jit_rt.h"
+#include "cinderx/Jit/lir/generator.h"
+#include "cinderx/Jit/lir/printer.h"
+#include "cinderx/RuntimeTests/fixtures.h"
+
+#include <fmt/format.h>
+
+#include <sstream>
+#include <string>
+
+using UdfTypedLoopIntrinsicTest = RuntimeTest;
+
+namespace {
+
+std::unique_ptr<jit::hir::Function> parseUnicodeCountFunction() {
+  return jit::hir::HIRParser{}.ParseHIR(R"(
+fun test {
+  bb 0 {
+    v0 = LoadArg<0>
+    v1 = RefineType<UnicodeExact> v0
+    v2 = LoadConst<CInt64[0]>
+    v3 = UnicodeCountProperty v1 v2
+    v4 = PrimitiveBox<CInt64> v3 {
+      FrameState {
+        CurInstrOffset 0
+      }
+    }
+    Return v4
+  }
+}
+)");
+}
+
+} // namespace
+
+TEST_F(UdfTypedLoopIntrinsicTest, HIRMetadataIsTypedPureAndReplayable) {
+  auto function = parseUnicodeCountFunction();
+  ASSERT_NE(function, nullptr);
+
+  const jit::hir::Instr* count = nullptr;
+  for (const auto& block : function->cfg.blocks) {
+    for (const auto& instr : block) {
+      if (instr.IsUnicodeCountProperty()) {
+        count = &instr;
+      }
+    }
+  }
+
+  ASSERT_NE(count, nullptr);
+  EXPECT_EQ(jit::hir::outputType(*count), jit::hir::TCInt64);
+  EXPECT_TRUE(count->isReplayable());
+  EXPECT_FALSE(jit::hir::isPassthrough(*count));
+  EXPECT_FALSE(jit::hir::hasArbitraryExecution(*count));
+  EXPECT_EQ(jit::hir::memoryEffects(*count).may_store, jit::hir::AEmpty);
+}
+
+TEST_F(UdfTypedLoopIntrinsicTest, LIRCallsUnicodeCountRuntimeHelper) {
+  auto function = parseUnicodeCountFunction();
+  ASSERT_NE(function, nullptr);
+
+  jit::Compiler::runPasses(
+      *function,
+      static_cast<jit::PassConfig>(
+          jit::PassConfig::kAllExceptInliner &
+          ~jit::PassConfig::kInsertUpdatePrevInstr));
+
+  jit::codegen::Environ env;
+  env.ctx = jit::getContext();
+  jit::CodeRuntime code_runtime{
+      function->code, function->builtins, function->globals};
+  env.code_rt = &code_runtime;
+
+  jit::lir::LIRGenerator generator{function.get(), &env};
+  auto lir = generator.TranslateFunction();
+  lir->sortBasicBlocks();
+  std::stringstream stream;
+  stream << *lir;
+  const std::string text = stream.str();
+
+  EXPECT_NE(
+      text.find(fmt::format(
+          "{}", reinterpret_cast<uint64_t>(JITRT_UnicodeCountProperty))),
+      std::string::npos)
+      << text;
+}
diff --git a/cinderx/RuntimeTests/udf_typed_sequence_intrinsic_test.cpp b/cinderx/RuntimeTests/udf_typed_sequence_intrinsic_test.cpp
new file mode 100644
index 00000000..f9e377ab
--- /dev/null
+++ b/cinderx/RuntimeTests/udf_typed_sequence_intrinsic_test.cpp
@@ -0,0 +1,124 @@
+// Copyright (c) Meta Platforms, Inc. and affiliates.
+
+#include "cinderx/Jit/code_runtime.h"
+#include "cinderx/Jit/codegen/environ.h"
+#include "cinderx/Jit/compiler.h"
+#include "cinderx/Jit/context.h"
+#include "cinderx/Jit/hir/instr_effects.h"
+#include "cinderx/Jit/hir/parser.h"
+#include "cinderx/Jit/hir/pass.h"
+#include "cinderx/Jit/jit_rt.h"
+#include "cinderx/Jit/lir/generator.h"
+#include "cinderx/Jit/lir/printer.h"
+#include "cinderx/RuntimeTests/fixtures.h"
+
+#include <fmt/format.h>
+
+#include <sstream>
+#include <string>
+
+using UdfTypedSequenceIntrinsicTest = RuntimeTest;
+
+namespace {
+
+std::unique_ptr<jit::hir::Function> parseUnicodeMapFunction() {
+  return jit::hir::HIRParser{}.ParseHIR(R"(
+fun test {
+  bb 0 {
+    v0 = LoadArg<0>
+    v1 = RefineType<UnicodeExact> v0
+    v2 = LoadArg<1>
+    v3 = RefineType<UnicodeExact> v2
+    v4 = LoadArg<2>
+    v5 = RefineType<UnicodeExact> v4
+    v6 = UnicodeMapSequence v1 v3 v5
+    Return v6
+  }
+}
+)");
+}
+
+std::unique_ptr<jit::hir::Function> parseUnicodeFsmFunction() {
+  return jit::hir::HIRParser{}.ParseHIR(R"(
+fun test {
+  bb 0 {
+    v0 = LoadArg<0>
+    v1 = RefineType<UnicodeExact> v0
+    v2 = LoadConst<CInt64[5]>
+    v3 = LoadConst<CInt64[0]>
+    v4 = LoadArg<1>
+    v5 = RefineType<UnicodeExact> v4
+    v6 = UnicodeFsmSequence v1 v2 v3 v5
+    Return v6
+  }
+}
+)");
+}
+
+const jit::hir::Instr* findSequenceInstruction(
+    const jit::hir::Function& function) {
+  for (const auto& block : function.cfg.blocks) {
+    for (const auto& instr : block) {
+      if (instr.IsUnicodeMapSequence() || instr.IsUnicodeFsmSequence()) {
+        return &instr;
+      }
+    }
+  }
+  return nullptr;
+}
+
+std::string lowerToLir(jit::hir::Function& function) {
+  jit::Compiler::runPasses(
+      function,
+      static_cast<jit::PassConfig>(
+          jit::PassConfig::kAllExceptInliner &
+          ~jit::PassConfig::kInsertUpdatePrevInstr));
+  jit::codegen::Environ env;
+  env.ctx = jit::getContext();
+  jit::CodeRuntime code_runtime{
+      function.code, function.builtins, function.globals};
+  env.code_rt = &code_runtime;
+  jit::lir::LIRGenerator generator{&function, &env};
+  auto lir = generator.TranslateFunction();
+  lir->sortBasicBlocks();
+  std::stringstream stream;
+  stream << *lir;
+  return stream.str();
+}
+
+} // namespace
+
+TEST_F(UdfTypedSequenceIntrinsicTest, HIRMetadataIsTypedAndReplayable) {
+  auto map = parseUnicodeMapFunction();
+  auto fsm = parseUnicodeFsmFunction();
+  ASSERT_NE(map, nullptr);
+  ASSERT_NE(fsm, nullptr);
+  for (const auto* function : {map.get(), fsm.get()}) {
+    const jit::hir::Instr* sequence = findSequenceInstruction(*function);
+    ASSERT_NE(sequence, nullptr);
+    EXPECT_EQ(jit::hir::outputType(*sequence), jit::hir::TUnicodeExact);
+    EXPECT_TRUE(sequence->isReplayable());
+    EXPECT_FALSE(jit::hir::isPassthrough(*sequence));
+    EXPECT_FALSE(jit::hir::hasArbitraryExecution(*sequence));
+    EXPECT_EQ(jit::hir::memoryEffects(*sequence).may_store, jit::hir::AEmpty);
+  }
+}
+
+TEST_F(UdfTypedSequenceIntrinsicTest, LIRCallsGenericRuntimeHelpers) {
+  auto map = parseUnicodeMapFunction();
+  auto fsm = parseUnicodeFsmFunction();
+  ASSERT_NE(map, nullptr);
+  ASSERT_NE(fsm, nullptr);
+  const std::string map_lir = lowerToLir(*map);
+  const std::string fsm_lir = lowerToLir(*fsm);
+  EXPECT_NE(
+      map_lir.find(fmt::format(
+          "{}", reinterpret_cast<uint64_t>(JITRT_UnicodeMapSequence))),
+      std::string::npos)
+      << map_lir;
+  EXPECT_NE(
+      fsm_lir.find(fmt::format(
+          "{}", reinterpret_cast<uint64_t>(JITRT_UnicodeFsmSequence))),
+      std::string::npos)
+      << fsm_lir;
+}
