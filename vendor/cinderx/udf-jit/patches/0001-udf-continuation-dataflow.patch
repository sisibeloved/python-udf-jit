+PyObject* JITRT_UdfUnicodeCountProperty(PyObject*, PyObject* args) {
+  PyObject* text;
+  PyObject* property_obj;
+  if (!PyArg_ParseTuple(args, "OO", &text, &property_obj)) {
+    return nullptr;
+  }
+  if (!PyUnicode_CheckExact(text)) {
+    PyErr_SetString(
+        PyExc_TypeError, "Unicode property count expects an exact str");
+    return nullptr;
+  }
+  if (!PyLong_CheckExact(property_obj)) {
+    PyErr_SetString(
+        PyExc_TypeError, "Unicode property id expects an exact int");
+    return nullptr;
+  }
+  int overflow = 0;
+  const long property = PyLong_AsLongAndOverflow(property_obj, &overflow);
+  if (overflow != 0 || !isValidUnicodeProperty(property)) {
+    PyErr_SetString(PyExc_ValueError, "unsupported Unicode property id");
+    return nullptr;
+  }
+  return PyLong_FromLongLong(JITRT_UnicodeCountProperty(text, property));
