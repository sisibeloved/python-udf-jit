+"""Tests for generic typed sequence-construction specialization."""
+
+import re
+import unittest
+
+import cinderx.jit
+
+try:
+    from cinderjit import (
+        _udf_unicode_fsm_sequence,
+        _udf_unicode_map_sequence,
+    )
+except ImportError:
+    _udf_unicode_fsm_sequence = None
+    _udf_unicode_map_sequence = None
+
+
+def map_greek(text):
+    return _udf_unicode_map_sequence(text, "αβ→", "ab>")
+
+
+def collapse_whitespace_runs(text):
+    return _udf_unicode_fsm_sequence(
+        text,
+        5,
+        0,
+        "\x01\x00\x01\x02\x01\x02"
+        "\x01\x00\x01\x00\x03\x00"
+        "\x00\x00\x00\x00 \x00",
+    )
+
+
+@unittest.skipUnless(
+    cinderx.jit.is_enabled()
