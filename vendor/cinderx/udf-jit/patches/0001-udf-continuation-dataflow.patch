+payload = _udf_build_continuation_payload(*explicit_exit)
+assert payload[1] == "python_region"
+
+unregistered_guard_target = len
+
+def unregistered_region():
+    unregistered_guard_target(())
+    return _udf_build_continuation_payload(*valid)
+
+assert cinderx.jit.force_compile(unregistered_region)
+assert cinderx.jit.is_jit_compiled(unregistered_region)
+cinderx.jit.clear_runtime_stats()
+unregistered_guard_target = lambda _: 0
+try:
+    unregistered_region()
+except ValueError as error:
+    assert "guard_deopt_required" in str(error), error
+else:
+    raise AssertionError("an unregistered Region produced a continuation ticket")
+stats = cinderx.jit.get_and_clear_runtime_stats()
+deopts = [
+    event
+    for event in stats["deopt"]
+    if event["normal"]["func_qualname"] == "unregistered_region"
+    and event["normal"]["reason"] == "GuardFailure"
+]
+assert sum(event["int"]["count"] for event in deopts) >= 1, stats
+
+explicit_guard_target = len
+
+def explicit_exit_after_guard():
+    explicit_guard_target(())
+    explicit_payload = _udf_build_continuation_payload(*explicit_exit)
+    try:
+        _udf_build_continuation_payload(*valid)
+    except ValueError as error:
+        return explicit_payload, str(error)
+    raise AssertionError("an explicit exit left a reusable GuardFailure ticket")
+
+assert _udf_register_continuation_code(explicit_exit_after_guard)
+assert cinderx.jit.force_compile(explicit_exit_after_guard)
+explicit_guard_target = lambda _: 0
+explicit_payload, explicit_followup_error = explicit_exit_after_guard()
+assert explicit_payload[1] == "python_region"
+assert "guard_deopt_required" in explicit_followup_error, explicit_followup_error
+
+guard_target = len
+
+def leave_stale_observation(build_payload):
+    guard_target(())
+    if build_payload:
+        return _udf_build_continuation_payload(*valid)
+
+assert _udf_register_continuation_code(leave_stale_observation.__code__)
+assert cinderx.jit.force_compile(leave_stale_observation)
+guard_target = lambda _: 0
+leave_stale_observation(False)
+guard_target = len
+try:
+    leave_stale_observation(True)
+except ValueError as error:
+    assert "guard_deopt_required" in str(error), error
+else:
+    raise AssertionError("a stale Region deopt observation was reused")
+)");
+}
