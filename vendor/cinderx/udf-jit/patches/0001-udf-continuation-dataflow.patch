+TEST_F(UdfDataIntrinsicTest, RuntimeHelpersCoverTypedNullableLifecycle) {
+  runStockCode(R"(
+import math
+import struct
+
+from cinderjit import (
+    _udf_begin_scalar_slot_borrow,
+    _udf_create_scalar_slot,
+    _udf_data_is_null,
+    _udf_data_load_bool,
+    _udf_data_load_f32,
+    _udf_data_load_f64,
+    _udf_data_load_i32,
+    _udf_data_load_i64,
+    _udf_data_store_bool,
+    _udf_data_store_f32,
+    _udf_data_store_f64,
+    _udf_data_store_i32,
+    _udf_data_store_i64,
+    _udf_data_store_null,
+    _udf_end_scalar_slot_borrow,
+    _udf_guard_data_handle,
+    _udf_release_scalar_slot,
+    _udf_set_scalar_slot,
+)
+
+cases = (
+    ("bool", _udf_data_load_bool, _udf_data_store_bool, (False, True)),
+    ("int32", _udf_data_load_i32, _udf_data_store_i32, (-(2**31), 0, 2**31 - 1)),
+    ("int64", _udf_data_load_i64, _udf_data_store_i64, (-(2**63), 0, 2**63 - 1)),
+    ("float32", _udf_data_load_f32, _udf_data_store_f32, (-0.0, 1.25, float("inf"))),
+    ("float64", _udf_data_load_f64, _udf_data_store_f64, (-0.0, 1.25, float("inf"))),
+)
+for scalar_type, load, store, values in cases:
+    source = _udf_create_scalar_slot(scalar_type, False)
+    target = _udf_create_scalar_slot(scalar_type, False)
+    for operation in (
+        lambda: _udf_guard_data_handle(source),
+        lambda: load(source),
+        lambda: store(target, values[0]),
+    ):
+        try:
+            operation()
+        except RuntimeError:
+            pass
+        else:
+            raise AssertionError("slot access outside an active borrow must fail")
+
+    _udf_begin_scalar_slot_borrow(source)
+    _udf_begin_scalar_slot_borrow(target)
+    guarded_source = _udf_guard_data_handle(source)
+    guarded_target = _udf_guard_data_handle(target)
+    for operation in (
+        lambda: load(guarded_source),
+        lambda: _udf_data_is_null(guarded_source),
+    ):
+        try:
+            operation()
+        except RuntimeError:
+            pass
+        else:
+            raise AssertionError("an uninitialized slot must not be readable")
+
+    for value in values:
+        _udf_set_scalar_slot(source, value)
+        result = load(_udf_guard_data_handle(source))
+        expected = (
+            struct.unpack("f", struct.pack("f", value))[0]
+            if scalar_type == "float32"
+            else value
+        )
+        assert result == expected
+        stored = store(_udf_guard_data_handle(target), result)
+        assert stored == result
+        assert load(_udf_guard_data_handle(target)) == expected
+        if isinstance(expected, float) and expected == 0.0:
+            assert math.copysign(1.0, result) == math.copysign(1.0, expected)
+
+    _udf_end_scalar_slot_borrow(source)
+    _udf_end_scalar_slot_borrow(target)
+    _udf_release_scalar_slot(source)
+    _udf_release_scalar_slot(source)
+    _udf_release_scalar_slot(target)
+    for operation in (
+        lambda: _udf_begin_scalar_slot_borrow(source),
+        lambda: _udf_guard_data_handle(source),
+    ):
+        try:
+            operation()
+        except RuntimeError:
+            pass
+        else:
+            raise AssertionError("released slots must stay invalid")
+
+nullable = _udf_create_scalar_slot("int64", True)
+_udf_begin_scalar_slot_borrow(nullable)
+_udf_set_scalar_slot(nullable, None)
+guarded = _udf_guard_data_handle(nullable)
+assert _udf_data_is_null(guarded)
+try:
+    _udf_data_load_i64(guarded)
+except TypeError:
+    pass
+else:
+    raise AssertionError("null must not be unboxed as int64")
+assert _udf_data_store_null(_udf_guard_data_handle(nullable)) is None
+_udf_end_scalar_slot_borrow(nullable)
+_udf_release_scalar_slot(nullable)
+
+non_nullable = _udf_create_scalar_slot("int32", False)
+_udf_begin_scalar_slot_borrow(non_nullable)
+for operation, error in (
+    (lambda: _udf_set_scalar_slot(non_nullable, None), TypeError),
+    (lambda: _udf_set_scalar_slot(non_nullable, True), TypeError),
+    (lambda: _udf_set_scalar_slot(non_nullable, 2**31), OverflowError),
+    (lambda: _udf_data_store_null(non_nullable), TypeError),
+    (lambda: _udf_data_load_i64(non_nullable), RuntimeError),
+):
+    try:
+        operation()
+    except error:
+        pass
+    else:
+        raise AssertionError("type, range, and nullability checks must be exact")
+_udf_end_scalar_slot_borrow(non_nullable)
+_udf_release_scalar_slot(non_nullable)
+
+try:
+    _udf_create_scalar_slot("uint64", False)
+except ValueError:
+    pass
+else:
+    raise AssertionError("unsupported physical types must fail")
+
+try:
+    _udf_guard_data_handle(object())
+except TypeError:
+    pass
+else:
+    raise AssertionError("forged handles must fail")
+)");
+}
