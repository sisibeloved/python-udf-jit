+    and _udf_unicode_fsm_sequence is not None,
+    "requires CinderX JIT typed-sequence helpers",
+)
+class UdfTypedSequenceIntrinsicTests(unittest.TestCase):
+    def test_public_map_helper_accepts_arbitrary_scalar_tables(self):
+        cases = (
+            ("α→β and 中文", "αβ→", "ab>", "a>b and 中文"),
+            ("cab", "abc", "123", "312"),
+            ("🙂a🙂", "🙂", "x", "xax"),
+            ("", "", "", ""),
+        )
+        for text, keys, values, expected in cases:
+            with self.subTest(text=text, keys=keys):
+                self.assertEqual(
+                    _udf_unicode_map_sequence(text, keys, values),
+                    expected,
+                )
+
+    def test_public_fsm_helper_matches_unicode_regex_collapse(self):
+        samples = (
+            "",
+            "plain",
+            "  a\t\nb  ",
+            "\u2003中文\u2029 text\u3000",
+            "\x1cA\x1fB\x85",
+        )
+        for text in samples:
+            with self.subTest(text=text):
+                self.assertEqual(
+                    collapse_whitespace_runs(text),
+                    re.sub(r"\s+", " ", text).strip(),
+                )
+
+    def test_public_helpers_reject_unproven_descriptors_and_subclasses(self):
+        class TextSubclass(str):
+            pass
+
+        with self.assertRaises(TypeError):
+            _udf_unicode_map_sequence(TextSubclass("a"), "a", "b")
+        with self.assertRaises(ValueError):
+            _udf_unicode_map_sequence("a", "aa", "bc")
+        with self.assertRaises(ValueError):
+            _udf_unicode_map_sequence("a", "ba", "12")
+        with self.assertRaises(ValueError):
+            _udf_unicode_map_sequence("a", "ab", "x")
+        with self.assertRaises(TypeError):
+            _udf_unicode_fsm_sequence(
+                "a", True, 0, "\x00\x00\x01\x00\x00\x00"
+            )
+        with self.assertRaises(ValueError):
+            _udf_unicode_fsm_sequence(
+                "a", 5, 0, "\x02\x00\x01\x00\x00\x00"
+            )
+
+    def test_generic_helpers_lower_to_distinct_typed_hir_operations(self):
+        cases = (
+            (map_greek, "UnicodeMapSequence", "α→β", "a>b"),
+            (
+                collapse_whitespace_runs,
+                "UnicodeFsmSequence",
+                "  a\t\nb  ",
+                "a b",
+            ),
+        )
+        for function, opcode, value, expected in cases:
+            with self.subTest(opcode=opcode):
+                self.assertTrue(cinderx.jit.force_compile(function))
+                counts = cinderx.jit.get_function_hir_opcode_counts(function)
+                self.assertEqual(counts.get(opcode, 0), 1, counts)
+                self.assertEqual(function(value), expected)
+
+    def test_unrelated_python_calls_are_not_specialized(self):
+        def fake_map(text, keys, values):
+            return text + keys + values
+
+        def wrapper(text):
+            return fake_map(text, "a", "b")
+
+        self.assertTrue(cinderx.jit.force_compile(wrapper))
+        counts = cinderx.jit.get_function_hir_opcode_counts(wrapper)
+        self.assertEqual(counts.get("UnicodeMapSequence", 0), 0, counts)
+        self.assertEqual(wrapper("x"), "xab")
+
+
+if __name__ == "__main__":
+    unittest.main()
