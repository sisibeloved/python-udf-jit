+PyObject* JITRT_UdfBuildContinuationPayload(PyObject*, PyObject* args) {
+  if (!PyTuple_CheckExact(args) || PyTuple_GET_SIZE(args) != 13) {
+    PyErr_SetString(
+        PyExc_TypeError,
+        "_udf_build_continuation_payload expects exactly 13 arguments");
+    return nullptr;
+  }
+  PyObject* abi_object = PyTuple_GET_ITEM(args, 0);
+  PyObject* reason_object = PyTuple_GET_ITEM(args, 1);
+  PyObject* resume_object = PyTuple_GET_ITEM(args, 2);
+  PyObject* namespace_object = PyTuple_GET_ITEM(args, 3);
+  PyObject* code_object = PyTuple_GET_ITEM(args, 4);
+  PyObject* first_line_object = PyTuple_GET_ITEM(args, 5);
+  PyObject* source_map = PyTuple_GET_ITEM(args, 6);
+  PyObject* values = PyTuple_GET_ITEM(args, 7);
+  PyObject* kinds = PyTuple_GET_ITEM(args, 8);
+  PyObject* nullable = PyTuple_GET_ITEM(args, 9);
+  PyObject* materialized = PyTuple_GET_ITEM(args, 10);
+  PyObject* active_exception = PyTuple_GET_ITEM(args, 11);
+  PyObject* committed_object = PyTuple_GET_ITEM(args, 12);
+
+  if (!PyLong_CheckExact(abi_object) || !PyUnicode_CheckExact(reason_object) ||
+      PyUnicode_GET_LENGTH(reason_object) == 0 ||
+      !PyUnicode_CheckExact(resume_object) ||
+      !PyUnicode_CheckExact(namespace_object) ||
+      !PyUnicode_CheckExact(code_object) ||
+      !PyLong_CheckExact(first_line_object) ||
+      !PyTuple_CheckExact(source_map) || !PyTuple_CheckExact(values) ||
+      !PyTuple_CheckExact(kinds) || !PyTuple_CheckExact(nullable) ||
+      !PyTuple_CheckExact(materialized) ||
+      !(active_exception == Py_None ||
+        PyExceptionInstance_Check(active_exception)) ||
+      !PyBool_Check(committed_object)) {
+    PyErr_SetString(PyExc_TypeError, "invalid UDF continuation payload shape");
+    return nullptr;
+  }
+
+  long abi_version = PyLong_AsLong(abi_object);
+  long first_line = PyLong_AsLong(first_line_object);
+  const char* reason = PyUnicode_AsUTF8(reason_object);
+  const char* resume_id = PyUnicode_AsUTF8(resume_object);
+  const char* namespace_sha256 = PyUnicode_AsUTF8(namespace_object);
+  const char* code_sha256 = PyUnicode_AsUTF8(code_object);
+  if (PyErr_Occurred()) {
+    return nullptr;
+  }
+  bool requires_guard_deopt = std::strcmp(reason, "cinderx_deopt") == 0;
+  bool is_explicit_region_exit = std::strcmp(reason, "python_region") == 0;
+  if (!requires_guard_deopt && !is_explicit_region_exit) {
+    PyErr_SetString(
+        PyExc_ValueError, "udf_continuation_reason_invalid");
+    return nullptr;
+  }
+  auto identity_reject = jit::validateUdfContinuationIdentity(
+      static_cast<int>(abi_version),
+      resume_id,
+      namespace_sha256,
+      code_sha256,
+      static_cast<int>(first_line),
+      committed_object == Py_True);
+  if (identity_reject != jit::UdfContinuationReject::kNone) {
+    PyErr_Format(
+        PyExc_ValueError,
+        "udf_continuation_%s",
+        jit::udfContinuationRejectName(identity_reject));
+    return nullptr;
+  }
