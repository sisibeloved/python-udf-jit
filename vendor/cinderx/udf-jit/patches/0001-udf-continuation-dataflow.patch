+TEST_F(UdfDataIntrinsicTest, RuntimeHelpersRejectCrossProcessCapsule) {
+  runStockCode(R"(
+import os
+
+from cinderjit import (
+    _udf_begin_scalar_slot_borrow,
+    _udf_create_scalar_slot,
+    _udf_end_scalar_slot_borrow,
+    _udf_guard_data_handle,
+    _udf_release_scalar_slot,
+)
+
+slot = _udf_create_scalar_slot("float64", False)
+_udf_begin_scalar_slot_borrow(slot)
+pid = os.fork()
+if pid == 0:
+    try:
+        _udf_guard_data_handle(slot)
+    except RuntimeError:
+        os._exit(0)
+    os._exit(1)
+
+_, status = os.waitpid(pid, 0)
+assert os.waitstatus_to_exitcode(status) == 0
+try:
+    _udf_release_scalar_slot(slot)
+except RuntimeError:
+    pass
+else:
+    raise AssertionError("active borrows must prevent release")
+_udf_end_scalar_slot_borrow(slot)
+_udf_release_scalar_slot(slot)
+)");
+}
+#endif
