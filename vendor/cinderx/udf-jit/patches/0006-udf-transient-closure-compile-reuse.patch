+void Context::forgetAnchoredCompiled(BorrowedRef<PyCodeObject> code) {
+  std::vector<Ref<CompiledFunction>> dropped;
+  {
+    ThreadedCompileSerialize guard;
+    auto it = anchored_compiled_funcs_.find(code);
+    if (it == anchored_compiled_funcs_.end()) {
+      return;
+    }
+    dropped = std::move(it->second);
+    anchored_compiled_funcs_.erase(it);
+  }
+  // Drop the references outside the guard; destroying a CompiledFunction
+  // re-enters the context with its own synchronization.
+}
+
+void Context::dropAnchoredCompiled(
+    BorrowedRef<PyCodeObject> code,
+    const CompiledFunction* compiled) {
+  ThreadedCompileSerialize guard;
+  auto it = anchored_compiled_funcs_.find(code);
+  if (it == anchored_compiled_funcs_.end()) {
+    return;
+  }
+  auto& anchored = it->second;
+  anchored.erase(
+      std::remove_if(
+          anchored.begin(),
+          anchored.end(),
+          [compiled](const Ref<CompiledFunction>& ref) {
+            return ref.get() == compiled;
+          }),
+      anchored.end());
+  if (anchored.empty()) {
+    anchored_compiled_funcs_.erase(it);
+  }
+}
