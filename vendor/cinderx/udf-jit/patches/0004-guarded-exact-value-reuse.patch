+    PyObject* argument2) {
+  PyObject* expected = PyList_GET_ITEM(state, kUdfValueExpectedArguments);
+  if (!PyUnicode_CheckExact(argument0) || !PyTuple_CheckExact(expected) ||
+      !PyDict_CheckExact(argument2) || PyDict_GET_SIZE(argument2) != 0) {
+    return false;
+  }
+  if (PyTuple_GET_SIZE(expected) == 0) {
+    return argument1 == Py_None;
+  }
+  return PyTuple_GET_SIZE(expected) == 1 &&
+      argument1 == PyTuple_GET_ITEM(expected, 0);
