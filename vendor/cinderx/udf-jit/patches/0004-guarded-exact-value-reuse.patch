+// A compiler-created exact list is the GC-visible owner for a guarded
+// invariant cache.  Lookup returns a primitive hit flag; Result returns a new
+// reference and is only emitted on the hit edge.  Update cannot fail: all
+// storage is allocated while building HIR and it only replaces existing list
+// entries.
+constexpr Py_ssize_t kUdfInvariantWatchers = 0;
+constexpr Py_ssize_t kUdfInvariantSnapshots = 1;
+constexpr Py_ssize_t kUdfInvariantArgument0 = 2;
+constexpr Py_ssize_t kUdfInvariantResult = 3;
+constexpr Py_ssize_t kUdfInvariantValid = 4;
+constexpr Py_ssize_t kUdfInvariantMissing = 5;
+constexpr Py_ssize_t kUdfInvariantStateSize = 6;
