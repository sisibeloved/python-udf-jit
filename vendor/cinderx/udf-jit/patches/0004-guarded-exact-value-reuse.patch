+    current = PyDict_GetItemWithError(current, PyTuple_GET_ITEM(path, i));
+    if (current == nullptr) {
+      return nullptr;
+    }
+  }
+  return current;
+}
+
+int udfValueEntryGuardMatches(PyObject* state, PyObject* result) {
+  PyObject* guard = PyList_GET_ITEM(state, kUdfValueEntryGuard);
+  if (guard == Py_None) {
+    return 1;
+  }
+  PyObject* guard_entries = PyList_GET_ITEM(state, kUdfValueEntryGuardEntries);
+  PyObject* snapshot = PyDict_GetItemWithError(guard_entries, result);
+  Ref<> owned_snapshot;
+  if (snapshot == nullptr) {
+    if (PyErr_Occurred()) {
+      return -1;
+    }
+    auto decoded =
+        Ref<>::steal(PyObject_CallOneArg(PyTuple_GET_ITEM(guard, 1), result));
+    if (decoded == nullptr) {
+      return -1;
+    }
+    PyObject* key = udfValueAtExactPath(decoded, PyTuple_GET_ITEM(guard, 2));
+    PyObject* expected =
+        udfValueAtExactPath(decoded, PyTuple_GET_ITEM(guard, 4));
+    if (key == nullptr || expected == nullptr) {
+      return -1;
+    }
+    owned_snapshot = Ref<>::steal(PyTuple_Pack(2, key, expected));
+    if (owned_snapshot == nullptr ||
+        PyDict_SetItem(guard_entries, result, owned_snapshot) < 0) {
+      return -1;
+    }
+    snapshot = owned_snapshot.get();
+  }
+
+  auto observed = Ref<>::steal(PyObject_CallOneArg(
+      PyTuple_GET_ITEM(guard, 3), PyTuple_GET_ITEM(snapshot, 0)));
+  if (observed == nullptr) {
+    return -1;
+  }
+  PyObject* expected = PyTuple_GET_ITEM(snapshot, 1);
+  if (Py_TYPE(observed.get()) != Py_TYPE(expected)) {
+    return 0;
+  }
+  return PyObject_RichCompareBool(observed, expected, Py_EQ);
+}
+
+bool snapshotUdfValueDependencies(PyObject* state) {
+  PyObject* watchers = PyList_GET_ITEM(state, kUdfValueWatchers);
+  PyObject* snapshots = PyList_GET_ITEM(state, kUdfValueSnapshots);
+  PyObject* missing = PyList_GET_ITEM(state, kUdfValueMissing);
+  for (Py_ssize_t i = 0; i < PyTuple_GET_SIZE(watchers); i++) {
+    bool owned = false;
+    PyObject* current =
+        valueCacheWatchedValue(PyTuple_GET_ITEM(watchers, i), missing, &owned);
+    if (current == nullptr) {
+      PyErr_Clear();
+      return false;
+    }
+    replaceInvariantStateItem(snapshots, i, current);
+    if (owned) {
+      Py_DECREF(current);
+    }
+  }
+  replaceInvariantStateItem(state, kUdfValueSnapshotsValid, Py_True);
+  return true;
+}
+
+bool udfValueDependenciesMatch(PyObject* state) {
+  PyObject* watchers = PyList_GET_ITEM(state, kUdfValueWatchers);
+  PyObject* snapshots = PyList_GET_ITEM(state, kUdfValueSnapshots);
+  PyObject* missing = PyList_GET_ITEM(state, kUdfValueMissing);
+  for (Py_ssize_t i = 0; i < PyTuple_GET_SIZE(watchers); i++) {
+    bool owned = false;
+    PyObject* current =
+        valueCacheWatchedValue(PyTuple_GET_ITEM(watchers, i), missing, &owned);
+    if (current == nullptr) {
+      PyErr_Clear();
+      return false;
+    }
+    bool matches = current == PyList_GET_ITEM(snapshots, i);
+    if (owned) {
+      Py_DECREF(current);
+    }
+    if (!matches) {
+      return false;
+    }
+  }
+  return true;
+}
+
+} // namespace
+
+int64_t JITRT_UdfInvariantCacheLookup1(PyObject* state, PyObject* argument0) {
+  JIT_DCHECK(
+      PyList_CheckExact(state) &&
+          PyList_GET_SIZE(state) == kUdfInvariantStateSize,
+      "invalid compiler-created invariant state");
+  if (PyList_GET_ITEM(state, kUdfInvariantValid) != Py_True ||
+      PyList_GET_ITEM(state, kUdfInvariantArgument0) != argument0) {
+    return 0;
+  }
+
+  PyObject* watchers = PyList_GET_ITEM(state, kUdfInvariantWatchers);
+  PyObject* snapshots = PyList_GET_ITEM(state, kUdfInvariantSnapshots);
+  PyObject* missing = PyList_GET_ITEM(state, kUdfInvariantMissing);
+  JIT_DCHECK(
+      PyTuple_CheckExact(watchers) && PyList_CheckExact(snapshots) &&
+          PyTuple_GET_SIZE(watchers) == PyList_GET_SIZE(snapshots),
+      "invalid compiler-created invariant watcher state");
+  for (Py_ssize_t i = 0; i < PyTuple_GET_SIZE(watchers); i++) {
+    PyObject* current =
+        invariantWatchedValue(PyTuple_GET_ITEM(watchers, i), missing);
+    if (current != PyList_GET_ITEM(snapshots, i)) {
+      return 0;
+    }
+  }
+
+  return 1;
+}
+
+PyObject* JITRT_UdfInvariantCacheResult(PyObject* state) {
+  JIT_DCHECK(
+      PyList_CheckExact(state) &&
+          PyList_GET_SIZE(state) == kUdfInvariantStateSize &&
+          PyList_GET_ITEM(state, kUdfInvariantValid) == Py_True,
+      "invalid compiler-created invariant cache hit");
+  PyObject* result = PyList_GET_ITEM(state, kUdfInvariantResult);
+  Py_INCREF(result);
+  return result;
+}
+
+void JITRT_UdfInvariantCacheUpdate1(
+    PyObject* state,
+    PyObject* argument0,
+    PyObject* result) {
+  JIT_DCHECK(
+      PyList_CheckExact(state) &&
+          PyList_GET_SIZE(state) == kUdfInvariantStateSize,
+      "invalid compiler-created invariant state");
+  PyObject* watchers = PyList_GET_ITEM(state, kUdfInvariantWatchers);
+  PyObject* snapshots = PyList_GET_ITEM(state, kUdfInvariantSnapshots);
+  PyObject* missing = PyList_GET_ITEM(state, kUdfInvariantMissing);
+  for (Py_ssize_t i = 0; i < PyTuple_GET_SIZE(watchers); i++) {
+    replaceInvariantStateItem(
+        snapshots,
+        i,
+        invariantWatchedValue(PyTuple_GET_ITEM(watchers, i), missing));
+  }
+  replaceInvariantStateItem(state, kUdfInvariantArgument0, argument0);
+  replaceInvariantStateItem(state, kUdfInvariantResult, result);
+  replaceInvariantStateItem(state, kUdfInvariantValid, Py_True);
+}
+
+int64_t JITRT_UdfValueCacheLookup3(
+    PyObject* state,
+    PyObject* argument0,
+    PyObject* argument1,
+    PyObject* argument2) {
+  JIT_DCHECK(
+      PyList_CheckExact(state) && PyList_GET_SIZE(state) == kUdfValueStateSize,
+      "invalid compiler-created UDF value-cache state");
+  if (PyList_GET_ITEM(state, kUdfValueDisabled) == Py_True) {
+    return 0;
+  }
+  if (!udfValueCallShapeMatches(state, argument0, argument1, argument2)) {
+    return 0;
+  }
+  if (PyList_GET_ITEM(state, kUdfValueSnapshotsValid) != Py_True) {
+    return 0;
+  }
+  if (!udfValueDependenciesMatch(state)) {
+    disableUdfValueCache(state);
+    return 0;
+  }
+
+  PyObject* entries = PyList_GET_ITEM(state, kUdfValueEntries);
+  PyObject* result = PyDict_GetItemWithError(entries, argument0);
+  if (result == nullptr) {
+    if (PyErr_Occurred()) {
+      PyErr_Clear();
+      disableUdfValueCache(state);
+    }
+    return 0;
+  }
+  int entry_guard_matches = udfValueEntryGuardMatches(state, result);
+  if (entry_guard_matches <= 0) {
+    if (entry_guard_matches < 0) {
+      PyErr_Clear();
+      disableUdfValueCache(state);
+    } else {
+      PyDict_DelItem(entries, argument0);
+      PyErr_Clear();
+      PyDict_DelItem(
+          PyList_GET_ITEM(state, kUdfValueEntryGuardEntries), result);
+      PyErr_Clear();
+    }
+    return 0;
+  }
+  replaceInvariantStateItem(state, kUdfValueLastResult, result);
+  return 1;
+}
+
+PyObject* JITRT_UdfValueCacheResult(PyObject* state) {
+  JIT_DCHECK(
+      PyList_CheckExact(state) &&
+          PyList_GET_SIZE(state) == kUdfValueStateSize &&
+          PyList_GET_ITEM(state, kUdfValueDisabled) != Py_True,
+      "invalid compiler-created UDF value-cache hit");
+  PyObject* result = PyList_GET_ITEM(state, kUdfValueLastResult);
+  Py_INCREF(result);
+  return result;
+}
+
+void JITRT_UdfValueCacheUpdate3(
+    PyObject* state,
+    PyObject* argument0,
+    PyObject* argument1,
+    PyObject* argument2,
+    PyObject* result) {
+  JIT_DCHECK(
+      PyList_CheckExact(state) && PyList_GET_SIZE(state) == kUdfValueStateSize,
+      "invalid compiler-created UDF value-cache state");
+  if (PyList_GET_ITEM(state, kUdfValueDisabled) == Py_True ||
+      !udfValueCallShapeMatches(state, argument0, argument1, argument2) ||
+      !PyUnicode_CheckExact(result)) {
+    return;
+  }
+  if (PyList_GET_ITEM(state, kUdfValueSnapshotsValid) != Py_True) {
+    if (!snapshotUdfValueDependencies(state)) {
+      disableUdfValueCache(state);
+      return;
+    }
+  } else if (!udfValueDependenciesMatch(state)) {
+    disableUdfValueCache(state);
+    return;
+  }
+
+  PyObject* entries = PyList_GET_ITEM(state, kUdfValueEntries);
+  PyObject* existing = PyDict_GetItemWithError(entries, argument0);
+  if (existing == nullptr && PyErr_Occurred()) {
+    PyErr_Clear();
+    disableUdfValueCache(state);
+    return;
+  }
+  Py_ssize_t capacity =
+      PyLong_AsSsize_t(PyList_GET_ITEM(state, kUdfValueCapacity));
+  if (capacity <= 0 ||
+      (existing == nullptr && PyDict_GET_SIZE(entries) >= capacity)) {
+    PyErr_Clear();
+    return;
+  }
+  if (PyDict_SetItem(entries, argument0, result) < 0) {
+    PyErr_Clear();
+    disableUdfValueCache(state);
+  }
+}
+
