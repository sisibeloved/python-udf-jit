+PyObject* JITRT_UdfInvariantCacheResult(PyObject* state);
+void JITRT_UdfInvariantCacheUpdate1(
+    PyObject* state,
+    PyObject* argument0,
+    PyObject* result);
+
+// A bounded value cache for an exact Unicode row input.  The initial generic
+// call shape supports one positional input, one identity-checked keyword-only
+// default, and an empty **kwargs dict.  Any other call shape executes the
+// ordinary HIR.  Dependency mutation permanently disables the cache so values
+// compiled under one process-state context are never retargeted to another.
+constexpr Py_ssize_t kUdfValueWatchers = 0;
+constexpr Py_ssize_t kUdfValueSnapshots = 1;
+constexpr Py_ssize_t kUdfValueExpectedArguments = 2;
+constexpr Py_ssize_t kUdfValueEntries = 3;
+constexpr Py_ssize_t kUdfValueLastResult = 4;
+constexpr Py_ssize_t kUdfValueSnapshotsValid = 5;
+constexpr Py_ssize_t kUdfValueDisabled = 6;
+constexpr Py_ssize_t kUdfValueMissing = 7;
+constexpr Py_ssize_t kUdfValueCapacity = 8;
+constexpr Py_ssize_t kUdfValueEntryGuard = 9;
+constexpr Py_ssize_t kUdfValueEntryGuardEntries = 10;
+constexpr Py_ssize_t kUdfValueStateSize = 11;
+int64_t JITRT_UdfValueCacheLookup3(
+    PyObject* state,
+    PyObject* argument0,
+    PyObject* argument1,
+    PyObject* argument2);
+PyObject* JITRT_UdfValueCacheResult(PyObject* state);
+void JITRT_UdfValueCacheUpdate3(
+    PyObject* state,
+    PyObject* argument0,
+    PyObject* argument1,
+    PyObject* argument2,
+    PyObject* result);
