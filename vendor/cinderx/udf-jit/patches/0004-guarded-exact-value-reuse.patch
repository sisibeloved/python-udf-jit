+      !PyTuple_CheckExact(watchers.get()) ||
+      PyTuple_GET_SIZE(watchers.get()) <= 0 ||
+      PyTuple_GET_SIZE(watchers.get()) > kMaxUdfValueWatchers ||
+      !isValidValueEntryGuard(entry_guard)) {
+    PyErr_Clear();
+    return nullptr;
+  }
+  for (Py_ssize_t i = 0; i < PyTuple_GET_SIZE(watchers.get()); i++) {
+    if (!isValidValueWatcher(PyTuple_GET_ITEM(watchers.get(), i))) {
+      PyErr_Clear();
+      return nullptr;
+    }
+  }
+
+  auto missing = Ref<>::steal(PyCapsule_New(
+      reinterpret_cast<void*>(1), "cinderx.udf_value_missing", nullptr));
+  auto snapshots = Ref<>::steal(PyList_New(PyTuple_GET_SIZE(watchers.get())));
+  auto entries = Ref<>::steal(PyDict_New());
+  auto entry_guard_entries = Ref<>::steal(PyDict_New());
+  auto state = Ref<>::steal(PyList_New(kUdfValueStateSize));
+  if (missing == nullptr || snapshots == nullptr || entries == nullptr ||
+      entry_guard_entries == nullptr || state == nullptr) {
+    PyErr_Clear();
+    return nullptr;
+  }
+  for (Py_ssize_t i = 0; i < PyList_GET_SIZE(snapshots); i++) {
+    Py_INCREF(missing.get());
+    PyList_SET_ITEM(snapshots, i, missing.get());
+  }
+  auto set_state = [&](Py_ssize_t index, BorrowedRef<> value) {
+    Py_INCREF(value.get());
+    PyList_SET_ITEM(state, index, value.get());
+  };
+  set_state(kUdfValueWatchers, watchers);
+  set_state(kUdfValueSnapshots, snapshots);
+  set_state(kUdfValueExpectedArguments, argument_values);
+  set_state(kUdfValueEntries, entries);
+  set_state(kUdfValueLastResult, Py_None);
+  set_state(kUdfValueSnapshotsValid, Py_False);
+  set_state(kUdfValueDisabled, Py_False);
+  set_state(kUdfValueMissing, missing);
+  set_state(kUdfValueCapacity, capacity);
+  set_state(
+      kUdfValueEntryGuard,
+      entry_guard == nullptr ? BorrowedRef<>(Py_None) : entry_guard);
+  set_state(kUdfValueEntryGuardEntries, entry_guard_entries);
+  return state;
+}
