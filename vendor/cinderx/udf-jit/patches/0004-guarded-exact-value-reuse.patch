--- /dev/null
+++ b/cinderx/PythonLib/test_cinderx/test_udf_invariant_cache.py
@@ -0,0 +1,369 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+
+import json
+import unittest
+
+import cinderx.jit as jit
+
+
+_RESOLVE_STATE = {"calls": 0, "root": "first"}
+_READ_STATE = {"calls": 0, "value": "present"}
+_FAIL_STATE = {"calls": 0, "fail": True}
+_DEPENDENCY_STATE = {"calls": 0, "value": "stable"}
+_VALUE_STATE = {"calls": 0, "dependency": "first", "fail": False}
+_VALUE_CALL_STATE = {"dependency": "first"}
+_GUARDED_VALUE_STATE = {"calls": 0, "marker": "stable", "present": False}
+
+
+class _DependencyMarker:
+    token = object()
+
+
+def _dependency_version_one():
+    return 1
+
+
+def _dependency_version_two():
+    return 2
+
+
+def _resolve(explicit):
+    _RESOLVE_STATE["calls"] += 1
+    return explicit if explicit is not None else _RESOLVE_STATE["root"]
+
+
+def _read(_token):
+    _READ_STATE["calls"] += 1
+    return _READ_STATE.get("value", "missing")
+
+
+def _maybe_fail(_token):
+    _FAIL_STATE["calls"] += 1
+    if _FAIL_STATE["fail"]:
+        raise RuntimeError("expected")
+    return "ok"
+
+
+def _identity(value):
+    return value
+
+
+def _read_dependency(_token):
+    _DEPENDENCY_STATE["calls"] += 1
+    return _DEPENDENCY_STATE["value"]
+
+
+def _value_target_impl(value, suffix, extra):
+    _VALUE_STATE["calls"] += 1
+    if _VALUE_STATE["fail"]:
+        raise RuntimeError("value-cache-expected")
+    rendered = value + ":" + _VALUE_STATE["dependency"]
+    if suffix is not None:
+        rendered += ":" + suffix
+    if extra:
+        rendered += ":" + str(sorted(extra.items()))
+    return rendered
+
+
+def _value_target_reuse(value, *, suffix=None, **extra):
+    return _value_target_impl(value, suffix, extra)
+
+
+def _value_target_shape(value, *, suffix=None, **extra):
+    return _value_target_impl(value, suffix, extra)
+
+
+def _value_target_dependency(value, *, suffix=None, **extra):
+    return _value_target_impl(value, suffix, extra)
+
+
+def _value_target_exception(value, *, suffix=None, **extra):
+    return _value_target_impl(value, suffix, extra)
+
+
+def _value_dependency_provider(key):
+    return _VALUE_CALL_STATE[key]
+
+
+def _value_target_call_dependency(value, *, suffix=None, **extra):
+    rendered = value + ":" + _value_dependency_provider("dependency")
+    return _value_target_impl(rendered, suffix, extra)
+
+
+def _guarded_value_observer(_key):
+    return _GUARDED_VALUE_STATE["present"]
+
+
+def _guarded_value_target(value, **extra):
+    _GUARDED_VALUE_STATE["calls"] += 1
+    result = {
+        "key": value,
+        "present": _GUARDED_VALUE_STATE["present"],
+    }
+    if extra:
+        result["extra"] = extra
+    return json.dumps(result, sort_keys=True)
+
+
+def _mark_invariant(function, watchers):
+    function.__udfjit_invariant_cache__ = {
+        "version": 1,
+        "argument_modes": ("identity",),
+        "watchers": tuple(("dict_item", mapping, key) for mapping, key in watchers),
+    }
+    return function
+
+
+def _mark_value_cache(function, watchers, *, capacity=16):
+    function.__udfjit_value_cache__ = {
+        "version": 1,
+        "argument_modes": (
+            "exact_unicode_value",
+            "identity",
+            "empty_dict",
+        ),
+        "argument_values": (None,),
+        "capacity": capacity,
+        "result_mode": "exact_unicode",
+        "watchers": tuple(("dict_item", mapping, key) for mapping, key in watchers),
+    }
+    return function
+
+
+@unittest.skipUnless(jit.is_enabled(), "requires CinderX JIT")
+class UdfInvariantCacheTests(unittest.TestCase):
+    def test_value_cache_revalidates_per_entry_external_state(self):
+        _GUARDED_VALUE_STATE.update(calls=0, marker="stable", present=False)
+        _guarded_value_target.__udfjit_value_cache__ = {
+            "version": 1,
+            "argument_modes": ("exact_unicode_value", "empty_dict"),
+            "argument_values": (),
+            "capacity": 16,
+            "entry_guard": (
+                "json_result_call_value",
+                json.loads,
+                ("key",),
+                _guarded_value_observer,
+                ("present",),
+            ),
+            "result_mode": "exact_unicode",
+            "watchers": (("dict_item", _GUARDED_VALUE_STATE, "marker"),),
+        }
+        self.assertTrue(jit.force_compile(_guarded_value_target))
+
+        first = _guarded_value_target("row")
+        self.assertEqual(_guarded_value_target("row"), first)
+        self.assertEqual(_GUARDED_VALUE_STATE["calls"], 1)
+
+        _GUARDED_VALUE_STATE["present"] = True
+        changed = _guarded_value_target("row")
+        self.assertNotEqual(changed, first)
+        self.assertEqual(_guarded_value_target("row"), changed)
+        self.assertEqual(_GUARDED_VALUE_STATE["calls"], 2)
+
+        self.assertIn("extra", _guarded_value_target("row", bypass=True))
+        self.assertEqual(_GUARDED_VALUE_STATE["calls"], 3)
+
+    def test_value_cache_watches_call_result_identity(self):
+        _VALUE_STATE.update(calls=0, dependency="stable", fail=False)
+        _VALUE_CALL_STATE["dependency"] = "first"
+        _value_target_call_dependency.__udfjit_value_cache__ = {
+            "version": 1,
+            "argument_modes": (
+                "exact_unicode_value",
+                "identity",
+                "empty_dict",
+            ),
+            "argument_values": (None,),
+            "capacity": 16,
+            "result_mode": "exact_unicode",
+            "watchers": (
+                (
+                    "call_result_identity",
+                    _value_dependency_provider,
+                    "dependency",
+                ),
+            ),
+        }
+        self.assertTrue(jit.force_compile(_value_target_call_dependency))
+
+        self.assertEqual(
+            _value_target_call_dependency("v"),
+            "v:first:stable",
+        )
+        self.assertEqual(
+            _value_target_call_dependency("v"),
+            "v:first:stable",
+        )
+        _VALUE_CALL_STATE["dependency"] = "second"
+        self.assertEqual(
+            _value_target_call_dependency("v"),
+            "v:second:stable",
+        )
+
+    def test_value_cache_reuses_equal_exact_unicode_inputs(self):
+        _VALUE_STATE.update(calls=0, dependency="first", fail=False)
+        _mark_value_cache(_value_target_reuse, ((_VALUE_STATE, "dependency"),))
+        self.assertTrue(jit.force_compile(_value_target_reuse))
+        counts = jit.get_function_hir_opcode_counts(_value_target_reuse) or {}
+        self.assertGreaterEqual(counts.get("CallStatic", 0), 1, counts)
+
+        first = "same-value-" + "x" * 32
+        equal_but_distinct = (" " + first)[1:]
+        self.assertIsNot(first, equal_but_distinct)
+        self.assertEqual(_value_target_reuse(first), "same-value-" + "x" * 32 + ":first")
+        self.assertEqual(
+            _value_target_reuse(equal_but_distinct),
+            "same-value-" + "x" * 32 + ":first",
+        )
+        self.assertEqual(_VALUE_STATE["calls"], 1)
+
+        self.assertEqual(_value_target_reuse("other"), "other:first")
+        self.assertEqual(_value_target_reuse("other"), "other:first")
+        self.assertEqual(_VALUE_STATE["calls"], 2)
+
+    def test_value_cache_falls_back_for_nondefault_call_shape(self):
+        _VALUE_STATE.update(calls=0, dependency="first", fail=False)
+        _mark_value_cache(_value_target_shape, ((_VALUE_STATE, "dependency"),))
+        self.assertTrue(jit.force_compile(_value_target_shape))
+
+        self.assertEqual(_value_target_shape("v", suffix="s"), "v:first:s")
+        self.assertEqual(_value_target_shape("v", suffix="s"), "v:first:s")
+        self.assertEqual(_value_target_shape("v", marker=1), "v:first:[('marker', 1)]")
+        self.assertEqual(_VALUE_STATE["calls"], 3)
+
+        self.assertEqual(_value_target_shape("v"), "v:first")
+        self.assertEqual(_value_target_shape("v"), "v:first")
+        self.assertEqual(_VALUE_STATE["calls"], 4)
+
+    def test_value_cache_disables_after_dependency_change(self):
+        _VALUE_STATE.update(calls=0, dependency="first", fail=False)
+        _mark_value_cache(_value_target_dependency, ((_VALUE_STATE, "dependency"),))
+        self.assertTrue(jit.force_compile(_value_target_dependency))
+
+        self.assertEqual(_value_target_dependency("v"), "v:first")
+        self.assertEqual(_value_target_dependency("v"), "v:first")
+        self.assertEqual(_VALUE_STATE["calls"], 1)
+
+        _VALUE_STATE["dependency"] = "second"
+        self.assertEqual(_value_target_dependency("v"), "v:second")
+        self.assertEqual(_value_target_dependency("v"), "v:second")
+        self.assertEqual(_VALUE_STATE["calls"], 3)
+
+    def test_value_cache_does_not_cache_exceptions(self):
+        _VALUE_STATE.update(calls=0, dependency="first", fail=True)
+        _mark_value_cache(_value_target_exception, ((_VALUE_STATE, "dependency"),))
+        self.assertTrue(jit.force_compile(_value_target_exception))
+
+        with self.assertRaisesRegex(RuntimeError, "value-cache-expected"):
+            _value_target_exception("v")
+        with self.assertRaisesRegex(RuntimeError, "value-cache-expected"):
+            _value_target_exception("v")
+        self.assertEqual(_VALUE_STATE["calls"], 2)
+
+    def test_reuses_result_until_an_argument_or_watched_value_changes(self):
+        _RESOLVE_STATE.update(calls=0, root="first")
+        _mark_invariant(_resolve, ((_RESOLVE_STATE, "root"),))
+        self.assertTrue(jit.force_compile(_resolve))
+        counts = jit.get_function_hir_opcode_counts(_resolve) or {}
+        self.assertGreaterEqual(counts.get("CallStatic", 0), 1, counts)
+
+        self.assertEqual(_resolve(None), "first")
+        self.assertEqual(_resolve(None), "first")
