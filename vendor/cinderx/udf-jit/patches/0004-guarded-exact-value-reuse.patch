--- a/cinderx/Jit/jit_rt.cpp
+++ b/cinderx/Jit/jit_rt.cpp
@@ -646,6 +646,362 @@ PyObject* JITRT_UdfDataStoreNull(PyObject*, PyObject* capsule) {
 
 namespace {
 
+PyObject* invariantWatchedValue(PyObject* watcher, PyObject* missing_sentinel) {
+  JIT_DCHECK(
+      PyTuple_CheckExact(watcher) && PyTuple_GET_SIZE(watcher) == 3,
+      "validated invariant watcher must be a three-tuple");
+  PyObject* kind = PyTuple_GET_ITEM(watcher, 0);
+  PyObject* owner = PyTuple_GET_ITEM(watcher, 1);
+  PyObject* key = PyTuple_GET_ITEM(watcher, 2);
+  if (PyUnicode_CompareWithASCIIString(kind, "dict_item") == 0) {
+    JIT_DCHECK(
+        PyDict_CheckExact(owner),
+        "validated dict watcher must reference an exact dict");
+    PyObject* value = PyDict_GetItemWithError(owner, key);
+    if (value != nullptr) {
+      return value;
+    }
+    // Descriptor validation only accepts exact immutable builtin keys, so a
+    // failed lookup means absence rather than arbitrary user-code failure.
+    JIT_DCHECK(!PyErr_Occurred(), "exact invariant watcher key lookup raised");
+    if (PyErr_Occurred()) {
+      PyErr_Clear();
+    }
+    return missing_sentinel;
+  }
+  if (PyUnicode_CompareWithASCIIString(kind, "type_attr") == 0) {
+    JIT_DCHECK(PyType_Check(owner), "validated type watcher owner is invalid");
+    PyObject* value =
+        _PyType_Lookup(reinterpret_cast<PyTypeObject*>(owner), key);
+    return value == nullptr ? missing_sentinel : value;
+  }
+  JIT_DCHECK(
+      PyUnicode_CompareWithASCIIString(kind, "function_code") == 0 &&
+          PyFunction_Check(owner),
+      "validated function-code watcher is invalid");
+  return reinterpret_cast<PyFunctionObject*>(owner)->func_code;
+}
+
+void replaceInvariantStateItem(
+    PyObject* state,
+    Py_ssize_t index,
+    PyObject* value) {
+  Py_INCREF(value);
+  int result = PyList_SetItem(state, index, value);
+  JIT_DCHECK(result == 0, "preallocated invariant state update failed");
+  if (result < 0) {
+    PyErr_Clear();
+  }
+}
+
+PyObject* valueCacheWatchedValue(
+    PyObject* watcher,
+    PyObject* missing_sentinel,
+    bool* owned) {
+  PyObject* kind = PyTuple_GET_ITEM(watcher, 0);
+  if (PyUnicode_CompareWithASCIIString(kind, "call_result_identity") == 0) {
+    *owned = true;
+    return PyObject_CallOneArg(
+        PyTuple_GET_ITEM(watcher, 1), PyTuple_GET_ITEM(watcher, 2));
+  }
+  *owned = false;
+  return invariantWatchedValue(watcher, missing_sentinel);
+}
+
+void disableUdfValueCache(PyObject* state) {
+  replaceInvariantStateItem(state, kUdfValueDisabled, Py_True);
+  PyDict_Clear(PyList_GET_ITEM(state, kUdfValueEntries));
+  PyDict_Clear(PyList_GET_ITEM(state, kUdfValueEntryGuardEntries));
+  replaceInvariantStateItem(state, kUdfValueLastResult, Py_None);
+}
