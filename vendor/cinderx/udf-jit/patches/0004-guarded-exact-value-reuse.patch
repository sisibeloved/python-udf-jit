+constexpr const char* kUdfInvariantCacheAttr = "__udfjit_invariant_cache__";
+constexpr const char* kUdfValueCacheAttr = "__udfjit_value_cache__";
+constexpr Py_ssize_t kMaxUdfInvariantWatchers = 32;
+constexpr Py_ssize_t kMaxUdfValueWatchers = 64;
+constexpr Py_ssize_t kMaxUdfValueCacheCapacity = 65536;
+
+bool isInvariantWatcherKey(BorrowedRef<> key) {
+  return PyUnicode_CheckExact(key) || PyBytes_CheckExact(key) ||
+      PyLong_CheckExact(key);
+}
+
+bool isValidInvariantWatcher(BorrowedRef<> watcher) {
+  if (!PyTuple_CheckExact(watcher.get()) ||
+      PyTuple_GET_SIZE(watcher.get()) != 3 ||
+      !PyUnicode_CheckExact(PyTuple_GET_ITEM(watcher.get(), 0))) {
+    return false;
+  }
+  BorrowedRef<> kind = PyTuple_GET_ITEM(watcher.get(), 0);
+  BorrowedRef<> owner = PyTuple_GET_ITEM(watcher.get(), 1);
+  BorrowedRef<> key = PyTuple_GET_ITEM(watcher.get(), 2);
+  if (PyUnicode_CompareWithASCIIString(kind.get(), "dict_item") == 0) {
+    return PyDict_CheckExact(owner.get()) && isInvariantWatcherKey(key);
+  }
+  if (PyUnicode_CompareWithASCIIString(kind.get(), "type_attr") == 0) {
+    return PyType_Check(owner.get()) && PyUnicode_CheckExact(key.get());
+  }
+  if (PyUnicode_CompareWithASCIIString(kind.get(), "function_code") == 0) {
+    return PyFunction_Check(owner.get()) && PyUnicode_CheckExact(key.get()) &&
+        PyUnicode_CompareWithASCIIString(key.get(), "__code__") == 0;
+  }
+  return false;
+}
+
+bool isValidValueWatcher(BorrowedRef<> watcher) {
+  if (isValidInvariantWatcher(watcher)) {
+    return true;
+  }
+  if (!PyTuple_CheckExact(watcher.get()) ||
+      PyTuple_GET_SIZE(watcher.get()) != 3 ||
+      !PyUnicode_CheckExact(PyTuple_GET_ITEM(watcher.get(), 0))) {
+    return false;
+  }
+  BorrowedRef<> kind = PyTuple_GET_ITEM(watcher.get(), 0);
+  BorrowedRef<> owner = PyTuple_GET_ITEM(watcher.get(), 1);
+  BorrowedRef<> key = PyTuple_GET_ITEM(watcher.get(), 2);
+  return PyUnicode_CompareWithASCIIString(kind.get(), "call_result_identity") ==
+      0 &&
+      PyCallable_Check(owner.get()) && isInvariantWatcherKey(key);
+}
+
+bool isExactUnicodePath(BorrowedRef<> path) {
+  if (!PyTuple_CheckExact(path.get()) || PyTuple_GET_SIZE(path.get()) <= 0) {
+    return false;
+  }
+  for (Py_ssize_t i = 0; i < PyTuple_GET_SIZE(path.get()); i++) {
+    if (!PyUnicode_CheckExact(PyTuple_GET_ITEM(path.get(), i))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool isValidValueEntryGuard(BorrowedRef<> guard) {
+  if (guard == nullptr || guard == Py_None) {
+    return true;
+  }
+  if (!PyTuple_CheckExact(guard.get()) || PyTuple_GET_SIZE(guard.get()) != 5) {
+    return false;
+  }
+  BorrowedRef<> mode = PyTuple_GET_ITEM(guard.get(), 0);
+  BorrowedRef<> decoder = PyTuple_GET_ITEM(guard.get(), 1);
+  BorrowedRef<> key_path = PyTuple_GET_ITEM(guard.get(), 2);
+  BorrowedRef<> observer = PyTuple_GET_ITEM(guard.get(), 3);
+  BorrowedRef<> expected_path = PyTuple_GET_ITEM(guard.get(), 4);
+  return PyUnicode_CheckExact(mode.get()) &&
+      PyUnicode_CompareWithASCIIString(mode.get(), "json_result_call_value") ==
+      0 &&
+      PyCallable_Check(decoder.get()) && isExactUnicodePath(key_path) &&
+      PyCallable_Check(observer.get()) && isExactUnicodePath(expected_path);
+}
+
+// Validate the compiler-provided dependency descriptor and allocate all
+// mutable cache storage before HIR runs.  Malformed or unsupported metadata
+// fails closed by returning nullptr, leaving the ordinary function HIR intact.
+Ref<> makeUdfInvariantState(BorrowedRef<PyFunctionObject> function) {
+  if (function == nullptr || function->func_dict == nullptr) {
+    return nullptr;
+  }
+  BorrowedRef<> descriptor =
+      PyDict_GetItemString(function->func_dict, kUdfInvariantCacheAttr);
+  if (!PyDict_CheckExact(descriptor.get())) {
+    return nullptr;
+  }
+  BorrowedRef<> version = PyDict_GetItemString(descriptor.get(), "version");
+  BorrowedRef<> argument_modes =
+      PyDict_GetItemString(descriptor.get(), "argument_modes");
+  BorrowedRef<> watchers = PyDict_GetItemString(descriptor.get(), "watchers");
+  if (!PyLong_CheckExact(version.get()) || PyLong_AsLong(version.get()) != 1 ||
+      !PyTuple_CheckExact(argument_modes.get()) ||
+      PyTuple_GET_SIZE(argument_modes.get()) != 1 ||
+      !PyUnicode_CheckExact(PyTuple_GET_ITEM(argument_modes.get(), 0)) ||
+      PyUnicode_CompareWithASCIIString(
+          PyTuple_GET_ITEM(argument_modes.get(), 0), "identity") != 0 ||
+      !PyTuple_CheckExact(watchers.get()) ||
+      PyTuple_GET_SIZE(watchers.get()) <= 0 ||
+      PyTuple_GET_SIZE(watchers.get()) > kMaxUdfInvariantWatchers) {
+    PyErr_Clear();
+    return nullptr;
+  }
+  for (Py_ssize_t i = 0; i < PyTuple_GET_SIZE(watchers.get()); i++) {
+    BorrowedRef<> watcher = PyTuple_GET_ITEM(watchers.get(), i);
+    if (!isValidInvariantWatcher(watcher)) {
+      PyErr_Clear();
+      return nullptr;
+    }
+  }
+
+  auto missing = Ref<>::steal(PyCapsule_New(
+      reinterpret_cast<void*>(1), "cinderx.udf_invariant_missing", nullptr));
+  auto snapshots = Ref<>::steal(PyList_New(PyTuple_GET_SIZE(watchers.get())));
+  auto state = Ref<>::steal(PyList_New(kUdfInvariantStateSize));
+  if (missing == nullptr || snapshots == nullptr || state == nullptr) {
+    PyErr_Clear();
+    return nullptr;
+  }
+  for (Py_ssize_t i = 0; i < PyList_GET_SIZE(snapshots); i++) {
+    Py_INCREF(missing.get());
+    PyList_SET_ITEM(snapshots, i, missing.get());
+  }
+  auto set_state = [&](Py_ssize_t index, BorrowedRef<> value) {
+    Py_INCREF(value.get());
+    PyList_SET_ITEM(state, index, value.get());
+  };
+  set_state(kUdfInvariantWatchers, watchers);
+  set_state(kUdfInvariantSnapshots, snapshots);
+  set_state(kUdfInvariantArgument0, Py_None);
+  set_state(kUdfInvariantResult, Py_None);
+  set_state(kUdfInvariantValid, Py_False);
+  set_state(kUdfInvariantMissing, missing);
+  return state;
+}
